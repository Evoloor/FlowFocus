@page "/settings"
@using FlowFocus.Core.Models
@using FlowFocus.Core
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@inject ISnackbar Snackbar

<PageTitle>Настройки</PageTitle>

<MudPaper Class="pa-4" Elevation="1">
    <MudText Typo="Typo.h5">Настройки приложения</MudText>
    <MudDivider Class="my-3" />

    <MudForm>
        <MudTextField T="int"
                      Label="Время начала дня (часы, 0–23)"
                      @bind-Value="StartHour"
                      Min="0" Max="23"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.AccessTime"
                      Immediate="true" />
        <MudNumericField T="double" Label="Макс. часов в день" @bind-Value="_settings.DailyHoursLimit" />
        <MudNumericField T="int" Label="Макс. сложности в день" @bind-Value="_settings.DailyComplexityLimit" />
        <MudSwitch T="bool" Label="Пересчёт при добавлении задачи" @bind-Checked="_settings.AutoRecalculateOnAdd" />

        <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-3" OnClick="SaveAsync">
            <MudIcon Icon="@Icons.Material.Filled.Save" /> Сохранить
        </MudButton>
    </MudForm>
</MudPaper>

@code {
    UserAppSettings _settings = new();

    protected override async Task OnInitializedAsync()
    {
        await AppStateManager.Shared.LoadAsync();
        _settings = AppStateManager.Shared.State.Settings;
    }
    // Костыль: отдельное числовое поле вместо TimeSpan
    int StartHour
    {
        get => (int)_settings.DayStartTime.TotalHours;
        set => _settings.DayStartTime = TimeSpan.FromHours(value);
    }

    async Task SaveAsync()
    {
        AppStateManager.Shared.State.Settings = _settings;
        await AppStateManager.Shared.SaveAsync();
        Snackbar.Add("Настройки сохранены.", Severity.Success);
    }
}