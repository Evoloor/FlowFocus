@page "/unconfigured"
@using FlowFocus.Core.Models
@using FlowFocus.Core
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor

@inject ISnackbar Snackbar

<PageTitle>Ненастроенные задачи</PageTitle>

<MudPaper Class="pa-4" Elevation="1">
    <MudText Typo="Typo.h5">Ненастроенные задачи</MudText>
    <MudDivider Class="my-2" />

    @if (UnconfiguredTasks.Count == 0)
    {
        <MudAlert Severity="Severity.Info">Все задачи настроены 👌</MudAlert>
    }
    else
    {
        <MudList T="string">
            @foreach (var task in UnconfiguredTasks)
            {
                <MudListItem T="string">
                        <MudText Typo="Typo.body1">@task.Title</MudText>
                        <MudText Typo="Typo.caption">Инт: @task.Interest | Слож: @task.Complexity | ⏱ @task.Hours ч</MudText>

                        <MudButton Color="Color.Success" Variant="Variant.Outlined" OnClick="() => ConfirmTaskAsync(task)">
                            Подтвердить
                        </MudButton>
                </MudListItem>
            }
        </MudList>
    }
</MudPaper>

@code {
    protected override async Task OnInitializedAsync() => await AppStateManager.Shared.LoadAsync();

    List<TaskItem> UnconfiguredTasks =>
        AppStateManager.Shared.State.Tasks
            .FindAll(t => t.Status == TodoTaskStatus.Unconfigured);

    async Task ConfirmTaskAsync(TaskItem task)
    {
        task.Status = TodoTaskStatus.Planned;
        task.AssignedDate = DateTime.Today.AddDays(1);
        await AppStateManager.Shared.UpdateTaskAsync(task);
        Snackbar.Add($"Задача '{task.Title}' готова. Назначена дата: {task.AssignedDate:dd.MM}", Severity.Success);
    }
}