@page "/tomorrow"
@using FlowFocus.Core
@using FlowFocus.Core.Models
@using FlowFocus.Core.Utility
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor

<PageTitle>Завтра</PageTitle>

<MudText Typo="Typo.h5" Class="mb-2">Задачи на завтра</MudText>

@if (_tomorrowTasks is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_tomorrowTasks.Count == 0)
{
    <MudText>Нет задач на завтра 🎉</MudText>
}
else
{
    @foreach (var task in _tomorrowTasks)
    {
        <MudCard Class="mb-2">
            <MudCardContent>
                <MudText Typo="Typo.subtitle1">@task.Title</MudText>
                <MudText Typo="Typo.body2">@task.Description</MudText>
            </MudCardContent>
        </MudCard>
    }
}

@code {
    private List<TaskItem> _tomorrowTasks = new();

    protected override async Task OnInitializedAsync()
    {
        var manager = AppStateManager.Shared;
        var startOfTomorrow = DateTime.Now.StartOfTomorrow();
        var endOfTomorrow = startOfTomorrow.AddDays(1);

        _tomorrowTasks = manager.State.Tasks
            .Where(t =>
            {
                if (t.AssignedDate.Value.TimeOfDay != TimeSpan.Zero)
                    return t.AssignedDate >= startOfTomorrow &&
                           t.AssignedDate < endOfTomorrow;

                return t.AssignedDate.Value.Date == startOfTomorrow.Date;
            })
            .Where(t => t.Status == TodoTaskStatus.Planned)
            .ToList();
    }
}
