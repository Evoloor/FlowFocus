@page "/unconfigured"
@using FlowFocus.Core.Models
@using FlowFocus.Data
@using FlowFocus.WebApp.Components

@inject ITaskRepository TaskRepo

<PageTitle>Ненастроенные задачи</PageTitle>
<TasksView Tasks="@UnconfiguredTasks" 
          Title="Ненастроенные задачи"
          ShowFilters="false"
          ShowCounter="false"
          ShowFavoriteAction="false"
          ShowEditAction="false"
          ShowDeleteAction="false"
          ShowConfirmAction="true"
          DefaultStatusFilter="TodoTaskStatus.Unconfigured"
          EmptyMessage="Все задачи настроены 👌"/>

@code {
    private List<TaskItem> UnconfiguredTasks => TaskRepo.GetUnconfigured();
}