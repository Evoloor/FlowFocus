@page "/"
@using FlowFocus.WebApp.Components
@using FlowFocus.WebApp.Dialogs
@inject ITaskRepository TaskRepo
@inject IPlannerService PlannerService
@inject IDialogService DialogServiceObj
@inject ISnackbar Snackbar
@inject ISettingsRepository SettingsRepo
@inject INotificationService NotificationService
@inject IRecurringTaskService RecurringTaskService

<PageTitle>FlowFocus - Сегодня</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-4">
    <MudGrid>
        <!-- Уведомления -->
        @if (_notifications.Any())
        {
            <MudItem xs="12" Class="mb-4">
                @foreach (var notification in _notifications)
                {
                    <MudAlert Severity="Severity.Warning" Class="mb-2" Variant="Variant.Filled">
                        <MudText Typo="Typo.body2">@notification</MudText>
                    </MudAlert>
                }
            </MudItem>
        }

        <MudItem xs="12" Class="mb-4">
            <div class="d-flex justify-space-between align-center">
                <div>
                    <MudText Typo="Typo.h4" Class="mb-1">Задачи на сегодня</MudText>
                    <MudText Color="Color.Secondary">@DateTime.Now.ToString("dd MMMM yyyy")</MudText>
                </div>
                <div class="d-flex gap-2">
                    <MudButton Variant="Variant.Outlined" 
                              Color="Color.Primary"
                              StartIcon="@Icons.Material.Filled.Refresh"
                              OnClick="@RecalculatePriorities"
                              Size="Size.Small">
                        Пересчитать
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.PlayArrow"
                               OnClick="@ProcessDayStart"
                               Size="Size.Small">
                        Начать день
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                                           Color="Color.Info"
                                           StartIcon="@Icons.Material.Filled.Analytics"
                                           OnClick="@ShowStatistics"
                                           Size="Size.Small">
                        Статистика
                    </MudButton>
                </div>
            </div>
        </MudItem>

        <!-- Основной контент -->
        <MudItem xs="12" md="8">
            @if (_isLoading)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate/>
            }
            else if (!_todayTasks.Any())
            {
                <MudPaper Class="py-12 text-center">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" 
                            Color="Color.Success" 
                            Size="Size.Large" 
                            Class="mb-3" />
                    <MudText Typo="Typo.h6" Color="Color.Secondary">Все задачи выполнены!</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                        Добавьте новые задачи или проверьте планировщик
                    </MudText>
                    <MudButton Variant="Variant.Outlined" 
                              Color="Color.Primary"
                              Class="mt-3"
                              OnClick="@PlanForToday">
                        Запланировать на сегодня
                    </MudButton>
                </MudPaper>
            }
            else
            {
                <MudGrid>
                    @foreach (var task in _todayTasks)
                    {
                        <MudItem xs="12" Class="mb-3">
                            <TaskCard CurrentTask="task" 
                                     OnTaskUpdated="HandleTaskUpdated"
                                     OnTaskDeleted="HandleTaskDeleted" />
                        </MudItem>
                    }
                </MudGrid>
            }
        </MudItem>

        <!-- Боковая панель статистики -->
    </MudGrid>
</MudContainer>

@code {
    private List<TaskItem> _todayTasks = [];
    private bool _isLoading = true;
    private UserSettings _settings = new();
    private List<string> _notifications = [];


    protected override void OnInitialized()
    {
        _settings = SettingsRepo.GetUserSettings();
        LoadNotifications();
        LoadTodayTasks();
    }

    private void LoadTodayTasks()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            var today = DateTime.Today;
            _todayTasks = TaskRepo.GetByDate(today).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка загрузки задач: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void LoadNotifications()
    {
        try
        {
            _notifications = NotificationService.GetNotifications();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки уведомлений: {ex.Message}");
        }
    }

    private void HandleTaskUpdated(TaskItem task)
    {
        LoadTodayTasks();
        LoadNotifications();
    }

    private void HandleTaskDeleted(TaskItem task)
    {
        LoadTodayTasks();
        LoadNotifications();
    }

    private void RecalculatePriorities()
    {
        try
        {
            PlannerService.RecalculatePriorities();
            Snackbar.Add("Приоритеты пересчитаны", Severity.Success);
            LoadTodayTasks();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка пересчета: {ex.Message}", Severity.Error);
        }
    }

    private void ProcessDayStart()
    {
        try
        {
            TaskRepo.ProcessDayStart();
             RecurringTaskService.ProcessRecurringTasks();
            Snackbar.Add("День начат! Обработаны повторяющиеся задачи", Severity.Success);
            LoadTodayTasks();
            LoadNotifications();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка начала дня: {ex.Message}", Severity.Error);
        }
    }

    private void PlanForToday()
    {
        try
        {
            var plannedTasks =  PlannerService.PlanTasksForDay(DateTime.Today);
            foreach (var task in plannedTasks)
            {
                task.PlannedDate = DateTime.Today;
                TaskRepo.Update(task);
            }
            Snackbar.Add($"Запланировано {plannedTasks.Count()} задач на сегодня", Severity.Success);
            LoadTodayTasks();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка планирования: {ex.Message}", Severity.Error);
        }
    }
    private async Task ShowStatistics()
    {
        var parameters = new DialogParameters
        {
            [nameof(StatisticsDialog.TodayTasks)] = _todayTasks,
            [nameof(StatisticsDialog.Settings)] = _settings
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogServiceObj.ShowAsync<StatisticsDialog>("Статистика дня", parameters, options);
    }
}