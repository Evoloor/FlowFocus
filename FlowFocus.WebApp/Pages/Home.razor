<!-- === FILE: FlowFocus.WebApp/Pages/Home.razor === -->
@page "/"
@using FlowFocus.WebApp.Components
@using FlowFocus.WebApp.Dialogs
@inject ITaskRepository TaskRepo
@inject IPlannerService PlannerService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ISettingsRepository SettingsRepo
@inject INotificationService NotificationService
@inject IRecurringTaskService RecurringTaskService

<PageTitle>FlowFocus - Сегодня</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-4">
    <MudGrid>
        <!-- Уведомления -->
        @if (_notifications.Any())
        {
            <MudItem xs="12" Class="mb-4">
                @foreach (var notification in _notifications)
                {
                    <MudAlert Severity="Severity.Warning" Class="mb-2" Variant="Variant.Filled">
                        <MudText Typo="Typo.body2">@notification</MudText>
                    </MudAlert>
                }
            </MudItem>
        }

        <MudItem xs="12" Class="mb-4">
            <div class="d-flex justify-space-between align-center">
                <div>
                    <MudText Typo="Typo.h4" Class="mb-1">Задачи на сегодня</MudText>
                    <MudText Color="Color.Secondary">@DateTime.Now.ToString("dd MMMM yyyy")</MudText>
                </div>
                <div class="d-flex gap-2">
                    <MudButton Variant="Variant.Outlined" 
                              Color="Color.Primary"
                              StartIcon="Icons.Material.Filled.Refresh"
                              OnClick="RecalculatePriorities"
                              Size="Size.Small">
                        Пересчитать
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                              Color="Color.Secondary"
                              StartIcon="Icons.Material.Filled.AutoFixHigh"
                              OnClick="BalanceTasks"
                              Size="Size.Small">
                        Балансировать
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                              Color="Color.Info"
                              StartIcon="Icons.Material.Filled.PlayArrow"
                              OnClick="ProcessDayStart"
                              Size="Size.Small">
                        Начать день
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                              StartIcon="Icons.Material.Filled.Settings"
                              OnClick="ShowSettings"
                              Size="Size.Small">
                        Настройки
                    </MudButton>
                </div>
            </div>
        </MudItem>

        <!-- Быстрое добавление -->
        <MudItem xs="12" Class="mb-4">
             <QuickAddTask OnTaskAdded="@EventCallback.Factory.Create(this, LoadTodayTasks)"/>
        </MudItem>

        <!-- Основной контент -->
        <MudItem xs="12" md="8">
            @if (_isLoading)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
            }
            else if (!_todayTasks.Any())
            {
                <MudPaper Class="py-12 text-center">
                    <MudIcon Icon="Icons.Material.Filled.CheckCircle" 
                            Color="Color.Success" 
                            Size="Size.Large" 
                            Class="mb-3" />
                    <MudText Typo="Typo.h6" Color="Color.Secondary">Все задачи выполнены!</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                        Добавьте новые задачи или проверьте планировщик
                    </MudText>
                    <MudButton Variant="Variant.Outlined" 
                              Color="Color.Primary"
                              Class="mt-3"
                              OnClick="PlanForToday">
                        Запланировать на сегодня
                    </MudButton>
                </MudPaper>
            }
            else
            {
                <MudGrid>
                    @foreach (var task in _todayTasks)
                    {
                        <MudItem xs="12" Class="mb-3">
                            <TaskCard Task="task" 
                                     OnTaskUpdated="HandleTaskUpdated"
                                     OnTaskDeleted="HandleTaskDeleted" />
                        </MudItem>
                    }
                </MudGrid>
            }
        </MudItem>

        <!-- Боковая панель статистики -->
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4 sticky-sidebar">
                <MudText Typo="Typo.h6" Class="mb-3">Статистика дня</MudText>
                
                <div class="mb-4">
                    <MudText Typo="Typo.body2">Всего задач: <MudText Color="Color.Primary" Typo="Typo.body1">@_todayTasks.Count</MudText></MudText>
                    <MudText Typo="Typo.body2">Завершено: <MudText Color="Color.Success" Typo="Typo.body1">@CompletedCount</MudText></MudText>
                    <MudText Typo="Typo.body2">Активных: <MudText Color="Color.Warning" Typo="Typo.body1">@ActiveCount</MudText></MudText>
                    <MudText Typo="Typo.body2">Заблокировано: <MudText Color="Color.Error" Typo="Typo.body1">@BlockedCount</MudText></MudText>
                </div>

                <MudProgressLinear Color="Color.Success" 
                                  Value="@CompletionPercent" 
                                  Class="mb-2" />
                <MudText Typo="Typo.caption">Прогресс: @CompletionPercent.ToString("0")%</MudText>

                <div class="mt-4">
                    <MudText Typo="Typo.body2">Общее время: <MudText Color="Color.Info" Typo="Typo.body1">@TotalHours.ToString("0.0") ч</MudText></MudText>
                    <MudText Typo="Typo.body2">Общая сложность: <MudText Color="Color.Info" Typo="Typo.body1">@TotalComplexity</MudText></MudText>
                    <MudText Typo="Typo.body2">Лимит времени: <MudText Color="Color.Secondary" Typo="Typo.body1">@_settings.DailyTimeLimit ч</MudText></MudText>
                    <MudText Typo="Typo.body2">Лимит сложности: <MudText Color="Color.Secondary" Typo="Typo.body1">@_settings.DailyComplexityLimit</MudText></MudText>
                </div>

                @if (HasOverload)
                {
                    <MudAlert Severity="Severity.Warning" Class="mt-3" Icon="Icons.Material.Filled.Warning">
                        <MudText Typo="Typo.body2">Превышены дневные лимиты!</MudText>
                    </MudAlert>
                }

                <!-- Баланс задач -->
                <div class="mt-4">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Баланс задач</MudText>
                    <MudText Typo="Typo.body2">Интересные: <MudText Color="Color.Success" Typo="Typo.body1">@InterestingCount</MudText></MudText>
                    <MudText Typo="Typo.body2">Сложные: <MudText Color="Color.Warning" Typo="Typo.body1">@ComplexCount</MudText></MudText>
                    
                    @if (IsUnbalanced)
                    {
                        <MudAlert Severity="Severity.Info" Class="mt-2" Size="Size.Small">
                            <MudText Typo="Typo.caption">Рекомендуется баланс интересных и сложных задач</MudText>
                        </MudAlert>
                    }
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private List<TaskItem> _todayTasks = new List<TaskItem>();
    private bool _isLoading = true;
    private UserSettings _settings = new UserSettings();
    private List<string> _notifications = new List<string>();

    private int CompletedCount => _todayTasks.Count(t => t.Status == TaskStatus.Completed);
    private int ActiveCount => _todayTasks.Count(t => t.Status == TaskStatus.Active);
    private int BlockedCount => _todayTasks.Count(t => !t.CanBeStarted());
    private int InterestingCount => _todayTasks.Count(t => t.Interest >= 7);
    private int ComplexCount => _todayTasks.Count(t => t.Complexity >= 70);
    private double CompletionPercent => _todayTasks.Any() ? (CompletedCount * 100.0) / _todayTasks.Count : 0;
    private double TotalHours => _todayTasks.Where(t => t.Status != TaskStatus.Completed).Sum(t => t.EstimatedHours);
    private int TotalComplexity => _todayTasks.Where(t => t.Status != TaskStatus.Completed).Sum(t => t.Complexity);
    private bool HasOverload => TotalHours > _settings.DailyTimeLimit || TotalComplexity > _settings.DailyComplexityLimit;
    private bool IsUnbalanced => InterestingCount == 0 || ComplexCount > _todayTasks.Count * 0.4;

    protected override async Task OnInitializedAsync()
    {
        _settings = await SettingsRepo.GetUserSettingsAsync();
        await LoadNotifications();
        await LoadTodayTasks();
    }

    private async Task LoadTodayTasks()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            var today = DateTime.Today;
            _todayTasks = (await TaskRepo.GetByDateAsync(today)).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка загрузки задач: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadNotifications()
    {
        try
        {
            _notifications = await NotificationService.GetNotificationsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки уведомлений: {ex.Message}");
        }
    }

    private async Task HandleTaskUpdated(TaskItem task)
    {
        await LoadTodayTasks();
        await LoadNotifications();
    }

    private async Task HandleTaskDeleted(TaskItem task)
    {
        await LoadTodayTasks();
        await LoadNotifications();
    }

    private async Task RecalculatePriorities()
    {
        try
        {
            await PlannerService.RecalculatePrioritiesAsync();
            Snackbar.Add("Приоритеты пересчитаны", Severity.Success);
            await LoadTodayTasks();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка пересчета: {ex.Message}", Severity.Error);
        }
    }

    private async Task BalanceTasks() // Новый метод для балансировки
    {
        try
        {
            await PlannerService.BalanceTaskLoadAsync(DateTime.Today);
            Snackbar.Add("Задачи сбалансированы", Severity.Success);
            await LoadTodayTasks();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка балансировки: {ex.Message}", Severity.Error);
        }
    }

    private async Task ProcessDayStart()
    {
        try
        {
            await TaskRepo.ProcessDayStartAsync();
            await RecurringTaskService.ProcessRecurringTasksAsync();
            Snackbar.Add("День начат! Обработаны повторяющиеся задачи", Severity.Success);
            await LoadTodayTasks();
            await LoadNotifications();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка начала дня: {ex.Message}", Severity.Error);
        }
    }

    private async Task PlanForToday()
    {
        try
        {
            var plannedTasks = await PlannerService.PlanTasksForDayAsync(DateTime.Today);
            foreach (var task in plannedTasks)
            {
                task.PlannedDate = DateTime.Today;
                await TaskRepo.UpdateAsync(task);
            }
            Snackbar.Add($"Запланировано {plannedTasks.Count()} задач на сегодня", Severity.Success);
            await LoadTodayTasks();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка планирования: {ex.Message}", Severity.Error);
        }
    }

    private async Task ShowSettings()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<SettingsDialog>("Настройки", options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            _settings = await SettingsRepo.GetUserSettingsAsync();
            await LoadTodayTasks();
            await LoadNotifications();
        }
    }
}