@page "/not-configured"
@using FlowFocus.WebApp.Dialogs
@inject ITaskRepository TaskRepo
@inject IDialogService DialogServiceObj
@inject ISnackbar Snackbar

<PageTitle>FlowFocus - Ненастроенные</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-4">
    <MudGrid>
        <MudItem xs="12" Class="mb-4">
            <MudText Typo="Typo.h4" Class="mb-1">Ненастроенные задачи</MudText>
            <MudText Color="Color.Secondary">Задачи, требующие подтверждения и настройки</MudText>
        </MudItem>

        <MudItem xs="12">
            @if (_isLoading)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate/>
            }
            else if (!_notConfiguredTasks.Any())
            {
                <MudPaper Class="py-12 text-center">
                    <MudIcon Icon="@Icons.Material.Filled.DoneAll"
                             Color="Color.Success"
                             Size="Size.Large"
                             Class="mb-3"/>
                    <MudText Typo="Typo.h6" Color="Color.Secondary">Все задачи настроены!</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                        Новые ненастроенные задачи появятся здесь после быстрого добавления
                    </MudText>
                </MudPaper>
            }
            else
            {
                <MudGrid>
                    @foreach (var task in _notConfiguredTasks)
                    {
                        <MudItem xs="12" md="6" lg="4">
                            <MudCard Class="h-100">
                                <MudCardContent>
                                    <MudText Typo="Typo.h6" Class="mb-2">@task.Title</MudText>
                                    @if (!string.IsNullOrEmpty(task.Description))
                                    {
                                        <MudText Typo="Typo.body2" Class="mb-3">@task.Description</MudText>
                                    }
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        Создано: @task.CreatedDate.ToString("dd.MM.yyyy HH:mm")
                                    </MudText>
                                </MudCardContent>
                                <MudCardActions>
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               OnClick="@(() => ConfigureTask(task))">
                                        Настроить
                                    </MudButton>
                                </MudCardActions>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            }
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private List<TaskItem> _notConfiguredTasks = [];
    private bool _isLoading = true;

    protected override void OnInitialized()
    {
        LoadNotConfiguredTasks();
    }

    private void LoadNotConfiguredTasks()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            _notConfiguredTasks = TaskRepo.GetNotConfigured().ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка загрузки задач: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ConfigureTask(TaskItem task)
    {
        var parameters = new DialogParameters
        {
            [nameof(TaskEditDialog.ExistingTask)] = task
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogServiceObj.ShowAsync<TaskEditDialog>("Настройка задачи", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            LoadNotConfiguredTasks();
        }
    }

}