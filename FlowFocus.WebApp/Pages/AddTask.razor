@page "/add"
@using FlowFocus.Core.Models
@using FlowFocus.Data
@inject ITaskRepository TaskRepo
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Добавить задачу</PageTitle>

<MudPaper Class="pa-4" Elevation="1">
    <MudText Typo="Typo.h5">Новая задача</MudText>
    <MudDivider Class="my-3" />

    <MudForm>
        <MudTextField @bind-Value="_task.Title" Label="Название" Required="true" />
        <MudTextField @bind-Value="_task.Description" Label="Описание" Lines="3" />
        
        <MudGrid>
            <MudItem xs="12" sm="4">
                <MudNumericField Label="Интересность (1–10)" @bind-Value="_task.Interest" Min="1" Max="10" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField Label="Сложность (1–100)" @bind-Value="_task.Complexity" Min="1" Max="100" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField Label="Часы" @bind-Value="_task.Hours" Min="0" Max="1000" />
            </MudItem>
        </MudGrid>

        <MudDatePicker Label="Дедлайн" @bind-Date="_task.Deadline" />

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" OnClick="Save" StartIcon="@Icons.Material.Filled.Check">
            Сохранить
        </MudButton>
    </MudForm>
</MudPaper>

@code {
    private TaskItem _task = new();

    void Save()
    {
        TaskRepo.Add(_task);
        TaskRepo.SaveChanges();
        Snackbar.Add($"Задача '{_task.Title}' добавлена.", Severity.Success);
        Nav.NavigateTo("/unconfigured");
    }
}