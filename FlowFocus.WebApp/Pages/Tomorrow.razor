@page "/tomorrow"
@using FlowFocus.Core.Models
@using FlowFocus.Data
@using FlowFocus.WebApp.Components
@inject IRepository<UserAppSettings> SettingsRepo

@inject ITaskRepository TaskRepo

<PageTitle>Завтра</PageTitle>

<MudPaper Class="pa-4" Elevation="1">
    <MudText Typo="Typo.h5" Class="mb-2">Задачи на завтра</MudText>
    <MudDivider Class="my-2" />

    @if (TomorrowTasks.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            Нет задач на завтра 🎉
        </MudAlert>
    }
    else
    {
        <MudGrid>
            @foreach (var task in TomorrowTasks)
            {
                <MudItem xs="12" sm="6" md="4">
                    <TaskCard Task="@task" 
                              ShowActions="false" />
                </MudItem>
            }
        </MudGrid>
    }
</MudPaper>

@code {
    private UserAppSettings _settings = new();

    protected override void OnInitialized()
    {
        _settings = SettingsRepo.GetAll().First();
    }

    private List<TaskItem> TomorrowTasks => TaskRepo.GetByDate(
        DateTime.Now.StartOfToday(_settings.DayStartTime).AddDays(1), 
        _settings.DayStartTime
    );
}