@page "/tomorrow"
@using FlowFocus.WebApp.Components
@inject ITaskRepository TaskRepo
@inject IPlannerService PlannerService
@inject ISnackbar Snackbar

<PageTitle>FlowFocus - Завтра</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-4">
    <MudGrid>
        <MudItem xs="12">
            @if (_isLoading)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate />
            }
            else if (!_tomorrowTasks.Any())
            {
                <MudPaper Class="py-12 text-center">
                    <MudIcon Icon="@Icons.Material.Filled.Schedule" 
                            Color="Color.Secondary" 
                            Size="Size.Large" 
                            Class="mb-3" />
                    <MudText Typo="Typo.h6" Color="Color.Secondary">Задачи не запланированы</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                        Нажмите "Запланировать" для автоматического распределения задач
                    </MudText>
                    <MudButton Variant="Variant.Outlined" 
                              Color="Color.Primary"
                              Class="mt-3"
                              OnClick="@PlanTomorrowTasks">
                        Запланировать задачи
                    </MudButton>
                </MudPaper>
            }
            else
            {
                <TaskList Title="Задачи на завтра" 
                         FilterDate="@DateTime.Now.AddDays(1)"
                         OnTasksUpdated="LoadTomorrowTasks" />
            }
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private List<TaskItem> _tomorrowTasks = [];
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadTomorrowTasks();
    }

    private async Task LoadTomorrowTasks()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            var tomorrow = DateTime.Today.AddDays(1);
            _tomorrowTasks = (await TaskRepo.GetByDateAsync(tomorrow)).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка загрузки задач: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task PlanTomorrowTasks()
    {
        try
        {
            var tomorrow = DateTime.Today.AddDays(1);
            var plannedTasks = (await PlannerService.PlanTasksForDayAsync(tomorrow)).ToArray();
            
            foreach (var task in plannedTasks)
            {
                task.PlannedDate = tomorrow;
                await TaskRepo.UpdateAsync(task);
            }

            Snackbar.Add($"Запланировано {plannedTasks.Length} задач на завтра", Severity.Success);
            await LoadTomorrowTasks();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка планирования: {ex.Message}", Severity.Error);
        }
    }
}