@page "/tomorrow"
@using FlowFocus.Core.Models
@using FlowFocus.Data
@using FlowFocus.WebApp.Components
@inject IRepository<UserAppSettings> SettingsRepo

@inject ITaskRepository TaskRepo

<PageTitle>Завтра</PageTitle>
<TasksView Tasks="@TomorrowTasks" 
          Title="Задачи на завтра"
          ShowFilters="false"
          ShowViewToggle="false"
          ShowCounter="false"
          ShowPagination="false"
          EmptyMessage="Нет задач на завтра 🎉" />

@code {
    private UserAppSettings _settings = new();

    protected override void OnInitialized()
    {
        _settings = SettingsRepo.GetAll().First();
    }

    private List<TaskItem> TomorrowTasks => TaskRepo.GetByDate(
        DateTime.Now.StartOfToday(_settings.DayStartTime).AddDays(1), 
        _settings.DayStartTime
    );
}