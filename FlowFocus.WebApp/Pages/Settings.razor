@page "/settings"
@using FlowFocus.WebApp.Components
@using FlowFocus.WebApp.Dialogs
@inject IDialogService DialogService

<PageTitle>FlowFocus - Настройки</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-4">
    <MudGrid>
        <MudItem xs="12" Class="mb-4">
            <MudText Typo="Typo.h4">Настройки приложения</MudText>
            <MudText Color="Color.Secondary">Управление параметрами системы</MudText>
        </MudItem>

        <MudItem xs="12" md="3">
            <MudPaper Class="pa-3">
                <MudNavMenu>
                    <MudNavLink Text="Основные настройки" 
                                Icon="Icons.Material.Filled.Settings"
                                Active="@(_activeTab == 0)"
                                OnClick="() => SwitchTab(0)" />
                    <MudNavLink Text="Автоматизация" 
                                Icon="Icons.Material.Filled.AutoFixHigh"
                                Active="@(_activeTab == 1)"
                                OnClick="() => SwitchTab(1)" />
                    <MudNavLink Text="Расширенные настройки" 
                                Icon="Icons.Material.Filled.Tune"
                                Active="@(_activeTab == 2)"
                                OnClick="() => SwitchTab(2)" />
                </MudNavMenu>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="9">
            <MudPaper Class="pa-4">
                @switch (_activeTab)
                {
                    case 0:
                        <BasicSettings />
                        break;
                    case 1:
                        <AutomationSettings />
                        break;
                    case 2:
                        <AdvancedSettings />
                        break;
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private int _activeTab = 0;

    private void SwitchTab(int tabIndex)
    {
        _activeTab = tabIndex;
        StateHasChanged();
    }
}