@page "/settings"
@using FlowFocus.WebApp.Dialogs
@inject IDialogService DialogService

<PageTitle>FlowFocus - Настройки</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-4">
    <MudGrid>
        <MudItem xs="12" Class="mb-4">
            <MudText Typo="Typo.h4">Настройки приложения</MudText>
            <MudText Color="Color.Secondary">Управление параметрами системы</MudText>
        </MudItem>

        <MudItem xs="12">
            <MudPaper Class="pa-4">
                <MudList T="string">
                    <MudListItem T="string" Text="Основные настройки" 
                                 Icon="Icons.Material.Filled.Settings"
                                 OnClick="@ShowSettingsDialog" />
                    <MudDivider />
                    <MudListItem T="string" Text="Управление данными" 
                                 Icon="Icons.Material.Filled.Storage"
                                 OnClick="@ShowDataManagement" />
                    <MudDivider />
                    <MudListItem T="string" Text="О программе" 
                                 Icon="Icons.Material.Filled.Info"
                                 OnClick="@ShowAbout" />
                </MudList>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private async Task ShowSettingsDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<SettingsDialog>("Настройки", options);
        await dialog.Result;
    }

    private void ShowDataManagement()
    {
        // Implementation for data management
        // TODO: Add data export/import functionality
    }

    private void ShowAbout()
    {
        // Implementation for about dialog
        // TODO: Add about information
    }
}