@using FlowFocus.WebApp.Dialogs
@inject ITaskRepository TaskRepo
@inject ISnackbar Snackbar
@inject IDialogService DialogServiceObj

<MudPaper Class="pa-4 quick-add-task" Elevation="1">
    <div class="d-flex align-center gap-2">
        <MudTextField @bind-Value="_newTaskTitle" 
                      Label="Быстрое добавление задачи" 
                      Variant="Variant.Outlined"
                      Placeholder="Введите название задачи..."
                      OnKeyDown="@HandleKeyDown"
                      Class="flex-grow-1" />
        
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="@AddQuickTask" Disabled="@string.IsNullOrWhiteSpace(_newTaskTitle)"
                   StartIcon="@Icons.Material.Filled.Add">
            Добавить
        </MudButton>
        
        <MudIconButton Icon="@Icons.Material.Filled.Tune" 
                       OnClick="@ShowFullCreateDialogAsync" />
    </div>
</MudPaper>

@code {
    [Parameter] public EventCallback? OnTaskAdded { get; set; }
    private string _newTaskTitle = string.Empty;

    private async Task AddQuickTask()
    {
        if (string.IsNullOrWhiteSpace(_newTaskTitle))
            return;

        var newTask = new TaskItem
        {
            Title = _newTaskTitle.Trim(),
            Status = TaskStatus.NotConfigured,
            UserPriority = 5,
            Interest = 5,
            Complexity = 5,
            EstimatedHours = 1.0
        };

        TaskRepo.Add(newTask);
        Snackbar.Add("Задача добавлена в ненастроенные", Severity.Success);
        
        _newTaskTitle = string.Empty;
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AddQuickTask();
        }
    }

    private async Task ShowFullCreateDialogAsync()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        _ = await DialogServiceObj.ShowAsync<TaskEditDialog>("Новая задача", options);
    }
}