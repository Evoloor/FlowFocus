@using System.Drawing
@using FlowFocus.WebApp.Dialogs
@using Color = MudBlazor.Color
@using Size = MudBlazor.Size
@inject IDialogService DialogServiceObj
@inject ITaskRepository TaskRepo
@inject ISnackbar Snackbar

@if (IsGridView)
{
    <!-- Карточка для сетки -->
    <MudCard Class="@($"h-100 task-card {GetTaskCardClass()}")" Elevation="2">
        <div class="d-flex flex-column h-100">
            <!-- Вертикальный индикатор приоритета -->
            <div class="priority-indicator-horizontal" style="@($"background-color: {ColorTranslator.ToHtml(PriorityServiceObj.GetColor(CurrentTask.UserPriority)) }")"></div>
            
            <div class="flex-grow-1 pa-3">
                <!-- Заголовок и чекбокс -->
                <div class="d-flex align-center mb-2">
                    <MudCheckBox T="bool" @bind-Checked="_isCompleted"
                                 ValueChanged="HandleCompletionChange"
                                 Color="Color.Success"/>
                    <MudText Typo="Typo.h6" Class="@($"ml-2 {GetTitleClass()} flex-grow-1")" Style="font-size: 1rem;">@CurrentTask.Title</MudText>
                </div>

                <!-- Дедлайн -->
                @if (CurrentTask.Deadline.HasValue)
                {
                    <MudText Typo="Typo.caption" Color="Color.Warning" Class="mb-1">
                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Class="mr-1"/>
                        До @CurrentTask.Deadline.Value.ToString("dd.MM.yyyy")
                    </MudText>
                }

                <!-- Описание (сокращенное) -->
                @if (!string.IsNullOrEmpty(CurrentTask.Description))
                {
                    <MudText Typo="Typo.caption" Class="@($"mb-2 {GetDescriptionClass()}")" Style="max-height: 3em; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                        @CurrentTask.Description
                    </MudText>
                }

                <!-- Метки (компактные) -->
                <div class="d-flex flex-column gap-1 mt-2">
                    <div class="d-flex justify-space-between">
                        <MudText Typo="Typo.caption" Color="Color.Primary">Приоритет:</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Primary">@CurrentTask.UserPriority</MudText>
                    </div>
                    <div class="d-flex justify-space-between">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Сложность:</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@CurrentTask.Complexity</MudText>
                    </div>
                    <div class="d-flex justify-space-between">
                        <MudText Typo="Typo.caption" Color="Color.Tertiary">Интерес:</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Tertiary">@CurrentTask.Interest/10</MudText>
                    </div>
                    @if (CurrentTask.EstimatedHours > 0)
                    {
                        <div class="d-flex justify-space-between">
                            <MudText Typo="Typo.caption" Color="Color.Info">Время:</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Info">@CurrentTask.EstimatedHours ч</MudText>
                        </div>
                    }
                </div>
            </div>

            <!-- Кнопки действий внизу -->
            <div class="d-flex justify-space-between align-center pa-3 border-top">
                <div class="d-flex gap-1">
                    @if (ShowConfigureButton)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.BuildCircle" 
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       OnClick="@(() => ConfigureTask(CurrentTask))"
                                       Title="Настроить задачу"/>
                    }
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   OnClick="@(() => EditTask(CurrentTask))"/>
                    @if (CurrentTask.IsFavorite)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Star" Size="Size.Small"
                                       Color="Color.Warning" OnClick="@(() => ToggleFavorite(CurrentTask))"/>
                    }
                    else
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.StarBorder" Size="Size.Small"
                                       OnClick="@(() => ToggleFavorite(CurrentTask))"/>
                    }
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                               Color="Color.Error" OnClick="@(() => DeleteTask(CurrentTask))"/>
            </div>
        </div>
    </MudCard>
}
else
{
    <!-- Карточка для списка (оригинальная версия) -->
    <MudCard Class="@($"my-2 task-card {GetTaskCardClass()}")" Elevation="2">
        <div class="d-flex">
            <!-- Вертикальный индикатор приоритета -->
            <div class="priority-indicator-vertical" style="@($"background-color: {ColorTranslator.ToHtml(PriorityServiceObj.GetColor(CurrentTask.UserPriority)) }")"></div>

            <div class="flex-grow-1 pa-3">
                <div class="d-flex justify-space-between align-start">
                    <div class="flex-grow-1">
                        <!-- Чекбокс завершения -->
                        <div class="d-flex align-center mb-2">
                            <MudCheckBox T="bool" @bind-Checked="_isCompleted"
                                         Color="Color.Success"
                                         OnCheckedChanged="HandleCompletionChange"/>
                            <MudText Typo="Typo.h6" Class="@($"ml-2 {GetTitleClass()}")">@CurrentTask.Title</MudText>
                        </div>

                        <!-- Дедлайн -->
                        @if (CurrentTask.Deadline.HasValue)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Warning" Class="mb-2">
                                <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Class="mr-1"/>
                                До @CurrentTask.Deadline.Value.ToString("dd.MM.yyyy")
                            </MudText>
                        }

                        <!-- Описание -->
                        @if (!string.IsNullOrEmpty(CurrentTask.Description))
                        {
                            <MudText Typo="Typo.body2" Class="@($"mb-2 {GetDescriptionClass()}")">@CurrentTask.Description</MudText>
                        }

                        <!-- Метки -->
                        <div class="d-flex align-center gap-2 mt-2 flex-wrap">
                            <MudChip T="string" Size="Size.Small">
                                Приоритет: @CurrentTask.UserPriority
                            </MudChip>
                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary">
                                Сложность: @CurrentTask.Complexity
                            </MudChip>
                            <MudChip T="string" Size="Size.Small" Color="Color.Tertiary">
                                Интерес: @CurrentTask.Interest/10
                            </MudChip>
                            @if (CurrentTask.EstimatedHours > 0)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Info">
                                    @CurrentTask.EstimatedHours ч
                                </MudChip>
                            }
                        </div>
                    </div>

                    <!-- Кнопки действий -->
                    <div class="d-flex flex-column gap-1">
                        @if (ShowConfigureButton)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.BuildCircle" 
                                           Size="Size.Small"
                                           Color="Color.Primary"
                                           OnClick="@(() => ConfigureTask(CurrentTask))"
                                           Title="Настроить задачу"/>
                        }
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       OnClick="@(() => EditTask(CurrentTask))"/>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                       Color="Color.Error" OnClick="@(() => DeleteTask(CurrentTask))"/>
                        @if (CurrentTask.IsFavorite)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Star" Size="Size.Small"
                                           Color="Color.Warning" OnClick="@(() => ToggleFavorite(CurrentTask))"/>
                        }
                        else
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.StarBorder" Size="Size.Small"
                                           OnClick="@(() => ToggleFavorite(CurrentTask))"/>
                        }
                    </div>
                </div>
            </div>
        </div>
    </MudCard>
}

<style>
    .priority-indicator-vertical {
        width: 6px;
        border-radius: 3px 0 0 3px;
        min-height: 100%;
    }

    .priority-indicator-horizontal {
        height: 4px;
        border-radius: 2px 2px 0 0;
        width: 100%;
    }

    .completed .mud-text {
        text-decoration: line-through;
        color: var(--mud-palette-text-disabled);
    }

    .task-card {
        transition: transform 0.2s ease-in-out;
    }

    .task-card:hover {
        transform: translateY(-2px);
    }
</style>

@code {
    [Parameter] public TaskItem CurrentTask { get; set; } = null!;
    [Parameter] public EventCallback<TaskItem> OnTaskUpdated { get; set; }
    [Parameter] public EventCallback<TaskItem> OnTaskDeleted { get; set; }
    [Parameter] public bool IsGridView { get; set; }
    [Parameter] public bool ShowConfigureButton { get; set; } // Новый параметр для кнопки настройки
    
    private PriorityService PriorityServiceObj => PriorityService.Shared;
    private bool _isCompleted;

    protected override void OnParametersSet()
    {
        _isCompleted = CurrentTask.Status == TaskStatus.Completed;
    }

    private string GetTaskCardClass()
    {
        return CurrentTask.Status switch
        {
            TaskStatus.Completed => "completed",
            TaskStatus.Irrelevant => "irrelevant",
            _ => ""
        };
    }

    private string GetTitleClass() => CurrentTask.Status == TaskStatus.Completed ? "text-strikethrough" : "";
    private string GetDescriptionClass() => CurrentTask.Status == TaskStatus.Completed ? "text-strikethrough" : "";

    private async Task EditTask(TaskItem task)
    {
        var parameters = new DialogParameters
        {
            [nameof(TaskEditDialog.ExistingTask)] = task
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogServiceObj.ShowAsync<TaskEditDialog>("Редактировать задачу", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await OnTaskUpdated.InvokeAsync(task);
        }
    }

    private async Task ConfigureTask(TaskItem task)
    {
        var parameters = new DialogParameters
        {
            [nameof(TaskEditDialog.ExistingTask)] = task
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogServiceObj.ShowAsync<TaskEditDialog>("Настройка задачи", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await OnTaskUpdated.InvokeAsync(task);
        }
    }

    private async Task DeleteTask(TaskItem task)
    {
        var parameters = new DialogParameters
        {
            [nameof(ConfirmDialog.Title)] = "Удаление задачи",
            [nameof(ConfirmDialog.Content)] = $"Вы уверены, что хотите удалить задачу \"{task.Title}\"?",
            [nameof(ConfirmDialog.ConfirmText)] = "Удалить"
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogServiceObj.ShowAsync<ConfirmDialog>("Подтверждение", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
             TaskRepo.Delete(task.Id);
            Snackbar.Add("Задача удалена", Severity.Success);
            await OnTaskDeleted.InvokeAsync(task);
        }
    }

    private async Task ToggleFavorite(TaskItem task)
    {
        task.IsFavorite = !task.IsFavorite;
         TaskRepo.Update(task);
        await OnTaskUpdated.InvokeAsync(task);
        Snackbar.Add(task.IsFavorite ? "Добавлено в избранное" : "Убрано из избранного", Severity.Info);
    }

    private async Task HandleCompletionChange(bool isCompleted)
    {
        _isCompleted = isCompleted;
        CurrentTask.Status = isCompleted ? TaskStatus.Completed : TaskStatus.Planned;
        
        try
        {
            TaskRepo.Update(CurrentTask);
            await OnTaskUpdated.InvokeAsync(CurrentTask);
            Snackbar.Add(isCompleted ? "Задача завершена!" : "Задача возобновлена", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка обновления статуса: {ex.Message}", Severity.Error);
            // Откатываем изменение
            _isCompleted = !isCompleted;
            CurrentTask.Status = isCompleted ? TaskStatus.Planned : TaskStatus.Completed;
            StateHasChanged();
        }
    }
}