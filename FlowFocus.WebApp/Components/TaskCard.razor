@using FlowFocus.WebApp.Dialogs
@inject IDialogService DialogService
@inject ITaskRepository TaskRepo
@inject IProcrastinationService ProcrastinationService
@inject ISnackbar Snackbar
<MudCard Class="@($"my-2 task-card {GetTaskCardClass()}")" Elevation="2">
    <div class="d-flex">
        <!-- Вертикальный индикатор приоритета -->
        <div class="priority-indicator-vertical" style="@GetPriorityStyle(Task.UserPriority)"></div>

        <div class="flex-grow-1 pa-3">
            <div class="d-flex justify-space-between align-start">
                <div class="flex-grow-1">
                    <!-- Чекбокс завершения -->
                    <div class="d-flex align-center mb-2">
                        <MudCheckBox T="bool" @bind-Checked="_isCompleted"
                                     Color="Color.Success"
                                     OnCheckedChanged="HandleCompletionChange"/>
                        <MudText Typo="Typo.h6" Class="@($"ml-2 {GetTitleClass()}")">@Task.Title</MudText>
                    </div>

                    <!-- Дедлайн -->
                    @if (Task.Deadline.HasValue)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Warning" Class="mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Class="mr-1"/>
                            До @Task.Deadline.Value.ToString("dd.MM.yyyy")
                        </MudText>
                    }

                    <!-- Описание -->
                    @if (!string.IsNullOrEmpty(Task.Description))
                    {
                        <MudText Typo="Typo.body2" Class="@($"mb-2 {GetDescriptionClass()}")">@Task.Description</MudText>
                    }

                    <!-- Метки -->
                    <div class="d-flex align-center gap-2 mt-2 flex-wrap">
                        <MudChip T="string" Size="Size.Small" Color="@GetPriorityColor(Task.UserPriority)">
                            Приоритет: @Task.UserPriority
                        </MudChip>
                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary">
                            Сложность: @Task.Complexity
                        </MudChip>
                        <MudChip T="string" Size="Size.Small" Color="Color.Tertiary">
                            Интерес: @Task.Interest/10
                        </MudChip>
                        @if (Task.EstimatedHours > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info">
                                @Task.EstimatedHours ч
                            </MudChip>
                        }
                    </div>
                </div>

                <!-- Кнопки действий -->
                <div class="d-flex flex-column gap-1">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   OnClick="@(() => EditTask(Task))"/>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                   Color="Color.Error" OnClick="@(() => DeleteTask(Task))"/>
                    @if (Task.IsFavorite)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Star" Size="Size.Small"
                                       Color="Color.Warning" OnClick="@(() => ToggleFavorite(Task))"/>
                    }
                    else
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.StarBorder" Size="Size.Small"
                                       OnClick="@(() => ToggleFavorite(Task))"/>
                    }
                </div>
            </div>
        </div>
    </div>
</MudCard>

<style>
    .priority-indicator-vertical {
        width: 6px;
        border-radius: 3px 0 0 3px;
        min-height: 100%;
    }

    .task-card.completed {
        opacity: 0.7;
        background-color: var(--mud-palette-action-disabled-background);
    }

    .task-card.irrelevant {
        opacity: 0.5;
        background-color: var(--mud-palette-grey-lighter);
    }

    .completed .mud-text {
        text-decoration: line-through;
        color: var(--mud-palette-text-disabled);
    }
</style>

@code {
    [Parameter] public TaskItem Task { get; set; } = null!;
    [Parameter] public EventCallback<TaskItem> OnTaskUpdated { get; set; }
    [Parameter] public EventCallback<TaskItem> OnTaskDeleted { get; set; }

    private bool _isCompleted;

    protected override void OnParametersSet()
    {
        _isCompleted = Task.Status == TaskStatus.Completed;
    }

    private string GetTaskCardClass()
    {
        return Task.Status switch
        {
            TaskStatus.Completed => "completed",
            TaskStatus.Irrelevant => "irrelevant",
            _ => ""
        };
    }

    private string GetTitleClass() => Task.Status == TaskStatus.Completed ? "text-strikethrough" : "";
    private string GetDescriptionClass() => Task.Status == TaskStatus.Completed ? "text-strikethrough" : "";

    private string GetPriorityStyle(int priority)
    {
        var color = priority switch
        {
            0 => "#4CAF50", 1 => "#F44336", 3 => "#FF9800", 5 => "#2196F3",
            8 => "#9C27B0", 13 => "#607D8B", 21 => "#00BCD4", 34 => "#FF4081",
            _ => "#757575"
        };
        return $"background: {color}";
    }

    private Color GetPriorityColor(int priority)
    {
        return priority switch
        {
            0 => Color.Success,
            1 => Color.Error,
            3 => Color.Warning,
            5 => Color.Info,
            8 => Color.Secondary,
            13 => Color.Tertiary,
            21 => Color.Default,
            34 => Color.Default,
            _ => Color.Default
        };
    }

    private async Task EditTask(TaskItem task)
    {
        var parameters = new DialogParameters
        {
            [nameof(TaskEditDialog.ExistingTask)] = task
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<TaskEditDialog>("Редактировать задачу", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await OnTaskUpdated.InvokeAsync(task);
        }
    }

    private async Task DeleteTask(TaskItem task)
    {
        var parameters = new DialogParameters
        {
            [nameof(ConfirmDialog.Title)] = "Удаление задачи",
            [nameof(ConfirmDialog.Content)] = $"Вы уверены, что хотите удалить задачу \"{task.Title}\"?",
            [nameof(ConfirmDialog.ConfirmText)] = "Удалить"
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Подтверждение", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await TaskRepo.DeleteAsync(task.Id);
            Snackbar.Add("Задача удалена", Severity.Success);
            await OnTaskDeleted.InvokeAsync(task);
        }
    }

    private async Task ToggleFavorite(TaskItem task)
    {
        task.IsFavorite = !task.IsFavorite;
        await TaskRepo.UpdateAsync(task);
        await OnTaskUpdated.InvokeAsync(task);
        Snackbar.Add(task.IsFavorite ? "Добавлено в избранное" : "Убрано из избранного", Severity.Info);
    }

}