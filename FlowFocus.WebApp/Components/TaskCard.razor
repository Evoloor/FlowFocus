@using FlowFocus.Core.Models
@using FlowFocus.Data
@using FlowFocus.WebApp.Dialogs
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ITaskRepository TaskRepo

<MudCard Elevation="2" Class="my-2">
    <MudCardContent>
        <div class="d-flex align-start">
            <div class="flex-grow-1">
                <MudText Typo="Typo.h6" Class="mb-1">@TaskItem.Title</MudText>
                @if (!string.IsNullOrWhiteSpace(TaskItem.Description))
                {
                    <MudText Typo="Typo.body2" Color="Color.Tertiary" Class="mb-2">
                        @TaskItem.Description
                    </MudText>
                }
                
                <div class="d-flex align-center flex-wrap gap-2">
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">Интерес: @TaskItem.Interest/10</MudChip>
                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary">Сложность: @TaskItem.Complexity</MudChip>
                    <MudChip T="string" Size="Size.Small" Color="Color.Tertiary">Часы: @TaskItem.Hours</MudChip>
                    @if (TaskItem.Deadline.HasValue)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">
                            @TaskItem.Deadline.Value.ToString("dd.MM.yyyy HH:mm")
                        </MudChip>
                    }
                    <MudChip T="string" Size="Size.Small" Color="GetStatusColor(TaskItem.Status)">
                        @TaskItem.Status
                    </MudChip>
                </div>

                @if (TaskItem.Tags?.Any() == true)
                {
                    <div class="mt-2">
                        @foreach (var tag in TaskItem.Tags)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="mr-1 mb-1">@tag</MudChip>
                        }
                    </div>
                }
            </div>

            <div class="d-flex flex-column ml-2">
                @if (ShowFavoriteAction)
                {
                    <MudIconButton Icon="@(TaskItem.IsFavorite ? Icons.Material.Filled.Star : Icons.Material.Filled.StarBorder)" 
                                  Color="Color.Warning" 
                                  OnClick="@ToggleFavorite" 
                                  Size="Size.Small" />
                }
                @if (ShowEditAction)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                  Color="Color.Primary" 
                                  OnClick="@EditTask" 
                                  Size="Size.Small"
                                  Class="mt-1" />
                }
                @if (ShowDeleteAction)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                  Color="Color.Error" 
                                  OnClick="@DeleteTask" 
                                  Size="Size.Small"
                                  Class="mt-1" />
                }
                @if (ShowCompleteAction)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" 
                                  Color="Color.Success" 
                                  OnClick="@CompleteTask" 
                                  Size="Size.Small"
                                  Class="mt-1" />
                }
                @if (ShowPostponeAction)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Schedule" 
                                  Color="Color.Warning" 
                                  OnClick="@PostponeTask" 
                                  Size="Size.Small"
                                  Class="mt-1" />
                }
                @if (ShowConfirmAction)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.ThumbUp" 
                                  Color="Color.Success" 
                                  OnClick="@ConfirmTask" 
                                  Size="Size.Small"
                                  Class="mt-1" />
                }
            </div>
        </div>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public TaskItem TaskItem { get; set; } = new();
    [Parameter] public bool ShowFavoriteAction { get; set; }
    [Parameter] public bool ShowEditAction { get; set; }
    [Parameter] public bool ShowDeleteAction { get; set; }
    [Parameter] public bool ShowCompleteAction { get; set; }
    [Parameter] public bool ShowPostponeAction { get; set; }
    [Parameter] public bool ShowConfirmAction { get; set; }
    [Parameter] public EventCallback OnTaskDeleted { get; set; }

    private static Color GetStatusColor(TodoTaskStatus status) => status switch
    {
        TodoTaskStatus.Completed => Color.Success,
        TodoTaskStatus.Active => Color.Primary,
        TodoTaskStatus.Planned => Color.Info,
        TodoTaskStatus.Unconfigured => Color.Warning,
        _ => Color.Default
    };

    private async Task ToggleFavorite()
    {
        TaskItem.IsFavorite = !TaskItem.IsFavorite;
        TaskRepo.Update(TaskItem);
        TaskRepo.SaveChanges();
        Snackbar.Add($"Задача {(TaskItem.IsFavorite ? "добавлена в" : "удалена из")} избранного", Severity.Info);
        await InvokeAsync(StateHasChanged);
    }

    private async Task EditTask()
    {
        var parameters = new DialogParameters
        {
            ["Task"] = TaskItem
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = DialogService.Show<EditTaskDialog>("Редактировать задачу", parameters, options);
        var result = await dialog.Result;
        
        if (!result.Canceled)
        {
            TaskRepo.Update(TaskItem);
            TaskRepo.SaveChanges();
            Snackbar.Add($"Задача '{TaskItem.Title}' обновлена", Severity.Success);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task DeleteTask()
    {
        var parameters = new DialogParameters
        {
            ["TaskTitle"] = TaskItem.Title
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = DialogService.Show<DeleteTaskDialog>("Удалить задачу", parameters, options);
        var result = await dialog.Result;
        
        if (!result.Canceled)
        {
            TaskRepo.Delete(TaskItem.Id);
            TaskRepo.SaveChanges();
            Snackbar.Add($"Задача '{TaskItem.Title}' удалена", Severity.Success);
            await OnTaskDeleted.InvokeAsync();
        }
    }

    private async Task CompleteTask()
    {
        TaskItem.Status = TodoTaskStatus.Completed;
        TaskRepo.Update(TaskItem);
        TaskRepo.SaveChanges();
        Snackbar.Add($"Задача '{TaskItem.Title}' завершена", Severity.Success);
        await InvokeAsync(StateHasChanged);
    }

    private async Task PostponeTask()
    {
        TaskItem.Deadline = DateTime.Now.StartOfTomorrow();
        TaskRepo.Update(TaskItem);
        TaskRepo.SaveChanges();
        Snackbar.Add($"Задача '{TaskItem.Title}' перенесена на завтра", Severity.Info);
        await InvokeAsync(StateHasChanged);
    }

    private async Task ConfirmTask()
    {
        TaskItem.Status = TodoTaskStatus.Planned;
        TaskRepo.Update(TaskItem);
        TaskRepo.SaveChanges();
        Snackbar.Add($"Задача '{TaskItem.Title}' запланирована", Severity.Success);
        await InvokeAsync(StateHasChanged);
    }
}