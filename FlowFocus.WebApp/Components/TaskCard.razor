@using FlowFocus.WebApp.Dialogs
@inject IDialogService DialogService
@inject ITaskRepository TaskRepo
@inject ISnackbar Snackbar

<MudCard Class="my-2 task-card" Elevation="2">
    <MudCardContent>
        <div class="d-flex justify-space-between align-start">
            <div class="flex-grow-1">
                <MudText Typo="Typo.h6" Class="mb-2">@Task.Title</MudText>
                @if (!string.IsNullOrEmpty(Task.Description))
                {
                    <MudText Typo="Typo.body2" Class="mb-2">@Task.Description</MudText>
                }

                <div class="d-flex align-center gap-2 mt-2">
                    <MudChip Size="Size.Small" Color="GetPriorityColor(Task.UserPriority)">
                        Приоритет: @Task.UserPriority
                    </MudChip>
                    <MudChip Size="Size.Small" Color="Color.Secondary">
                        Сложность: @Task.Complexity
                    </MudChip>
                    <MudChip Size="Size.Small" Color="Color.Tertiary">
                        Интерес: @Task.Interest/10
                    </MudChip>
                    @if (Task.EstimatedHours > 0)
                    {
                        <MudChip Size="Size.Small" Color="Color.Info">
                            @Task.EstimatedHours ч
                        </MudChip>
                    }
                </div>

                @if (Task.Tags?.Any() == true)
                {
                    <div class="mt-2">
                        @foreach (var tag in Task.Tags)
                        {
                            <MudChip Size="Size.Small" Variant="Variant.Outlined" Class="mr-1">@tag</MudChip>
                        }
                    </div>
                }
            </div>

            <div class="d-flex flex-column gap-1">
                <MudIconButton Icon="Icons.Material.Filled.Edit" Size="Size.Small"
                               OnClick="() => EditTask(Task)"/>
                <MudIconButton Icon="Icons.Material.Filled.Delete" Size="Size.Small"
                               Color="Color.Error" OnClick="() => DeleteTask(Task)"/>
                @if (Task.IsFavorite)
                {
                    <MudIconButton Icon="Icons.Material.Filled.Star" Size="Size.Small"
                                   Color="Color.Warning" OnClick="() => ToggleFavorite(Task)"/>
                }
                else
                {
                    <MudIconButton Icon="Icons.Material.Filled.StarBorder" Size="Size.Small"
                                   OnClick="() => ToggleFavorite(Task)"/>
                }
            </div>
        </div>
    </MudCardContent>

    <MudCardActions>
        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                   OnClick="() => ChangeStatus(Task, TaskStatus.Active)"
                   Disabled="@(Task.Status == TaskStatus.Active)">
            Начать
        </MudButton>
        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                   Color="Color.Success"
                   OnClick="() => ChangeStatus(Task, TaskStatus.Completed)"
                   Disabled="@(Task.Status == TaskStatus.Completed)">
            Завершить
        </MudButton>
        <MudSpacer/>
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            Статус: @Task.Status
        </MudText>
    </MudCardActions>
</MudCard>

@code {
    [Parameter] public TaskItem Task { get; set; } = null!;
    [Parameter] public EventCallback<TaskItem> OnTaskUpdated { get; set; }
    [Parameter] public EventCallback<TaskItem> OnTaskDeleted { get; set; }

    private Color GetPriorityColor(int priority)
    {
        return priority switch
        {
            0 => Color.Success,
            1 => Color.Error,
            3 => Color.Warning,
            5 => Color.Info,
            _ => Color.Default
        };
    }

    private async Task EditTask(TaskItem task)
    {
        var parameters = new DialogParameters
        {
            [nameof(TaskEditDialog.ExistingTask)] = task
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = DialogService.Show<TaskEditDialog>("Редактировать задачу", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await OnTaskUpdated.InvokeAsync(task);
        }
    }

    private async Task DeleteTask(TaskItem task)
    {
        var parameters = new DialogParameters
        {
            [nameof(ConfirmDialog.Title)] = "Удаление задачи",
            [nameof(ConfirmDialog.Content)] = $"Вы уверены, что хотите удалить задачу \"{task.Title}\"?",
            [nameof(ConfirmDialog.ConfirmText)] = "Удалить"
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall };
        var dialog = DialogService.Show<ConfirmDialog>("Подтверждение", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await TaskRepo.DeleteAsync(task.Id);
            Snackbar.Add("Задача удалена", Severity.Success);
            await OnTaskDeleted.InvokeAsync(task);
        }
    }

    private async Task ToggleFavorite(TaskItem task)
    {
        task.IsFavorite = !task.IsFavorite;
        await TaskRepo.UpdateAsync(task);
        await OnTaskUpdated.InvokeAsync(task);
        Snackbar.Add(task.IsFavorite ? "Добавлено в избранное" : "Убрано из избранного", Severity.Info);
    }

    private async Task ChangeStatus(TaskItem task, TaskStatus newStatus)
    {
        task.Status = newStatus;
        await TaskRepo.UpdateAsync(task);
        await OnTaskUpdated.InvokeAsync(task);

        var statusText = newStatus switch
        {
            TaskStatus.Active => "активна",
            TaskStatus.Completed => "завершена",
            _ => "обновлена"
        };

        Snackbar.Add($"Задача отмечена как {statusText}", Severity.Success);
    }

}