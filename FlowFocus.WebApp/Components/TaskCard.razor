@using FlowFocus.WebApp.Dialogs
@inject IDialogService DialogService
@inject ITaskRepository TaskRepo
@inject IProcrastinationService ProcrastinationService
@inject ISnackbar Snackbar

<MudCard Class="my-2 task-card" Elevation="2">
    <MudCardContent>
        <div class="d-flex justify-space-between align-start">
            <div class="flex-grow-1">
                <!-- Градиентная полоска приоритета -->
                <div class="priority-indicator" style="@GetPriorityStyle(Task.UserPriority)"></div>
                
                <MudText Typo="Typo.h6" Class="mb-2">@Task.Title</MudText>
                
                @if (!string.IsNullOrEmpty(Task.Description))
                {
                    <MudText Typo="Typo.body2" Class="mb-2">@Task.Description</MudText>
                }

                <div class="d-flex align-center gap-2 mt-2 flex-wrap">
                    <MudChip T="string" Size="Size.Small" Color="@GetPriorityColor(Task.UserPriority)">
                        Приоритет: @Task.UserPriority
                    </MudChip>
                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary">
                        Сложность: @Task.Complexity
                    </MudChip>
                    <MudChip T="string" Size="Size.Small" Color="Color.Tertiary">
                        Интерес: @Task.Interest/10
                    </MudChip>
                    @if (Task.EstimatedHours > 0)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info">
                            @Task.EstimatedHours ч
                        </MudChip>
                    }
                    @if (!Task.CanBeStarted())
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error">
                            Заблокирована
                        </MudChip>
                    }
                    @if (Task.ProcrastinationCount > 0)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">
                            Откладывалась: @Task.ProcrastinationCount
                        </MudChip>
                    }
                </div>

                @if (Task.Tags?.Any() == true)
                {
                    <div class="mt-2">
                        @foreach (var tag in Task.Tags)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="mr-1 mb-1">@tag</MudChip>
                        }
                    </div>
                }
            </div>

            <div class="d-flex flex-column gap-1">
                <MudIconButton Icon="Icons.Material.Filled.Edit" Size="Size.Small"
                               OnClick="@(() => EditTask(Task))"/>
                <MudIconButton Icon="Icons.Material.Filled.Delete" Size="Size.Small"
                               Color="Color.Error" OnClick="@(() => DeleteTask(Task))"/>
                @if (Task.IsFavorite)
                {
                    <MudIconButton Icon="Icons.Material.Filled.Star" Size="Size.Small"
                                   Color="Color.Warning" OnClick="@(() => ToggleFavorite(Task))"/>
                }
                else
                {
                    <MudIconButton Icon="Icons.Material.Filled.StarBorder" Size="Size.Small"
                                   OnClick="@(() => ToggleFavorite(Task))"/>
                }
                @if (_canProcrastinate)
                {
                    <MudIconButton Icon="Icons.Material.Filled.Snooze" Size="Size.Small"
                                   Color="Color.Warning" OnClick="@(() => ProcrastinateTask(Task))"/>
                }
            </div>
        </div>
    </MudCardContent>

    <MudCardActions>
        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                   OnClick="@(() => ChangeStatus(Task, TaskStatus.Active))"
                   Disabled="@(Task.Status == TaskStatus.Active || !Task.CanBeStarted())">
            Начать
        </MudButton>
        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                   Color="Color.Success"
                   OnClick="@(() => ChangeStatus(Task, TaskStatus.Completed))"
                   Disabled="@(Task.Status == TaskStatus.Completed)">
            Завершить
        </MudButton>
        
        @if (_canProcrastinate)
        {
            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                       Color="Color.Warning"
                       OnClick="@(() => ProcrastinateTask(Task))">
                Отложить
            </MudButton>
        }
        
        <MudSpacer/>
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            Статус: @Task.Status
        </MudText>
    </MudCardActions>
</MudCard>

<style>
    .priority-indicator {
        height: 4px;
        border-radius: 2px;
        margin-bottom: 8px;
        width: 100%;
    }
    
    .task-card {
        position: relative;
    }
</style>

@code {
    [Parameter] public TaskItem Task { get; set; } = null!;
    [Parameter] public EventCallback<TaskItem> OnTaskUpdated { get; set; }
    [Parameter] public EventCallback<TaskItem> OnTaskDeleted { get; set; }

    private bool _canProcrastinate = false;

    protected override async Task OnParametersSetAsync()
    {
        _canProcrastinate = await ProcrastinationService.CanProcrastinateTaskAsync(Task.Id);
    }

    private string GetPriorityStyle(int priority)
    {
        var color = priority switch
        {
            0 => "linear-gradient(90deg, #4CAF50, #66BB6A)", // Зеленый для гарантированных
            1 => "linear-gradient(90deg, #F44336, #EF5350)", // Красный для неотложных
            3 => "linear-gradient(90deg, #FF9800, #FFA726)", // Оранжевый для срочных
            5 => "linear-gradient(90deg, #2196F3, #42A5F5)", // Синий для важных
            8 => "linear-gradient(90deg, #9C27B0, #AB47BC)", // Фиолетовый для среднесрочных
            13 => "linear-gradient(90deg, #607D8B, #78909C)", // Серый для долгосрочных
            21 => "linear-gradient(90deg, #00BCD4, #26C6DA)", // Бирюзовый для саморазвития
            34 => "linear-gradient(90deg, #FF4081, #F06292)", // Розовый для мечт
            _ => "linear-gradient(90deg, #757575, #9E9E9E)"
        };
        return $"background: {color}";
    }

    private Color GetPriorityColor(int priority)
    {
        return priority switch
        {
            0 => Color.Success,
            1 => Color.Error,
            3 => Color.Warning,
            5 => Color.Info,
            8 => Color.Secondary,
            13 => Color.Tertiary,
            21 => Color.Default,
            34 => Color.Default,
            _ => Color.Default
        };
    }

    private async Task EditTask(TaskItem task)
    {
        var parameters = new DialogParameters
        {
            [nameof(TaskEditDialog.ExistingTask)] = task
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<TaskEditDialog>("Редактировать задачу", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await OnTaskUpdated.InvokeAsync(task);
        }
    }

    private async Task DeleteTask(TaskItem task)
    {
        var parameters = new DialogParameters
        {
            [nameof(ConfirmDialog.Title)] = "Удаление задачи",
            [nameof(ConfirmDialog.Content)] = $"Вы уверены, что хотите удалить задачу \"{task.Title}\"?",
            [nameof(ConfirmDialog.ConfirmText)] = "Удалить"
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Подтверждение", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await TaskRepo.DeleteAsync(task.Id);
            Snackbar.Add("Задача удалена", Severity.Success);
            await OnTaskDeleted.InvokeAsync(task);
        }
    }

    private async Task ToggleFavorite(TaskItem task)
    {
        task.IsFavorite = !task.IsFavorite;
        await TaskRepo.UpdateAsync(task);
        await OnTaskUpdated.InvokeAsync(task);
        Snackbar.Add(task.IsFavorite ? "Добавлено в избранное" : "Убрано из избранного", Severity.Info);
    }

    private async Task ChangeStatus(TaskItem task, TaskStatus newStatus)
    {
        task.Status = newStatus;
        await TaskRepo.UpdateAsync(task);
        await OnTaskUpdated.InvokeAsync(task);

        var statusText = newStatus switch
        {
            TaskStatus.Active => "активна",
            TaskStatus.Completed => "завершена",
            _ => "обновлена"
        };

        Snackbar.Add($"Задача отмечена как {statusText}", Severity.Success);
    }

    private async Task ProcrastinateTask(TaskItem task)
    {
        var parameters = new DialogParameters
        {
            [nameof(ConfirmDialog.Title)] = "Отложить задачу",
            [nameof(ConfirmDialog.Content)] = $"Отложить задачу \"{task.Title}\" на завтра?",
            [nameof(ConfirmDialog.ConfirmText)] = "Отложить"
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Подтверждение", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await ProcrastinationService.ProcrastinateTaskAsync(task.Id);
            Snackbar.Add("Задача отложена на завтра", Severity.Warning);
            await OnTaskUpdated.InvokeAsync(task);
        }
    }
}