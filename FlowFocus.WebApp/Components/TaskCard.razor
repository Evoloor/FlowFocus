@using System.Drawing
@using FlowFocus.WebApp.Dialogs
@using Color = MudBlazor.Color
@using Size = MudBlazor.Size
@inject IDialogService DialogServiceObj
@inject ITaskRepository TaskRepo
@inject ISnackbar Snackbar

<MudCard Class="@($"task-card display-mode-{DisplayMode.ToString().ToLower()} {GetTaskCardClass()}")" Elevation="2">
    <div class="task-card-container">
        <!-- Индикатор приоритета -->
        <div class="priority-indicator"
             style="@($"background-color: {ColorTranslator.ToHtml(PriorityServiceObj.GetColor(CurrentTask.UserPriority))}")"></div>

        <div class="task-content">
            <!-- Заголовок и чекбокс -->
            <div class="task-header">
                <MudCheckBox T="bool" @bind-Checked="_isCompleted"
                             ValueChanged="HandleCompletionChange"
                             Color="Color.Success"/>
                <MudText Class="@($"task-title {GetTitleClass()}")">@CurrentTask.Title</MudText>
            </div>

            <!-- Дедлайн -->
            @if (CurrentTask.Deadline.HasValue)
            {
                <div class="deadline">
                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small"/>
                    <MudText Color="Color.Warning">До @CurrentTask.Deadline.Value.ToString("dd.MM.yyyy")</MudText>
                </div>
            }

            <!-- Описание -->
            @if (!string.IsNullOrEmpty(CurrentTask.Description))
            {
                <MudText Class="@($"task-description {GetDescriptionClass()}")">@CurrentTask.Description</MudText>
            }

            <!-- Метки - единая разметка, стили делают разное отображение -->
            <div class="task-metadata">
                @if (CurrentTask.UserPriority.HasValue)
                {
                    <div class="metadata-item priority">
                        <MudText>Приоритет:</MudText>
                        <MudText>@CurrentTask.UserPriority</MudText>
                    </div>
                }
                @if (CurrentTask.Complexity.HasValue)
                {
                    <div class="metadata-item complexity">
                        <MudText>Сложность:</MudText>
                        <MudText>@CurrentTask.Complexity</MudText>
                    </div>
                }
                @if (CurrentTask.Interest.HasValue)
                {
                    <div class="metadata-item interest">
                        <MudText>Интерес:</MudText>
                        <MudText>@CurrentTask.Interest/10</MudText>
                    </div>
                }
                @if (CurrentTask.EstimatedHours > 0)
                {
                    <div class="metadata-item time">
                        <MudText>Время:</MudText>
                        <MudText>@CurrentTask.EstimatedHours ч</MudText>
                    </div>
                }
            </div>
        </div>

        <!-- Кнопки действий - единые, стили позиционируют -->
        <div class="task-actions">
            <div class="action-buttons">
                @if (CurrentTask.Status is TaskStatus.NotConfigured)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.BuildCircle"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   OnClick="@(() => ConfigureTask(CurrentTask))"/>
                }
                else
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   OnClick="@(() => EditTask(CurrentTask))"/>
                }

                @if (CurrentTask.IsFavorite)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Star" Size="Size.Small"
                                   Color="Color.Warning" OnClick="@(() => ToggleFavorite(CurrentTask))"/>
                }
                else
                {
                    <MudIconButton Icon="@Icons.Material.Filled.StarBorder" Size="Size.Small"
                                   OnClick="@(() => ToggleFavorite(CurrentTask))"/>
                }
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                           Color="Color.Error" OnClick="@(() => DeleteTask(CurrentTask))"/>
        </div>
    </div>
</MudCard>
<style>
    /* Базовые стили */
    .task-card {
        transition: transform 0.2s ease-in-out;
    }

    .task-card:hover {
        transform: translateY(-2px);
    }

    .task-card-container {
        display: flex;
        position: relative;
    }

    .priority-indicator {
        border-radius: 3px 0 0 3px;
        width: 6px;
        height: -webkit-fill-available;
    }

    .task-content {
        flex-grow: 1;
        padding: 12px;
    }

    .task-header {
        display: flex;
        align-items: center;
        margin-bottom: 8px;
    }

    .task-title {
        margin-left: 8px;
        font-size: 1.125rem;
        font-weight: 500;
    }

    .deadline {
        display: flex;
        align-items: center;
        gap: 4px;
        margin-bottom: 8px;
    }

    .task-description {
        margin-bottom: 8px;
    }

    .task-metadata {
        margin-top: 8px;
    }

    .metadata-item {
        display: flex;
        justify-content: space-between;
    }

    .task-actions {
        display: flex;
        gap: 4px;
        padding: 8px;
    }

    .action-buttons {
        display: flex;
        gap: 4px;
    }

    /* Стили для режима списка (по умолчанию) */
    .task-card.display-mode-list .task-card-container {
        flex-direction: row;
    }

    .task-card.display-mode-list .task-actions {
        flex-direction: column;
        border-left: 1px solid var(--mud-palette-lines-default);
    }

    .task-card.display-mode-list .metadata-item {
        display: none; /* Скрываем вертикальные метки в списке */
    }

    /* Чипы для списка */
    .task-card.display-mode-list .task-metadata {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
    }

    /* Стили для режима сетки */
    .task-card.display-mode-grid {
        height: 100%;
    }

    .task-card.display-mode-grid .task-card-container {
        flex-direction: column;
        height: 100%;
    }

    .task-card.display-mode-grid .priority-indicator {
        width: 100%;
        height: 4px;
        border-radius: 2px 2px 0 0;
    }

    .task-card.display-mode-grid .task-content {
        flex-grow: 1;
    }

    .task-card.display-mode-grid .task-actions {
        justify-content: space-between;
        align-items: center;
        border-top: 1px solid var(--mud-palette-lines-default);
    }

    .task-card.display-mode-grid .task-title {
        font-size: 1rem;
    }

    .task-card.display-mode-grid .task-description {
        max-height: 3em;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    /* Скрываем чипы в сетке */
    .task-card.display-mode-grid .task-metadata > *:not(.metadata-item) {
        display: none;
    }

    /* Стили для компактного режима */
    .task-card.display-mode-compact .task-card-container {
        align-items: center;
    }

    .task-card.display-mode-compact .task-content {
        padding: 8px;
    }

    .task-card.display-mode-compact .task-title {
        font-size: 1rem;
        margin-bottom: 0;
    }

    .task-card.display-mode-compact .deadline,
    .task-card.display-mode-compact .task-description {
        display: none;
    }

    .task-card.display-mode-compact .task-metadata {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 4px;
    }

    .task-card.display-mode-compact .metadata-item {
        display: none; /* Скрываем вертикальные метки */
    }

    /* Состояния задачи */
    .completed .mud-text {
        text-decoration: line-through;
        color: var(--mud-palette-text-disabled);
    }
</style>

@code {
    [Parameter] public TaskItem CurrentTask { get; set; } = null!;
    [Parameter] public EventCallback<TaskItem> OnTaskUpdated { get; set; }
    [Parameter] public EventCallback<TaskItem> OnTaskDeleted { get; set; }
    [Parameter] public DisplayMode DisplayMode { get; set; }

    private PriorityService PriorityServiceObj => PriorityService.Shared;
    private bool _isCompleted;

    protected override void OnParametersSet()
    {
        _isCompleted = CurrentTask.Status == TaskStatus.Completed;
    }

    private string GetTaskCardClass()
    {
        return CurrentTask.Status switch
        {
            TaskStatus.Completed => "completed",
            TaskStatus.Irrelevant => "irrelevant",
            _ => ""
        };
    }

    private string GetTitleClass() => CurrentTask.Status == TaskStatus.Completed ? "text-strikethrough" : "";
    private string GetDescriptionClass() => CurrentTask.Status == TaskStatus.Completed ? "text-strikethrough" : "";

    private async Task EditTask(TaskItem task)
    {
        var parameters = new DialogParameters
        {
            [nameof(TaskEditDialog.ExistingTask)] = task
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogServiceObj.ShowAsync<TaskEditDialog>("Редактировать задачу", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await OnTaskUpdated.InvokeAsync(task);
        }
    }

    private async Task ConfigureTask(TaskItem task)
    {
        var parameters = new DialogParameters
        {
            [nameof(TaskEditDialog.ExistingTask)] = task
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogServiceObj.ShowAsync<TaskEditDialog>("Настройка задачи", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await OnTaskUpdated.InvokeAsync(task);
        }
    }

    private async Task DeleteTask(TaskItem task)
    {
        var parameters = new DialogParameters
        {
            [nameof(ConfirmDialog.Title)] = "Удаление задачи",
            [nameof(ConfirmDialog.Content)] = $"Вы уверены, что хотите удалить задачу \"{task.Title}\"?",
            [nameof(ConfirmDialog.ConfirmText)] = "Удалить"
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogServiceObj.ShowAsync<ConfirmDialog>("Подтверждение", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            TaskRepo.Delete(task.Id);
            Snackbar.Add("Задача удалена", Severity.Success);
            await OnTaskDeleted.InvokeAsync(task);
        }
    }

    private async Task ToggleFavorite(TaskItem task)
    {
        task.IsFavorite = !task.IsFavorite;
        TaskRepo.Update(task);
        await OnTaskUpdated.InvokeAsync(task);
        Snackbar.Add(task.IsFavorite ? "Добавлено в избранное" : "Убрано из избранного", Severity.Info);
    }

    private async Task HandleCompletionChange(bool isCompleted)
    {
        _isCompleted = isCompleted;
        CurrentTask.Status = isCompleted ? TaskStatus.Completed : TaskStatus.Planned;

        try
        {
            TaskRepo.Update(CurrentTask);
            await OnTaskUpdated.InvokeAsync(CurrentTask);
            Snackbar.Add(isCompleted ? "Задача завершена!" : "Задача возобновлена", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка обновления статуса: {ex.Message}", Severity.Error);
            // Откатываем изменение
            _isCompleted = !isCompleted;
            CurrentTask.Status = isCompleted ? TaskStatus.Planned : TaskStatus.Completed;
            StateHasChanged();
        }
    }

}