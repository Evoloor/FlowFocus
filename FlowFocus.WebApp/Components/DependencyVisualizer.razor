@inject IDependencyRepository DependencyRepo

<MudPaper Class="pa-4" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb-4">Зависимости задачи: @Task?.Title</MudText>
    
    @if (_dependencies.Any() == true)
    {
        <MudList T="string">
            @foreach (var dependency in _dependencies)
            {
                <MudListItem T="string">
                    <MudChip T="string" Size="Size.Small" Color="GetDependencyColor(dependency.Type)" Class="mr-2">
                        @dependency.Type
                    </MudChip>
                    <MudText>@dependency.TargetTask?.Title</MudText>
                </MudListItem>
            }
        </MudList>
    }
    else
    {
        <MudText Color="Color.Secondary">Нет зависимостей</MudText>
    }
</MudPaper>

@code {
    [Parameter] public TaskItem? Task { get; set; }
    
    private List<Dependency> _dependencies = [];

    protected override void OnParametersSet()
    {
        if (Task != null)
        {
            _dependencies = (DependencyRepo.GetDependenciesForTask(Task.Id))?.ToList() ?? [];
        }
    }

    private Color GetDependencyColor(DependencyType type)
    {
        return type switch
        {
            DependencyType.Blocking => Color.Error,
            DependencyType.Related => Color.Info,
            _ => Color.Default
        };
    }
}