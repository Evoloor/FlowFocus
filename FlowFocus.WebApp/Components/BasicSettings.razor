@inject ISettingsRepository SettingsRepo
@inject ISnackbar Snackbar

<MudGrid>
    <MudItem xs="12">
        <MudText Typo="Typo.h6" Class="mb-4">Основные настройки</MudText>
    </MudItem>
    
    <MudItem xs="12" sm="6">
        <MudNumericField T="int" @bind-Value="Settings.DayStartHour" 
                         Label="Время начала дня (0-23)" 
                         Min="0" 
                         Max="23"
                         Variant="Variant.Outlined" />
    </MudItem>
    
    <MudItem xs="12" sm="6">
        <MudNumericField T="double" @bind-Value="Settings.DailyTimeLimit" 
                         Label="Дневной лимит времени (часы)" 
                         Min="1" 
                         Max="24"
                         Step="0.5"
                         Variant="Variant.Outlined" />
    </MudItem>
    
    <MudItem xs="12" sm="6">
        <MudNumericField T="int" @bind-Value="Settings.DailyComplexityLimit" 
                         Label="Дневной лимит сложности" 
                         Min="10" 
                         Max="200"
                         Variant="Variant.Outlined" />
    </MudItem>

    <MudItem xs="12" sm="6">
        <MudNumericField T="int" @bind-Value="Settings.MaxComplexTasksPerDay" 
                         Label="Макс. сложных задач в день" 
                         Min="1" 
                         Max="10"
                         Variant="Variant.Outlined" />
    </MudItem>
    
    <MudItem xs="12" Class="mt-4">
        <MudButton Variant="Variant.Filled" 
                  Color="Color.Primary" 
                  OnClick="SaveSettings"
                  StartIcon="@Icons.Material.Filled.Save">
            Сохранить основные настройки
        </MudButton>
    </MudItem>
</MudGrid>

@code {
    private UserSettings Settings { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        Settings = await SettingsRepo.GetUserSettingsAsync();
    }

    private async Task SaveSettings()
    {
        try
        {
            await SettingsRepo.UpdateAsync(Settings);
            Snackbar.Add("Основные настройки сохранены", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка: {ex.Message}", Severity.Error);
        }
    }
}