@inject ISettingsRepository SettingsRepo
@inject ISnackbar Snackbar

<MudGrid>
    <MudItem xs="12">
        <MudText Typo="Typo.h6" Class="mb-4">Даты повышения приоритета</MudText>
    </MudItem>
    
    <!-- Grid для приоритетов 1, 3, 5 -->
    <MudItem xs="12">
        <MudGrid>
            <MudItem xs="12" sm="4">
                <MudPaper Class="pa-3 text-center" Elevation="1">
                    <MudText Typo="Typo.h6" Color="Color.Error">Приоритет 1</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Неотложные</MudText>
                    <MudTextField T="string" @bind-Value="_priority1Dates"
                                 Label="Даты (ДД.ММ)"
                                 Variant="Variant.Outlined"
                                 Class="mt-2" />
                </MudPaper>
            </MudItem>
            
            <MudItem xs="12" sm="4">
                <MudPaper Class="pa-3 text-center" Elevation="1">
                    <MudText Typo="Typo.h6" Color="Color.Warning">Приоритет 3</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Срочные</MudText>
                    <MudTextField T="string" @bind-Value="_priority3Dates"
                                 Label="Даты (ДД.ММ)"
                                 Variant="Variant.Outlined"
                                 Class="mt-2" />
                </MudPaper>
            </MudItem>
            
            <MudItem xs="12" sm="4">
                <MudPaper Class="pa-3 text-center" Elevation="1">
                    <MudText Typo="Typo.h6" Color="Color.Info">Приоритет 5</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Важные</MudText>
                    <MudTextField T="string" @bind-Value="_priority5Dates"
                                 Label="Даты (ДД.ММ)"
                                 Variant="Variant.Outlined"
                                 Class="mt-2" />
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudItem>

    <MudItem xs="12" Class="mt-4">
        <MudButton Variant="Variant.Filled" 
                  Color="Color.Primary" 
                  OnClick="SavePriorityDates"
                  StartIcon="@Icons.Material.Filled.Save">
            Сохранить даты приоритетов
        </MudButton>
    </MudItem>
</MudGrid>

@code {
    private UserSettings Settings { get; set; } = new();
    private string _priority1Dates = string.Empty;
    private string _priority3Dates = string.Empty;
    private string _priority5Dates = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Settings = await SettingsRepo.GetUserSettingsAsync();
        // Инициализация дат из настроек
        InitializePriorityDates();
    }

    private void InitializePriorityDates()
    {
        // Здесь должна быть логика парсинга Settings.PriorityBoostDates
        // и распределения по соответствующим полям
        // Для примера оставляем пустыми
        _priority1Dates = "";
        _priority3Dates = "";
        _priority5Dates = "";
    }

    private async Task SavePriorityDates()
    {
        try
        {
            // Логика объединения всех дат в Settings.PriorityBoostDates
            Settings.PriorityBoostDates = $"{_priority1Dates},{_priority3Dates},{_priority5Dates}";
            
            await SettingsRepo.UpdateAsync(Settings);
            Snackbar.Add("Даты приоритетов сохранены", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка: {ex.Message}", Severity.Error);
        }
    }
}