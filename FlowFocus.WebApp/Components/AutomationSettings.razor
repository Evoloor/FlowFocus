@inject ISettingsRepository SettingsRepo
@inject ISnackbar Snackbar

<MudGrid>
    <MudItem xs="12">
        <MudText Typo="Typo.h6" Class="mb-4">Автоматизация</MudText>
    </MudItem>
    
    <MudItem xs="12">
        <MudSwitch T="bool" @bind-Checked="Settings.AutoRecalculateOnAdd" 
                   Color="Color.Primary">
            Автоматический пересчет при добавлении задач
        </MudSwitch>
    </MudItem>
    
    <MudItem xs="12">
        <MudSwitch T="bool" @bind-Checked="Settings.ShowFavorites" 
                   Color="Color.Warning">
            Показывать избранные задачи
        </MudSwitch>
    </MudItem>

    <MudItem xs="12">
        <MudSwitch T="bool" @bind-Checked="Settings.ShowProcrastinationButton" 
                   Color="Color.Info">
            Показывать кнопку откладывания
        </MudSwitch>
    </MudItem>

    <MudItem xs="12">
        <MudSwitch T="bool" @bind-Checked="Settings.AutoBalanceTasks" 
                   Color="Color.Success">
            Автоматическая балансировка задач
        </MudSwitch>
    </MudItem>
    
    <MudItem xs="12" Class="mt-4">
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   OnClick="SaveSettings"
                   StartIcon="@Icons.Material.Filled.Save">
            Сохранить настройки автоматизации
        </MudButton>
    </MudItem>
</MudGrid>

@code {
    private UserSettings Settings { get; set; } = new();

    protected override void OnInitialized()
    {
        Settings = SettingsRepo.GetUserSettings();
    }

    private async Task SaveSettings()
    {
        try
        {
            SettingsRepo.Update(Settings);
            Snackbar.Add("Настройки автоматизации сохранены", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка: {ex.Message}", Severity.Error);
        }
    }
}