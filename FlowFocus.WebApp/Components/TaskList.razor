@using FlowFocus.WebApp.Dialogs
@inject ITaskRepository TaskRepo
@inject IDialogService DialogServiceObj

<MudGrid>
    <MudItem xs="12" Class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h4">@Title</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                  StartIcon="@Icons.Material.Filled.Add"
                  OnClick="@ShowCreateDialog">
            Новая задача
        </MudButton>
    </MudItem>

    <MudItem xs="12" Class="mb-3">
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="TaskStatus?" @bind-Value="_selectedStatus" Label="Статус" Clearable>
                    <MudSelectItem T="TaskStatus?" Value="null">Все</MudSelectItem>
                    @foreach (var status in Enum.GetValues<TaskStatus>())
                    {
                        <MudSelectItem T="TaskStatus?" Value="status">@status</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudTextField @bind-Value="_searchText" Label="Поиск" Immediate/>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="SortField" @bind-Value="_sortBy" Label="Сортировка">
                    <MudSelectItem T="SortField" Value="SortField.Priority">По приоритету</MudSelectItem>
                    <MudSelectItem T="SortField" Value="SortField.Deadline">По сроку</MudSelectItem>
                    <MudSelectItem T="SortField" Value="SortField.Interest">По интересу</MudSelectItem>
                    <MudSelectItem T="SortField" Value="SortField.Complexity">По сложности</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="3" Class="d-flex align-end">
                <MudButton Variant="Variant.Outlined" OnClick="@LoadTasks" 
                          Class="ml-auto" Size="Size.Small">
                    Обновить
                </MudButton>
            </MudItem>
        </MudGrid>  
    </MudItem>

    <MudItem xs="12">
        @if (_isLoading)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate/>
        }
        else if (!FilteredTasks.Any())
        {
            <MudPaper Class="py-12 text-center">
                <MudText Typo="Typo.h6" Color="Color.Secondary">Задачи не найдены</MudText>
            </MudPaper>
        }
        else
        {
            foreach (var task in FilteredTasks)
            {
                <TaskCard CurrentTask="task" 
                         OnTaskUpdated="HandleTaskUpdated"
                         OnTaskDeleted="HandleTaskDeleted" />
            }
        }
    </MudItem>
</MudGrid>

@code {
    [Parameter]
    public EventCallback OnTasksUpdated { get; set; }
    [Parameter] public string Title { get; set; } = "Задачи";
    [Parameter] public TaskStatus? FilterStatus { get; set; }
    [Parameter] public DateTime? FilterDate { get; set; }

    private List<TaskItem> _tasks = [];
    private List<TaskItem> FilteredTasks => GetFilteredTasks();
    private bool _isLoading = true;

    private TaskStatus? _selectedStatus;
    private string _searchText = string.Empty;
    private SortField _sortBy = SortField.Priority;

    protected override void OnInitialized()
    {
        LoadTasks();
    }

    protected override void OnParametersSet()
    {
        if (FilterStatus.HasValue)
        {
            _selectedStatus = FilterStatus;
        }
        LoadTasks();
    }

    private void LoadTasks()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            if (FilterDate.HasValue)
            {
                _tasks = TaskRepo.GetByDate(FilterDate.Value).ToList();
            }
            else if (FilterStatus.HasValue)
            {
                _tasks = TaskRepo.GetByStatus(FilterStatus.Value).ToList();
            }
            else
            {
                _tasks = TaskRepo.GetAll().ToList();
            }
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private List<TaskItem> GetFilteredTasks()
    {
        var query = _tasks.AsEnumerable();

        if (_selectedStatus.HasValue)
        {
            query = query.Where(t => t.Status == _selectedStatus.Value);
        }

        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            query = query.Where(t => 
                t.Title.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                t.Description?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) == true ||
                t.Tags.Any(tag => tag.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
            );
        }

        query = _sortBy switch
        {
            SortField.Priority => query.OrderBy(t => t.UserPriority),
            SortField.Deadline => query.OrderBy(t => t.Deadline ?? DateTime.MaxValue),
            SortField.Interest => query.OrderByDescending(t => t.Interest),
            SortField.Complexity => query.OrderBy(t => t.Complexity),
            _ => query
        };

        return query.ToList();
    }

    private async Task ShowCreateDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogServiceObj.ShowAsync<TaskEditDialog>("Новая задача", options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            LoadTasks();
        }
    }

    private void HandleTaskUpdated(TaskItem task)
    {
         LoadTasks();
    }

    private void HandleTaskDeleted(TaskItem task)
    {
         LoadTasks();
    }

    private enum SortField
    {
        Priority,
        Deadline,
        Interest,
        Complexity
    }
}