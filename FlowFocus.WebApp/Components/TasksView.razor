@using FlowFocus.Core.Models
<MudPaper Elevation="1" Class="pa-4">
    <MudText Typo="Typo.h5" Class="mb-3">@Title</MudText>
    
    @if (ShowFilters)
    {
        <MudGrid Class="mb-3">
            <MudItem xs="12" sm="6">
                <MudSelect Label="Статус" @bind-Value="StatusFilter" T="TodoTaskStatus?">
                    <MudSelectItem T="TodoTaskStatus?" Value="@(null)">Все</MudSelectItem>
                    @foreach (var status in Enum.GetValues<TodoTaskStatus>())
                    {
                        <MudSelectItem T="TodoTaskStatus?" Value="@status">@status</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="SearchText" Label="Поиск" Immediate="true" 
                             Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
            </MudItem>
        </MudGrid>
    }

    @if (ShowViewToggle)
    {
        <div class="d-flex justify-end mb-3">
            <MudButtonGroup>
                <MudButton Variant="Variant.Filled" 
                          Color="@(ViewMode == "list" ? Color.Primary : Color.Default)"
                          OnClick="@(() => ViewMode = "list")"
                          StartIcon="@Icons.Material.Filled.List">
                    Список
                </MudButton>
                <MudButton Variant="Variant.Filled" 
                          Color="@(ViewMode == "grid" ? Color.Primary : Color.Default)"
                          OnClick="@(() => ViewMode = "grid")"
                          StartIcon="@Icons.Material.Filled.ViewModule">
                    Сетка
                </MudButton>
            </MudButtonGroup>
        </div>
    }

    @if (ShowCounter)
    {
        <MudText Typo="Typo.body2" Color="Color.Tertiary" Class="mb-3">
            Найдено задач: @FilteredTasks.Count
        </MudText>
    }

    @if (FilteredTasks.Any())
    {
        @if (ViewMode == "list")
        {
            <MudList T="TaskItem">
                @foreach (var task in FilteredTasks)
                {
                    <MudListItem T="TaskItem">
                        <TaskCard TaskItem="task" 
                                 ShowFavoriteAction="ShowFavoriteAction"
                                 ShowEditAction="ShowEditAction"
                                 ShowDeleteAction="ShowDeleteAction"
                                 ShowCompleteAction="ShowCompleteAction"
                                 ShowPostponeAction="ShowPostponeAction"
                                 ShowConfirmAction="ShowConfirmAction"
                                 OnTaskDeleted="StateHasChanged" />
                    </MudListItem>
                }
            </MudList>
        }
        else
        {
            <MudGrid>
                @foreach (var task in FilteredTasks)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <TaskCard TaskItem="task" 
                                  ShowFavoriteAction="ShowFavoriteAction"
                                  ShowEditAction="ShowEditAction"
                                  ShowDeleteAction="ShowDeleteAction"
                                  ShowCompleteAction="ShowCompleteAction"
                                  ShowPostponeAction="ShowPostponeAction"
                                  ShowConfirmAction="ShowConfirmAction"
                                  OnTaskDeleted="@StateHasChanged" />
                    </MudItem>
                }
            </MudGrid>
        }
    }
    else
    {
        <MudText Typo="Typo.h6" Color="Color.Tertiary" Class="text-center my-8">
            @EmptyMessage
        </MudText>
    }
</MudPaper>

@code {
    [Parameter] public string Title { get; set; } = "Задачи";
    [Parameter] public List<TaskItem> Tasks { get; set; } = new();
    [Parameter] public bool ShowFilters { get; set; } = true;
    [Parameter] public bool ShowViewToggle { get; set; } = true;
    [Parameter] public bool ShowCounter { get; set; } = true;
    [Parameter] public bool ShowFavoriteAction { get; set; } = true;
    [Parameter] public bool ShowEditAction { get; set; } = true;
    [Parameter] public bool ShowDeleteAction { get; set; } = true;
    [Parameter] public bool ShowCompleteAction { get; set; }
    [Parameter] public bool ShowPostponeAction { get; set; }
    [Parameter] public bool ShowConfirmAction { get; set; }
    [Parameter] public string DefaultViewMode { get; set; } = "list";
    [Parameter] public TodoTaskStatus? DefaultStatusFilter { get; set; }
    [Parameter] public string EmptyMessage { get; set; } = "Задачи не найдены";

    private string _viewMode = "list";
    private string ViewMode
    {
        get => _viewMode;
        set
        {
            if (_viewMode != value)
            {
                _viewMode = value;
                StateHasChanged();
            }
        }
    }

    private TodoTaskStatus? _statusFilter;
    private TodoTaskStatus? StatusFilter
    {
        get => _statusFilter;
        set
        {
            if (_statusFilter != value)
            {
                _statusFilter = value;
                StateHasChanged();
            }
        }
    }

    private string _searchText = "";
    private string SearchText
    {
        get => _searchText;
        set
        {
            if (_searchText != value)
            {
                _searchText = value;
                StateHasChanged();
            }
        }
    }
    
    protected override void OnInitialized()
    {
        _viewMode = DefaultViewMode;
        _statusFilter = DefaultStatusFilter;
    }

    private List<TaskItem> FilteredTasks => Tasks
        .Where(t => StatusFilter == null || t.Status == StatusFilter)
        .Where(t => string.IsNullOrWhiteSpace(SearchText) || 
                   t.Title.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ||
                   (t.Description?.Contains(SearchText, StringComparison.OrdinalIgnoreCase) == true))
        .ToList();
}