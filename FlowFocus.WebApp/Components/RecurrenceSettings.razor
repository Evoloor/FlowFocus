<MudPaper Class="pa-3" Elevation="0" Outlined>
    <MudText Typo="Typo.subtitle2" Class="mb-3">Настройки повторения</MudText>
    
    <MudItem xs="12" Class="mb-3">
        <MudSelect T="RecurrenceType" @bind-Value="RecurrencePattern.Type" 
                  Label="Тип повторения"
                  Variant="Variant.Outlined">
            <MudSelectItem T="RecurrenceType" Value="RecurrenceType.Daily">Ежедневно</MudSelectItem>
            <MudSelectItem T="RecurrenceType" Value="RecurrenceType.Weekly">Еженедельно</MudSelectItem>
            <MudSelectItem T="RecurrenceType" Value="RecurrenceType.Monthly">Ежемесячно</MudSelectItem>
        </MudSelect>
    </MudItem>

    @switch (RecurrencePattern.Type)
    {
        case RecurrenceType.Daily:
            <MudItem xs="12">
                <MudNumericField T="int" @bind-Value="RecurrencePattern.Interval" 
                                 Label="Интервал (дни)" 
                                 Min="1" 
                                 Max="30"
                                 Variant="Variant.Outlined" />
            </MudItem>
            break;
        case RecurrenceType.Weekly:
            <MudItem xs="12">
                <MudNumericField T="int" @bind-Value="RecurrencePattern.Interval" 
                                 Label="Интервал (недели)" 
                                 Min="1" 
                                 Max="12"
                                 Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12">
                <MudText Typo="Typo.body2" Class="mb-2">Дни недели:</MudText>
                <div class="d-flex gap-1">
                    @foreach (var day in Enum.GetValues<DayOfWeek>())
                    {
                        <MudButton Variant="@(IsDaySelected(day) ? Variant.Filled : Variant.Outlined)"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   OnClick="@(() => ToggleDay(day))">
                            @GetDayName(day)
                        </MudButton>
                    }
                </div>
            </MudItem>
            break;
        case RecurrenceType.Monthly:
            <MudItem xs="12">
                <MudText Typo="Typo.body2" Class="mb-2">Выберите даты месяца:</MudText>
                <MudDatePicker @bind-Date="_tempDate"
                               PickerVariant="PickerVariant.Inline"
                               Label="Даты повторения" />
            </MudItem>
            break;
        case RecurrenceType.Yearly:
            // TODO: Yearly
            break;
        default:
            throw new ArgumentOutOfRangeException();
    }
</MudPaper>

@code {
    [Parameter]
    public RecurrencePattern RecurrencePattern { get; set; } = new() {Type = RecurrenceType.Daily};
    
    [Parameter]
    public EventCallback<RecurrencePattern> RecurrencePatternChanged { get; set; }

    private DateTime? _tempDate;

    private bool IsDaySelected(DayOfWeek day)
    {
        return RecurrencePattern.DaysOfWeek?.Contains(day) == true;
    }

    private void ToggleDay(DayOfWeek day)
    {
        RecurrencePattern.DaysOfWeek ??= [];
        
        if (IsDaySelected(day))
            RecurrencePattern.DaysOfWeek.Remove(day);
        else
            RecurrencePattern.DaysOfWeek.Add(day);
            
        RecurrencePatternChanged.InvokeAsync(RecurrencePattern);
    }

    private string GetDayName(DayOfWeek day)
    {
        return day switch
        {
            DayOfWeek.Monday => "Пн",
            DayOfWeek.Tuesday => "Вт", 
            DayOfWeek.Wednesday => "Ср",
            DayOfWeek.Thursday => "Чт",
            DayOfWeek.Friday => "Пт",
            DayOfWeek.Saturday => "Сб",
            DayOfWeek.Sunday => "Вс",
            _ => ""
        };
    }
}