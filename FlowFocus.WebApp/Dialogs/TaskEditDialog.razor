@using FlowFocus.WebApp.Components
@inject ITaskRepository TaskRepo
@inject IPlannerService PlannerService
@inject ISettingsRepository SettingsRepo
@inject ISnackbar Snackbar

<MudDialog MaxWidth="MaxWidth.Medium" FullWidth="true">
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsEdit ? "Редактировать задачу" : "Новая задача")</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <!-- Название -->
            <MudItem xs="12">
                <MudTextField T="string" @bind-Value="Task.Title"
                              Label="Название"
                              Required="true"
                              Variant="Variant.Outlined"/>
            </MudItem>

            <!-- Дата -->
            <MudItem xs="12" sm="6">
                <MudDatePicker T="DateTime?" @bind-Date="Task.PlannedDate"
                               Label="Дата выполнения"
                               Variant="Variant.Outlined"/>
            </MudItem>

            <!-- Дедлайн -->
            <MudItem xs="12" sm="6">
                <MudDatePicker T="DateTime?" @bind-Date="Task.Deadline"
                               Label="Срок выполнения"
                               Variant="Variant.Outlined"/>
            </MudItem>

            <!-- Приоритет -->
            <MudItem xs="12" sm="6">
                <!-- Слайдер -->
                <MudSlider T="int" @bind-Value="Task.UserPriority"
                           Min="0" Max="35"
                           Step="1"
                           Immediate="true"
                           Label="Приоритет"
                           ValueLabel="true"
                           ValueLabelFormat="{0}" />
    
                <!-- Референсные точки Фибоначчи -->
                <div class="d-flex justify-space-between mt-1 px-2">
                    @foreach (var fib in new[] { 0, 1, 3, 5, 8, 13, 21, 34 })
                    {
                        <MudText Typo="Typo.caption" 
                                 Color="Task.UserPriority == fib ? Color.Primary : Color.Secondary"
                                 Style="cursor: pointer;"
                                 OnClick="@(() => Task.UserPriority = fib)">
                            @fib
                        </MudText>
                    }
                </div>
            </MudItem>

            <MudItem xs="12" sm="6">
                <!-- Числовое поле -->
                <MudNumericField T="int" @bind-Value="Task.UserPriority"
                                 Min="0" Max="35"
                                 Label="Приоритет"
                                 Variant="Variant.Outlined"
                                 Immediate="true"
                                 HelperText="@GetPriorityDisplayText(Task.UserPriority)" />
            </MudItem>

            <!-- Интересность -->
            <MudItem xs="12" sm="4">
                <MudNumericField T="int" @bind-Value="Task.Interest"
                                 Label="Интересность"
                                 Min="1"
                                 Max="10"
                                 Variant="Variant.Outlined"/>
            </MudItem>

            <!-- Сложность -->
            <MudItem xs="12" sm="4">
                <MudNumericField T="int" @bind-Value="Task.Complexity"
                                 Label="Сложность"
                                 Min="1"
                                 Max="100"
                                 Variant="Variant.Outlined"/>
            </MudItem>

            <!-- Время выполнения -->
            <MudItem xs="12">
                <MudNumericField T="double" @bind-Value="Task.EstimatedHours"
                                 Label="Время выполнения (часы)"
                                 Min="0.5"
                                 Max="24"
                                 Step="0.5"
                                 Variant="Variant.Outlined"/>
            </MudItem>

            <!-- Описание -->
            <MudItem xs="12">
                <MudTextField T="string" @bind-Value="Task.Description"
                              Label="Описание"
                              Lines="3"
                              Variant="Variant.Outlined"/>
            </MudItem>

            <!-- Связи с другими задачами -->
            @if (IsEdit)
            {
                <MudItem xs="12">
                    <TaskRelationsEditor Task="Task"/>
                </MudItem>
            }
            <MudItem xs="12">
                <MudSwitch T="bool" @bind-Checked="Task.IsRecurring" 
                           Color="Color.Info">
                    Повторяющаяся задача
                </MudSwitch>
            </MudItem>

            @if (Task.IsRecurring)
            {
                <MudItem xs="12">
                    <RecurrenceSettings @bind-RecurrencePattern="Task.Recurrence" />
                </MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text"
                   OnClick="Cancel"
                   Color="Color.Default">
            Отмена
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="SaveTask"
                   Disabled="@string.IsNullOrWhiteSpace(Task.Title)">
            @(IsEdit ? "Сохранить" : "Создать")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public TaskItem? ExistingTask { get; set; }
    public PriorityService PriorityService { get; set; } = PriorityService.Shared;

    private TaskItem Task { get; set; } = new();
    private bool IsEdit => ExistingTask != null;

    protected override void OnParametersSet()
    {
        if (ExistingTask != null)
        {
            // Create a copy to avoid direct mutation
            Task = new TaskItem
            {
                Id = ExistingTask.Id,
                Title = ExistingTask.Title,
                Description = ExistingTask.Description,
                UserPriority = ExistingTask.UserPriority,
                Status = ExistingTask.Status,
                Interest = ExistingTask.Interest,
                Complexity = ExistingTask.Complexity,
                EstimatedHours = ExistingTask.EstimatedHours,
                Deadline = ExistingTask.Deadline,
                DisplayType = ExistingTask.DisplayType,
                IsFavorite = ExistingTask.IsFavorite,
                IsRecurring = ExistingTask.IsRecurring,
                IsProcrastinationResistant = ExistingTask.IsProcrastinationResistant,
                ProcrastinationCount = ExistingTask.ProcrastinationCount,
                Tags = [..ExistingTask.Tags],
                CreatedDate = ExistingTask.CreatedDate
            };
        }
    }

    private async Task SaveTask()
    {
        try
        {
            if (IsEdit)
            {
                TaskRepo.Update(Task);
                Snackbar.Add("Задача обновлена", Severity.Success);
            }
            else
            {
                TaskRepo.Add(Task);
                Snackbar.Add("Задача создана", Severity.Success);

                var settings = SettingsRepo.GetUserSettings();
                if (settings.AutoRecalculateOnAdd)
                {
                    PlannerService.RecalculatePriorities();
                    Snackbar.Add("Приоритеты пересчитаны", Severity.Info);
                }
            }

            MudDialog.Close(DialogResult.Ok(Task));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка: {ex.Message}", Severity.Error);
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
    private string GetPriorityDisplayText(int priority)
    {
        // Если значение не установлено (создание новой задачи)
        if (priority == 0 && !IsEditingExistingTask) // Добавь флаг редактирования
            return "Не выбран";
    
        // Проверяем, является ли значение референсным
        var fibValues = new[] { 0, 1, 3, 5, 8, 13, 21, 34 };
        if (fibValues.Contains(priority))
        {
            // Преобразуем в enum и получаем название
            var priorityEnum = (Priority)priority;
            return PriorityService.Shared.GetName(priorityEnum);
        }
    
        // Для не-референсных значений показываем просто число
        return priority.ToString();
    }

    private bool IsEditingExistingTask => Task?.Id != 0; // или твоя логика определения
}