@using FlowFocus.WebApp.Components
@inject ITaskRepository TaskRepo
@inject IPlannerService PlannerService
@inject ISettingsRepository SettingsRepo
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsEdit ? "Редактировать задачу" : "Новая задача")</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <!-- Название -->
            <MudItem xs="12">
                <MudTextField T="string" @bind-Value="CurrentTask.Title"
                              Label="Название"
                              Required
                              Variant="Variant.Outlined"/>
            </MudItem>

            <!-- Дата -->
            <MudItem xs="12" sm="6">
                <MudDatePicker T="DateTime?" @bind-Date="CurrentTask.PlannedDate"
                               Label="Дата выполнения"
                               Variant="Variant.Outlined"/>
            </MudItem>

            <!-- Дедлайн -->
            <MudItem xs="12" sm="6">
                <MudDatePicker T="DateTime?" @bind-Date="CurrentTask.Deadline"
                               Label="Срок выполнения"
                               Variant="Variant.Outlined"/>
            </MudItem>

            <!-- Приоритет -->
            <MudItem xs="12" sm="6">
                <MudSelect T="Priority?"
                           MultiSelection="false"
                           Clearable
                           Value="@(PriorityServiceObj.HasReferenceValue(CurrentTask.UserPriority) ? (Priority)CurrentTask.UserPriority!.Value : null)"
                           SelectedValuesChanged="@(selected=>CurrentTask.UserPriority = (int?)selected?.FirstOrDefault())"
                           Label="Референс приоритета"
                           Variant="Variant.Outlined">
                    <MudSelectItem T="Priority?" Value="null">@string.Empty</MudSelectItem>
                    @foreach (var priority in Enum.GetValues<Priority>())
                    {
                        <MudSelectItem T="Priority?" Value="priority">
                            @PriorityServiceObj.GetName(priority)
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField T="int?" @bind-Value="CurrentTask.UserPriority"
                                 Min="PriorityServiceObj.MinPriority"
                                 Max="PriorityServiceObj.MaxPriority"
                                 Label="Приоритет"
                                 Variant="Variant.Outlined"
                                 Immediate
                                 Clearable/>
            </MudItem>

            <!-- Интересность -->
            <MudItem xs="12" sm="4">
                <MudNumericField T="int?" @bind-Value="CurrentTask.Interest"
                                 Label="Интересность"
                                 Min="1"
                                 Max="10"
                                 Variant="Variant.Outlined"/>
            </MudItem>

            <!-- Сложность -->
            <MudItem xs="12" sm="4">
                <MudNumericField T="int?" @bind-Value="CurrentTask.Complexity"
                                 Label="Сложность"
                                 Min="1"
                                 Max="100"
                                 Variant="Variant.Outlined"/>
            </MudItem>

            <!-- Время выполнения -->
            <MudItem xs="12">
                <MudNumericField T="double?" @bind-Value="CurrentTask.EstimatedHours"
                                 Label="Время выполнения (часы)"
                                 Min="0.5"
                                 Max="24"
                                 Step="0.5"
                                 Variant="Variant.Outlined"/>
            </MudItem>

            <!-- Описание -->
            <MudItem xs="12">
                <MudTextField T="string?" @bind-Value="CurrentTask.Description"
                              Label="Описание"
                              Lines="3"
                              Variant="Variant.Outlined"
                              Clearable/>
            </MudItem>

            <!-- Связи с другими задачами -->
            @if (IsEdit)
            {
                <MudItem xs="12">
                    <TaskRelationsEditor CurrentTask="CurrentTask"/>
                </MudItem>
            }
            <MudItem xs="12">
                <MudSwitch T="bool" @bind-Checked="CurrentTask.IsRecurring"
                           Color="Color.Info">
                    Повторяющаяся задача
                </MudSwitch>
            </MudItem>

            @if (CurrentTask.IsRecurring)
            {
                <MudItem xs="12">
                    <RecurrenceSettings @bind-RecurrencePattern="CurrentTask.Recurrence"/>
                </MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text"
                   OnClick="@Cancel"
                   Color="Color.Default">
            Отмена
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="@SaveTask"
                   Disabled="@string.IsNullOrWhiteSpace(CurrentTask.Title)">
            @(IsEdit ? "Сохранить" : "Создать")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public TaskItem? ExistingTask { get; set; }
    public PriorityService PriorityServiceObj { get; init; } = PriorityService.Shared;

    private TaskItem CurrentTask { get; set; } = new();
    private bool IsEdit => ExistingTask != null;

    protected override void OnParametersSet()
    {
        if (ExistingTask != null)
        {
            // Create a copy to avoid direct mutation
            CurrentTask = new(ExistingTask);
        }
    }

    private void SaveTask()
    {
        try
        {
            if (IsEdit)
            {
                TaskRepo.Update(CurrentTask);
                Snackbar.Add("Задача обновлена", Severity.Success);
            }
            else
            {
                TaskRepo.Add(CurrentTask);
                Snackbar.Add("Задача создана", Severity.Success);

                var settings = SettingsRepo.GetUserSettings();
                if (settings.AutoRecalculateOnAdd)
                {
                    PlannerService.RecalculatePriorities();
                    Snackbar.Add("Приоритеты пересчитаны", Severity.Info);
                }
            }

            MudDialog.Close(DialogResult.Ok(CurrentTask));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка: {ex.Message}; {ex.InnerException?.Message}", Severity.Error);
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

}