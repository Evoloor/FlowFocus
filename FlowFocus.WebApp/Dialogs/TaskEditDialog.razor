@using FlowFocus.Core
@using FlowFocus.Core.Enums
@using FlowFocus.Core.Models
@inject ITaskRepository TaskRepo
@inject ISettingsRepository SettingsRepo
@inject IPriorityRepository PriorityRepo
@inject ITagRepository TagRepo
@inject ITagSessionService TagSessionService
@inject IPlannerService PlannerService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsEdit ? "Редактировать задачу" : "Новая задача")</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_isFormValid">
            <MudGrid Spacing="2">
                @* === НАЗВАНИЕ === *@
                <MudItem xs="12">
                    <MudTextField T="string" @bind-Value="_task.Title"
                                  Label="Название *"
                                  Required="true"
                                  RequiredError="Название обязательно"
                                  Variant="Variant.Outlined"
                                  Immediate="true" />
                </MudItem>
                
                @if (!IsSubtaskMode)
                {
                    <MudItem xs="12" sm="6">
                        <MudCheckBox T="bool" @bind-Value="_task.HideUnderSpoiler"
                                     Label="Скрывать под спойлер" />
                    </MudItem>
                }

                @* === ДАТА НАЗНАЧЕНИЯ === *@
                @if (!IsSubtaskMode)
                {
                    <MudItem xs="12" sm="6">
                        <MudDatePicker T="DateTime?" @bind-Date="_task.UserAssignedDate"
                                       Label="Дата назначения"
                                       Placeholder="Автоматически"
                                       Variant="Variant.Outlined"
                                       Clearable="true" />
                    </MudItem>
                }

                @* === ИЗБРАННОЕ === *@
                <MudItem xs="12" sm="6">
                    <MudCheckBox T="bool" @bind-Value="_task.IsFavorite"
                                 Label="Избранное"
                                 Color="Color.Warning"
                                 CheckedIcon="@Icons.Material.Filled.Star"
                                 UncheckedIcon="@Icons.Material.Outlined.StarBorder" />
                </MudItem>

                @* === ПРИОРИТЕТ === *@
                @if (!IsSubtaskMode)
                {
                    <MudItem xs="12" sm="6">
                        <MudSelect T="int?" @bind-Value="_task.PriorityId"
                                   Label="Приоритет"
                                   Variant="Variant.Outlined"
                                   Clearable="true"
                                   AnchorOrigin="Origin.BottomCenter">
                            @foreach (var priority in _priorities)
                            {
                                <MudSelectItem T="int?" Value="priority.Id">
                                    <div class="priority-option">
                                        <div class="priority-color" style="background-color: @priority.Color"></div>
                                        <span>@priority.Name</span>
                                    </div>
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }

                @* === ИНТЕРЕСНОСТЬ === *@
                <MudItem xs="12" sm="4">
                    <MudNumericField T="int?" @bind-Value="_task.Interest"
                                     Label="Интересность"
                                     Min="1" Max="10"
                                     Variant="Variant.Outlined" />
                </MudItem>

                @* === СЛОЖНОСТЬ === *@
                <MudItem xs="12" sm="4">
                    <MudNumericField T="int?" @bind-Value="_task.Complexity"
                                     Label="Сложность"
                                     Min="1" Max="100"
                                     Variant="Variant.Outlined" />
                </MudItem>

                @* === ВРЕМЯ ВЫПОЛНЕНИЯ === *@
                <MudItem xs="12" sm="4">
                    <div class="d-flex gap-2">
                        <MudNumericField T="int?" @bind-Value="_estimatedValue"
                                         Label="Время"
                                         Min="1"
                                         Variant="Variant.Outlined"
                                         Class="flex-grow-1" />
                        <MudSelect T="TimeFormat" @bind-Value="_timeFormat"
                                   Label="Формат"
                                   Variant="Variant.Outlined"
                                   Style="width: 100px">
                            <MudSelectItem Value="TimeFormat.Minutes">мин</MudSelectItem>
                            <MudSelectItem Value="TimeFormat.Hours">ч</MudSelectItem>
                        </MudSelect>
                    </div>
                </MudItem>

                @* === ТЕГИ === *@
                @if (!IsSubtaskMode)
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Теги</MudText>
                        
                        @* Предлагаемые теги *@
                        <div class="suggested-tags mb-2">
                            @foreach (var tag in _suggestedTags.Where(t => !_selectedTagIds.Contains(t.Id)))
                            {
                                <MudChip T="string" Size="Size.Small"
                                         Icon="@Icons.Material.Filled.Add"
                                         Style="@($"background-color: {tag.BackgroundColor}; color: #333;")"
                                         OnClick="@(() => AddTag(tag))">
                                    @tag.Name
                                </MudChip>
                            }
                        </div>

                        @* Поле для нового тега *@
                        <MudAutocomplete T="string" @bind-Value="_newTagInput"
                                         Label="Добавить тег"
                                         SearchFunc="@SearchTags"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         CoerceText="false"
                                         CoerceValue="false"
                                         OnKeyDown="@OnTagKeyDown"
                                         Clearable="true" />

                        @* Добавленные теги *@
                        @if (_selectedTags.Any())
                        {
                            <MudText Typo="Typo.caption" Class="mt-2 mb-1">Добавленные:</MudText>
                            <div class="selected-tags">
                                @foreach (var tag in _selectedTags)
                                {
                                    <MudChip T="string" Size="Size.Small"
                                             Style="@($"background-color: {tag.BackgroundColor}; color: #333;")"
                                             OnClose="@(() => RemoveTag(tag))">
                                        @tag.Name
                                    </MudChip>
                                }
                            </div>
                        }
                    </MudItem>
                }

                @* === ТАБЛИЦА ПОВЫШЕНИЯ ПРИОРИТЕТА === *@
                @if (!IsSubtaskMode && ShouldShowEscalationTable)
                {
                    <MudItem xs="12">
                        <MudExpansionPanels>
                            <MudExpansionPanel Text="Повышение приоритета">
                                <MudText Typo="Typo.body2" Class="mb-2 text-muted">
                                    Настройте автоматическое повышение приоритета по датам
                                </MudText>

                                @foreach (var escalation in _escalations)
                                {
                                    <div class="escalation-row mb-2">
                                        <MudSelect T="int" @bind-Value="escalation.TargetPriorityId"
                                                   Label="Приоритет"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   Dense="true">
                                            @foreach (var p in GetAvailablePrioritiesForEscalation())
                                            {
                                                <MudSelectItem Value="p.Id">@p.Name</MudSelectItem>
                                            }
                                        </MudSelect>
                                        <MudDatePicker T="DateTime?" @bind-Date="escalation.EscalationDate"
                                                       Label="Дата"
                                                       Variant="Variant.Outlined"
                                                       Margin="Margin.Dense"
                                                       MinDate="@DateTime.Today.AddDays(1)" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Size="Size.Small"
                                                       Color="Color.Error"
                                                       OnClick="@(() => RemoveEscalation(escalation))" />
                                    </div>
                                }

                                @if (CanAddEscalation)
                                {
                                    <MudButton StartIcon="@Icons.Material.Filled.Add"
                                               Variant="Variant.Text"
                                               Color="Color.Primary"
                                               OnClick="@AddEscalation">
                                        Добавить правило повышения
                                    </MudButton>
                                }
                            </MudExpansionPanel>
                        </MudExpansionPanels>
                    </MudItem>
                }

                @* === РАСШИРЕННЫЕ НАСТРОЙКИ === *@
                @if (!IsSubtaskMode)
                {
                    <MudItem xs="12">
                        <MudExpansionPanels>
                            <MudExpansionPanel Text="Расширенные настройки">
                                @* Описание *@
                                <MudTextField T="string?" @bind-Value="_task.Description"
                                              Label="Описание"
                                              Lines="3"
                                              Variant="Variant.Outlined"
                                              Class="mb-4" />

                                @* Подзадачи *@
                                <MudText Typo="Typo.subtitle2" Class="mb-2">Подзадачи</MudText>
                                <div class="subtask-input mb-2">
                                    <MudTextField T="string" @bind-Value="_newSubtaskTitle"
                                                  Placeholder="Название подзадачи"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  OnKeyDown="@OnSubtaskKeyDown"
                                                  Class="flex-grow-1" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Add"
                                                   Color="Color.Primary"
                                                   OnClick="@AddSubtask"
                                                   Disabled="@string.IsNullOrWhiteSpace(_newSubtaskTitle)" />
                                </div>

                                @foreach (var subtask in _subtasks.Where(s => !s.IsDeleted))
                                {
                                    <MudPaper Class="subtask-card mb-2 pa-2" Elevation="0" Outlined="true">
                                        <div class="d-flex align-center gap-2">
                                            <MudText>@subtask.Title</MudText>
                                            <MudSpacer />
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                           Size="Size.Small"
                                                           OnClick="@(() => EditSubtask(subtask))" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                           Size="Size.Small"
                                                           Color="Color.Error"
                                                           OnClick="@(() => subtask.IsDeleted = true)" />
                                        </div>
                                    </MudPaper>
                                }

                                @* Связи с задачами *@
                                <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">Связи с задачами</MudText>

                                @foreach (var relation in _relations)
                                {
                                    <div class="relation-row mb-2">
                                        <MudSelect T="RelationType" @bind-Value="relation.Type"
                                                   Label="Тип"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   Dense="true"
                                                   Style="width: 150px">
                                            <MudSelectItem Value="RelationType.RelatedTo">Связана с</MudSelectItem>
                                            <MudSelectItem Value="RelationType.Blocks">Блокирует</MudSelectItem>
                                            <MudSelectItem Value="RelationType.BlockedBy">Блокирована</MudSelectItem>
                                        </MudSelect>
                                        <MudAutocomplete T="TaskItem" @bind-Value="relation.TargetTask"
                                                         Label="Задача"
                                                         SearchFunc="@SearchTasks"
                                                         ToStringFunc="@(t => t?.Title ?? string.Empty)"
                                                         Variant="Variant.Outlined"
                                                         Margin="Margin.Dense"
                                                         Dense="true"
                                                         Class="flex-grow-1" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Size="Size.Small"
                                                       Color="Color.Error"
                                                       OnClick="@(() => _relations.Remove(relation))" />
                                    </div>
                                }

                                @if (_relations.Count < AppConfig.MaxTaskRelations)
                                {
                                    <MudButton StartIcon="@Icons.Material.Filled.Add"
                                               Variant="Variant.Text"
                                               Size="Size.Small"
                                               OnClick="@AddRelation">
                                        Добавить связь (@(_relations.Count)/@AppConfig.MaxTaskRelations)
                                    </MudButton>
                                }
                                else
                                {
                                    <MudAlert Severity="Severity.Info" Dense="true">
                                        Достигнут лимит связей (@AppConfig.MaxTaskRelations)
                                    </MudAlert>
                                }

                                @* Повторение *@
                                <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">Повторение</MudText>
                                <MudCheckBox T="bool" @bind-Value="_task.IsRecurring"
                                             Label="Повторяющаяся задача" />

                                @if (_task.IsRecurring)
                                {
                                    <div class="recurrence-options mt-2">
                                        <MudRadioGroup T="RecurrenceType" @bind-Value="_task.RecurrenceType">
                                            <MudRadio Value="RecurrenceType.Daily" Color="Color.Primary">
                                                Ежедневно
                                            </MudRadio>
                                            <MudRadio Value="RecurrenceType.EveryNDays" Color="Color.Primary">
                                                <div class="d-flex align-center gap-2">
                                                    <span>Каждые</span>
                                                    <MudNumericField T="int?" @bind-Value="_task.RecurrenceInterval"
                                                                     Min="2" Max="365"
                                                                     Variant="Variant.Outlined"
                                                                     Margin="Margin.Dense"
                                                                     Style="width: 80px"
                                                                     Disabled="@(_task.RecurrenceType != RecurrenceType.EveryNDays)" />
                                                    <span>дней</span>
                                                </div>
                                            </MudRadio>
                                            <MudRadio Value="RecurrenceType.WeekDays" Color="Color.Primary">
                                                По дням недели
                                            </MudRadio>
                                        </MudRadioGroup>

                                        @if (_task.RecurrenceType == RecurrenceType.WeekDays)
                                        {
                                            <div class="weekday-select mt-2">
                                                @foreach (var day in _weekDays)
                                                {
                                                    <MudCheckBox T="bool"
                                                                 Value="@IsWeekDaySelected(day.Value)"
                                                                 ValueChanged="@(v => ToggleWeekDay(day.Value, v))"
                                                                 Label="@day.Name"
                                                                 Dense="true" />
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </MudExpansionPanel>
                        </MudExpansionPanels>
                    </MudItem>
                }
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@Cancel" Color="Color.Default">
            Отмена
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="@SaveTask"
                   Disabled="@(!_isFormValid)">
            @(IsEdit ? "Сохранить" : "Создать")
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
    .priority-option {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .priority-color {
        width: 16px;
        height: 16px;
        border-radius: 4px;
    }

    .suggested-tags,
    .selected-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
    }

    .escalation-row,
    .relation-row {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .subtask-input {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .weekday-select {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }
</style>

@code {
    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public TaskItem? ExistingTask { get; set; }

    [Parameter]
    public string? InitialTitle { get; set; }

    [Parameter]
    public bool IsSubtaskMode { get; set; }

    private MudForm _form = null!;
    private bool _isFormValid;
    private TaskItem _task = new();
    private List<PriorityLevel> _priorities = new();
    private List<Tag> _suggestedTags = new();
    private List<Tag> _selectedTags = new();
    private HashSet<int> _selectedTagIds = new();
    private string _newTagInput = string.Empty;
    private List<SubtaskDto> _subtasks = new();
    private string _newSubtaskTitle = string.Empty;
    private List<RelationDto> _relations = new();
    private List<EscalationDto> _escalations = new();
    private List<TaskItem> _availableTasks = new();
    private UserSettings? _settings;

    private int? _estimatedValue;
    private TimeFormat _timeFormat = TimeFormat.Minutes;

    private bool IsEdit => ExistingTask != null;

    private static readonly (string Name, int Value)[] _weekDays = new[]
    {
        ("Пн", 1), ("Вт", 2), ("Ср", 4), ("Чт", 8), ("Пт", 16), ("Сб", 32), ("Вс", 64)
    };

    protected override void OnInitialized()
    {
        _settings = SettingsRepo.GetUserSettings();
        _priorities = PriorityRepo.GetAllOrdered();
        _suggestedTags = TagSessionService.GetSuggestedTags(5);
        _availableTasks = TaskRepo.GetTasksForAutocomplete();

        if (ExistingTask != null)
        {
            _task = new TaskItem(ExistingTask);
            LoadExistingTaskData();
        }
        else
        {
            _task = new TaskItem
            {
                Title = InitialTitle ?? string.Empty,
                Status = TaskStatus.Planned,
                CreatedDate = DateTime.UtcNow
            };
        }

        // Конвертируем время
        if (_task.EstimatedMinutes != null)
        {
            if (_task.EstimatedMinutes >= 60 && _task.EstimatedMinutes % 60 == 0)
            {
                _estimatedValue = _task.EstimatedMinutes / 60;
                _timeFormat = TimeFormat.Hours;
            }
            else
            {
                _estimatedValue = _task.EstimatedMinutes;
                _timeFormat = TimeFormat.Minutes;
            }
        }
    }

    private void LoadExistingTaskData()
    {
        // Загружаем теги
        _selectedTags = _task.Tags.Select(tt => tt.Tag).ToList();
        _selectedTagIds = _selectedTags.Select(t => t.Id).ToHashSet();

        // Загружаем подзадачи
        _subtasks = _task.Subtasks.Select(s => new SubtaskDto
        {
            Id = s.Id,
            Title = s.Title,
            IsFavorite = s.IsFavorite,
            Interest = s.Interest,
            Complexity = s.Complexity,
            EstimatedMinutes = s.EstimatedMinutes
        }).ToList();

        // Загружаем связи
        _relations = _task.Relations.Select(r => new RelationDto
        {
            Id = r.Id,
            Type = r.Type,
            TargetTask = r.TargetTask
        }).ToList();

        // Загружаем повышения приоритета
        _escalations = _task.PriorityEscalations
            .Where(e => !e.IsApplied)
            .Select(e => new EscalationDto
            {
                Id = e.Id,
                TargetPriorityId = e.TargetPriorityId,
                EscalationDate = e.EscalationDate
            }).ToList();
    }

    private bool ShouldShowEscalationTable
    {
        get
        {
            var highestPriority = _priorities.FirstOrDefault();
            if (highestPriority == null) return false;

            // Не показываем, если уже установлен максимальный приоритет
            return _task.PriorityId == null || _task.PriorityId != highestPriority.Id;
        }
    }

    private bool CanAddEscalation
    {
        get
        {
            var available = GetAvailablePrioritiesForEscalation();
            return available.Any(p => !_escalations.Any(e => e.TargetPriorityId == p.Id));
        }
    }

    private List<PriorityLevel> GetAvailablePrioritiesForEscalation()
    {
        if (_task.PriorityId == null)
        {
            return _priorities;
        }

        return _priorities.Where(p => p.Id != _task.PriorityId &&
                                      p.Order < (_priorities.FirstOrDefault(pp => pp.Id == _task.PriorityId)?.Order ?? 0))
                          .ToList();
    }

    private async Task<IEnumerable<string>> SearchTags(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Enumerable.Empty<string>();

        var tags = TagRepo.SearchByName(value, 10);
        return tags.Select(t => t.Name);
    }

    private async Task<IEnumerable<TaskItem>> SearchTasks(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value))
            return _availableTasks.Take(10);

        return _availableTasks
            .Where(t => t.Title.Contains(value, StringComparison.OrdinalIgnoreCase))
            .Where(t => t.Id != _task.Id) // Исключаем текущую задачу
            .Take(10);
    }

    private void AddTag(Tag tag)
    {
        if (_selectedTagIds.Contains(tag.Id)) return;

        _selectedTags.Add(tag);
        _selectedTagIds.Add(tag.Id);
        TagSessionService.MarkTagUsed(tag);
    }

    private void RemoveTag(Tag tag)
    {
        _selectedTags.Remove(tag);
        _selectedTagIds.Remove(tag.Id);
    }

    private void OnTagKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_newTagInput))
        {
            var tag = TagRepo.GetOrCreate(_newTagInput.Trim());
            AddTag(tag);
            _newTagInput = string.Empty;
        }
    }

    private void AddSubtask()
    {
        if (string.IsNullOrWhiteSpace(_newSubtaskTitle)) return;

        _subtasks.Add(new SubtaskDto { Title = _newSubtaskTitle.Trim() });
        _newSubtaskTitle = string.Empty;
    }

    private void OnSubtaskKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddSubtask();
        }
    }

    private async Task EditSubtask(SubtaskDto subtask)
    {
        var parameters = new DialogParameters<TaskEditDialog>
        {
            { x => x.IsSubtaskMode, true },
            { x => x.InitialTitle, subtask.Title }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<TaskEditDialog>("Редактировать подзадачу", parameters, options);
        // Simplified - in real impl would update subtask
    }

    private void AddRelation()
    {
        if (_relations.Count >= AppConfig.MaxTaskRelations) return;
        _relations.Add(new RelationDto { Type = RelationType.RelatedTo });
    }

    private void AddEscalation()
    {
        var available = GetAvailablePrioritiesForEscalation()
            .Where(p => !_escalations.Any(e => e.TargetPriorityId == p.Id))
            .FirstOrDefault();

        if (available == null) return;

        _escalations.Add(new EscalationDto
        {
            TargetPriorityId = available.Id,
            EscalationDate = DateTime.Today.AddDays(7)
        });
    }

    private void RemoveEscalation(EscalationDto escalation)
    {
        _escalations.Remove(escalation);
    }

    private bool IsWeekDaySelected(int dayValue)
    {
        return (_task.RecurrenceWeekDays ?? 0 & dayValue) != 0;
    }

    private void ToggleWeekDay(int dayValue, bool selected)
    {
        _task.RecurrenceWeekDays ??= 0;
        if (selected)
            _task.RecurrenceWeekDays |= dayValue;
        else
            _task.RecurrenceWeekDays &= ~dayValue;
    }

    private void SaveTask()
    {
        try
        {
            // Конвертируем время
            _task.EstimatedMinutes = _timeFormat switch
            {
                TimeFormat.Hours => _estimatedValue * 60,
                _ => _estimatedValue
            };

            // Если фактическая дата не установлена, приравниваем к ручной
            if (_task.UserAssignedDate != null)
            {
                _task.ActualAssignedDate = _task.UserAssignedDate;
            }

            if (IsEdit)
            {
                TaskRepo.Update(_task);
                Snackbar.Add("Задача обновлена", Severity.Success);
            }
            else
            {
                TaskRepo.Add(_task);
                Snackbar.Add("Задача создана", Severity.Success);
            }

            // Авто-распределение
            if (_settings?.AutoDistributeEnabled == true)
            {
                PlannerService.RecalculateAll(_settings);
            }

            MudDialog.Close(DialogResult.Ok(_task));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка: {ex.Message}", Severity.Error);
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    // === DTO классы ===
    private class RelationDto
    {
        public int? Id { get; set; }
        public RelationType Type { get; set; }
        public TaskItem? TargetTask { get; set; }
    }

    private class EscalationDto
    {
        public int? Id { get; set; }
        public int TargetPriorityId { get; set; }
        public DateTime? EscalationDate { get; set; }
    }
}
