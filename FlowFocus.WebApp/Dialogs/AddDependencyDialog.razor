@inject ITaskRepository TaskRepo
@inject IDependencyRepository DependencyRepo
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Добавить зависимость</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudSelect T="TaskItem" @bind-Value="_selectedTask" 
                          Label="Выберите задачу"
                          Variant="Variant.Outlined"
                          ToStringFunc="(task) => task?.Title ?? string.Empty"
                          SearchFunc="SearchTasks"
                          Clearable="true">
                    @if (_availableTasks != null)
                    {
                        @foreach (var task in _availableTasks)
                        {
                            <MudSelectItem T="TaskItem" Value="task">@task.Title</MudSelectItem>
                        }
                    }
                </MudSelect>
            </MudItem>
            
            <MudItem xs="12">
                <MudSelect T="DependencyType" @bind-Value="_dependencyType" 
                          Label="Тип зависимости"
                          Variant="Variant.Outlined">
                    <MudSelectItem T="DependencyType" Value="DependencyType.Blocking">Блокирующая</MudSelectItem>
                    <MudSelectItem T="DependencyType" Value="DependencyType.Related">Связанная</MudSelectItem>
                </MudSelect>
            </MudItem>
            
            <MudItem xs="12">
                <MudSelect T="DependencyLogic" @bind-Value="_dependencyLogic" 
                          Label="Логика выполнения"
                          Variant="Variant.Outlined">
                    <MudSelectItem T="DependencyLogic" Value="DependencyLogic.And">AND (И)</MudSelectItem>
                    <MudSelectItem T="DependencyLogic" Value="DependencyLogic.Or">OR (ИЛИ)</MudSelectItem>
                </MudSelect>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" 
                  OnClick="Cancel"
                  Color="Color.Default">
            Отмена
        </MudButton>
        <MudButton Variant="Variant.Filled" 
                  Color="Color.Primary" 
                  OnClick="AddDependency"
                  Disabled="@(_selectedTask == null)">
            Добавить
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public TaskItem SourceTask { get; set; } = null!;

    private List<TaskItem> _availableTasks = [];
    private TaskItem? _selectedTask;
    private DependencyType _dependencyType = DependencyType.Blocking;
    private DependencyLogic _dependencyLogic = DependencyLogic.And;

    protected override void OnInitialized()
    {
        // Load all tasks except the current one
        var allTasks = TaskRepo.GetAll();
        _availableTasks = allTasks.Where(t => t.Id != SourceTask.Id).ToList();
    }

    private async Task<IEnumerable<TaskItem>> SearchTasks(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return _availableTasks;

        return await Task.Run(() => 
            _availableTasks.Where(t => 
                t.Title.Contains(value, StringComparison.OrdinalIgnoreCase) ||
                t.Description?.Contains(value, StringComparison.OrdinalIgnoreCase) == true
            ).ToList()
        );
    }

    private void AddDependency()
    {
        if (_selectedTask == null)
            return;

        try
        {
            // Check for circular dependency
            if (DependencyRepo.HasCircularDependency(SourceTask.Id, _selectedTask.Id))
            {
                Snackbar.Add("Обнаружена циклическая зависимость!", Severity.Error);
                return;
            }

            var dependency = new Dependency
            {
                SourceTaskId = SourceTask.Id,
                TargetTaskId = _selectedTask.Id,
                Type = _dependencyType,
                Logic = _dependencyLogic
            };

            DependencyRepo.Add(dependency);
            Snackbar.Add("Зависимость добавлена", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка: {ex.Message}", Severity.Error);
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}