<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudText>@Content</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" 
                   OnClick="Cancel"
                   Color="Color.Default">
            @CancelText
        </MudButton>
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Error" 
                   OnClick="OnConfirm">
            @ConfirmText
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    
    [Parameter] public string Title { get; set; } = "Подтверждение";
    [Parameter] public string Content { get; set; } = "Вы уверены?";
    [Parameter] public string ConfirmText { get; set; } = "Подтвердить";
    [Parameter] public string CancelText { get; set; } = "Отмена";

    private void OnConfirm() => MudDialog.Close(DialogResult.Ok(true));
    private void Cancel() => MudDialog.Cancel();
}