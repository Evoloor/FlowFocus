@using FlowFocus.Core
@using FlowFocus.Core.Enums
@using FlowFocus.Core.Models
@using FlowFocus.Core.Services
@using FlowFocus.WebApp.Components
@inject ITaskRepository TaskRepo
@inject ISettingsRepository SettingsRepo
@inject INotificationService NotificationService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Shuffle" Class="me-2" />
            <MudText Typo="Typo.h6">Прокрастинация</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_currentTask == null)
        {
            <MudAlert Severity="Severity.Info">
                Нет подходящих задач с интересностью > @AppConfig.MinProcrastinationInterest
            </MudAlert>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-3 text-muted">
                Вот интересная задача для вас:
            </MudText>

            <TaskCard Task="_currentTask" DisplayMode="DisplayMode.List" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@Cancel">
            Закрыть
        </MudButton>

        @if (_currentTask != null)
        {
            <MudButton Variant="Variant.Text"
                       Color="Color.Secondary"
                       OnClick="@GetAnotherTask">
                Другая задача
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="@AddToTodayPlans">
                Взять в сегодняшние планы
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = null!;

    private TaskItem? _currentTask;
    private List<int> _excludedTaskIds = new();
    private UserSettings? _settings;

    protected override void OnInitialized()
    {
        _settings = SettingsRepo.GetUserSettings();
        LoadNextTask();
    }

    private void LoadNextTask()
    {
        _currentTask = TaskRepo.GetProcrastinationTask(_excludedTaskIds);
    }

    private void GetAnotherTask()
    {
        if (_currentTask != null)
        {
            _excludedTaskIds.Add(_currentTask.Id);
        }
        LoadNextTask();
    }

    private async Task AddToTodayPlans()
    {
        if (_currentTask == null || _settings == null) return;

        // Проверяем свободное место
        var todayTasks = TaskRepo.GetTodayTasks(_settings.DayStartHour);
        var todayCount = todayTasks.Count;
        var todayComplexity = todayTasks.Sum(t => t.TotalComplexity);
        var todayTime = todayTasks.Sum(t => t.TotalEstimatedMinutes);

        var hasSpace = todayCount < _settings.DailyTaskLimit &&
                       todayComplexity + (_currentTask.TotalComplexity) <= _settings.DailyComplexityLimit &&
                       todayTime + (_currentTask.TotalEstimatedMinutes) <= _settings.DailyTimeLimit;

        if (!hasSpace)
        {
            // Предлагаем вытеснить наименее приоритетную задачу
            var leastPriorityTask = TaskRepo.GetLeastPriorityTaskOfDay(_settings.DayStartHour);

            if (leastPriorityTask != null)
            {
                var result = await DialogService.ShowMessageBox(
                    "Нет свободного места",
                    (MarkupString)$"Вытеснить наименее приоритетное дело дня?<br/><br/><strong>{leastPriorityTask.Title}</strong>",
                    yesText: "Вытеснить",
                    cancelText: "Добавить сверх лимита");

                if (result == true)
                {
                    // Вытесняем задачу
                    leastPriorityTask.ActualAssignedDate = null;
                    TaskRepo.Update(leastPriorityTask);
                }
            }
        }

        // Добавляем задачу на сегодня
        _currentTask.ActualAssignedDate = DateHelper.GetLogicalToday(_settings.DayStartHour);
        _currentTask.UserAssignedDate = _currentTask.ActualAssignedDate;
        _currentTask.Status = TaskStatus.Planned;
        TaskRepo.Update(_currentTask);

        NotificationService.NotifyTasksChanged();
        Snackbar.Add("Задача добавлена в сегодняшние планы", Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}

