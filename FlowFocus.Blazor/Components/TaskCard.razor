<MudPaper Class="@GetCardClass()" Style="@GetCardStyle()" Elevation="@(IsNested ? 0 : 1)">
    @if (Task.Status == TaskStatus.Irrelevant && !IsNested)
    {
        <div class="irrelevant-overlay">НЕАКТУАЛЬНО</div>
    }

    <div class="task-card-content">
        <div class="priority-indicator" style="@GetPriorityIndicatorStyle()"></div>

        <div class="task-card-main">
            <TaskCardHeader Task="Task"
                            ShouldHideUnderSpoiler="ShouldHideUnderSpoiler"
                            SpoilerRevealed="_spoilerRevealed"
                            OnToggleSpoiler="ToggleSpoiler"
                            OnTaskCompleted="OnTaskCompleted"
                            OnToggleFavorite="ToggleFavorite" />

            <TaskDateRow Task="Task" Today="@TodoDay.Today" />

            <TaskDescription Task="Task"
                             DisplayMode="DisplayMode"
                             ShouldHideUnderSpoiler="ShouldHideUnderSpoiler"
                             SpoilerRevealed="_spoilerRevealed" />

            <TaskMetrics Task="Task" DisplayMode="DisplayMode" />

            <TaskRecurrenceRow Task="Task" DisplayMode="DisplayMode" />

            <TaskTags Task="Task" DisplayMode="DisplayMode" />

            <TaskRelationsPanel Task="Task" IsNested="IsNested" OnTaskChanged="OnTaskChanged" />

            <TaskActions Task="Task"
                         IsNested="IsNested"
                         OnEdit="OpenEditDialog"
                         OnRestoreFromIrrelevant="RestoreFromIrrelevant"
                         OnMarkIrrelevant="MarkIrrelevant"
                         OnDelete="DeleteTask" />
        </div>
    </div>
</MudPaper>

<style>
    .task-card {
        margin-bottom: 8px;
        overflow: hidden;
        transition: all 0.2s ease;
        position: relative;
        z-index: 0;
    }

    .task-card:hover {
        transform: translateY(-1px);
    }

    .task-card-content {
        display: flex;
        position: relative;
    }

    .priority-indicator {
        width: 4px;
        min-height: 100%;
        flex-shrink: 0;
    }

    .task-card-main {
        flex: 1;
        padding: 12px;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .task-card-header {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .task-status-control {
        flex-shrink: 0;
        display: flex;
        align-items: center;
    }

    .task-title-container {
        display: flex;
        align-items: center;
    }

    .task-date-row {
        display: flex;
        align-items: center;
    }

    .task-description {
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .task-settings-row,
    .task-tags-row {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
    }

    .task-recurrence-row {
        display: flex;
        align-items: center;
    }

    .task-relations-panel {
        margin-top: 8px;
    }

    .relations-group {
        margin-bottom: 4px;
    }

    .task-actions {
        display: flex;
        justify-content: flex-end;
        gap: 4px;
        margin-top: 8px;
        padding-top: 8px;
        border-top: 1px solid var(--mud-palette-lines-default);
    }

    .task-card-completed {
        opacity: 0.55;
        background: linear-gradient(135deg, rgba(76, 175, 80, 0.05) 0%, transparent 100%);
    }

    .task-card-completed::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: repeating-linear-gradient(
            -45deg,
            transparent,
            transparent 10px,
            rgba(76, 175, 80, 0.03) 10px,
            rgba(76, 175, 80, 0.03) 20px
        );
        pointer-events: none;
    }

    .task-card-irrelevant {
        opacity: 0.35;
        filter: grayscale(70%);
        position: relative;
        background: linear-gradient(135deg, rgba(158, 158, 158, 0.1) 0%, transparent 100%);
    }

    .task-card-irrelevant .irrelevant-overlay {
        position: absolute;
        top: 50%;
        left: 8px;
        transform: translateY(-50%) rotate(-90deg);
        transform-origin: left center;
        color: rgba(158, 158, 158, 0.7);
        font-size: 10px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 2px;
        white-space: nowrap;
        pointer-events: none;
    }

    .task-card-not-configured {
        border: 2px dashed var(--mud-palette-info) !important;
        background: linear-gradient(135deg, rgba(33, 150, 243, 0.05) 0%, transparent 100%);
    }

    .task-card-not-configured .task-card-main {
        border-left: none;
    }

    .task-card-blocked {
        border-width: 3px !important;
        border-style: solid !important;
        position: relative;
        background: linear-gradient(135deg, rgba(255, 152, 0, 0.08) 0%, transparent 100%);
    }

    .task-card-blocked::before {
        content: '🔒';
        position: absolute;
        top: 4px;
        right: 4px;
        font-size: 12px;
        opacity: 0.7;
    }

    .title-completed {
        text-decoration: line-through;
        opacity: 0.8;
    }

    .title-not-configured {
        font-style: italic;
        color: var(--mud-palette-info);
    }

    .title-irrelevant {
        text-decoration: line-through;
        opacity: 0.6;
    }

    .task-card-nested {
        margin: 4px 0;
        padding: 4px;
        font-size: 0.88em;
        border-radius: 4px;
        border-left: 3px solid var(--mud-palette-lines-default);
        background: var(--mud-palette-background-gray);
    }

    .task-card-nested .task-card-main {
        padding: 6px 8px;
    }

    .task-card-nested .priority-indicator {
        width: 3px;
    }

    .vertical-text {
        writing-mode: vertical-rl;
        text-orientation: mixed;
        font-size: 9px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 1px;
        opacity: 0.6;
    }

    .spoiler-container {
        overflow: hidden;
        transition: max-height 0.3s ease-out, opacity 0.3s ease-out;
    }

    .spoiler-hidden {
        max-height: 0;
        opacity: 0;
    }

    .spoiler-revealed {
        max-height: 500px;
        opacity: 1;
    }

    .spoiler-button {
        text-transform: none !important;
        font-style: italic;
    }

    .spoiler-button:hover {
        background: rgba(var(--mud-palette-primary-rgb), 0.1);
    }

    .relations-group .mud-expansion-panel {
        background: transparent;
        margin-bottom: 4px;
    }

    .relations-group .mud-expansion-panel-header {
        padding: 4px 8px;
        min-height: 32px;
        font-size: 0.85em;
        background: rgba(var(--mud-palette-surface-rgb), 0.5);
        border-radius: 4px;
    }

    .relations-group .mud-expansion-panel-content {
        padding: 4px;
    }

    .task-card-compact {
        margin-bottom: 4px;
    }

    .task-card-compact .task-card-main {
        padding: 8px;
    }

    .task-card-compact .task-actions,
    .task-card-compact .task-description,
    .task-card-compact .task-settings-row,
    .task-card-compact .task-relations-panel {
        display: none !important;
    }

    .task-card-grid {
        height: 100%;
        min-height: 150px;
    }

    .task-card-grid .task-card-main {
        justify-content: space-between;
    }
</style>
