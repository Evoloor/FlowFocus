<MudCard Elevation="3" Class="chart-card glass-card">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6" Class="chart-title">Средняя активность по дням недели</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        @if (TotalSum == 0)
        {
            <DashboardEmptyState Message="Нет завершённых задач за выбранный период" />
        }
        else
        {
            <div class="weekday-bar-container">
                <DashboardHistogramChart Items="@Items" DefaultColor="#6366f1" Unit="вып. задач" />
            </div>
        }
    </MudCardContent>
</MudCard>

<style>
    .weekday-bar-container {
        width: 100%;
        min-height: 250px;
    }
</style>

@code {
    [Parameter]
    public Dictionary<DayOfWeek, double> Data { get; set; } = new();

    private double TotalSum => Data.Values.Sum();

    private static readonly (DayOfWeek Day, string Label)[] OrderedDays =
    [
        (DayOfWeek.Monday, "Пн"),
        (DayOfWeek.Tuesday, "Вт"),
        (DayOfWeek.Wednesday, "Ср"),
        (DayOfWeek.Thursday, "Чт"),
        (DayOfWeek.Friday, "Пт"),
        (DayOfWeek.Saturday, "Сб"),
        (DayOfWeek.Sunday, "Вс")
    ];

    private List<DashboardHistogramChart.HistogramItem> Items => OrderedDays
        .Select(d => new DashboardHistogramChart.HistogramItem
        {
            Label = d.Label,
            Value = Data.GetValueOrDefault(d.Day, 0.0)
        })
        .ToList();
}
