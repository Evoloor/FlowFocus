@using FlowFocus.Core.Helpers

<MudCard Elevation="3" Class="chart-card glass-card">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6" Class="chart-title">Средняя активность по дням недели</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        @if (TotalSum == 0)
        {
            <DashboardEmptyState Message="@EmptyStateMessage" />
        }
        else
        {
            <div class="weekday-bar-container">
                <DashboardHistogramChart Items="@Items" DefaultColor="#6366f1" Unit="@UnitText" />
            </div>
        }
    </MudCardContent>
</MudCard>

<style>
    .weekday-bar-container {
        width: 100%;
        min-height: 250px;
    }
</style>

@code {
    [Parameter]
    public Dictionary<DayOfWeek, double> Data { get; set; } = new();

    [Parameter]
    public DashboardAggregationMode AggregationMode { get; set; } = DashboardAggregationMode.TaskCount;

    private double TotalSum => Data.Values.Sum();

    private string EmptyStateMessage => AggregationMode == DashboardAggregationMode.TimeMinutes
        ? "Нет завершённых задач с оценкой времени за выбранный период"
        : "Нет завершённых задач за выбранный период";

    private string UnitText => AggregationMode == DashboardAggregationMode.TimeMinutes ? string.Empty : "вып. задач";

    private static readonly (DayOfWeek Day, string Label)[] OrderedDays =
    [
        (DayOfWeek.Monday, "Пн"),
        (DayOfWeek.Tuesday, "Вт"),
        (DayOfWeek.Wednesday, "Ср"),
        (DayOfWeek.Thursday, "Чт"),
        (DayOfWeek.Friday, "Пт"),
        (DayOfWeek.Saturday, "Сб"),
        (DayOfWeek.Sunday, "Вс")
    ];

    private List<DashboardHistogramChart.HistogramItem> Items
    {
        get
        {
            var blockScale = DurationFormatHelper.ResolveCompactScale(Data.Values);
            return OrderedDays
                .Select(d =>
                {
                    var val = Data.GetValueOrDefault(d.Day, 0.0);
                    return new DashboardHistogramChart.HistogramItem
                    {
                        Label = d.Label,
                        Value = val,
                        FormattedValue = AggregationMode == DashboardAggregationMode.TimeMinutes
                            ? DurationFormatHelper.FormatCompact(val, blockScale, "0")
                            : null,
                        TooltipValue = AggregationMode == DashboardAggregationMode.TimeMinutes
                            ? DurationFormatHelper.FormatMinutes(val)
                            : null
                    };
                })
                .ToList();
        }
    }
}
