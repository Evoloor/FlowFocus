@using FlowFocus.Core.Models

<MudCard Elevation="3" Class="analytics-grid-card glass-card">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6" Class="chart-title">Глубокая статистика выборки</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <div class="metrics-grid">
            <!-- Количество и Время -->
            <div class="metric-group">
                <div class="group-title">
                    <MudIcon Icon="@Icons.Material.Filled.Timer" Size="Size.Small" Style="color: #6366f1;" />
                    <span>Количество и время</span>
                </div>
                <div class="stats-table">
                    <div class="stat-row">
                        <span class="stat-name">Всего задач</span>
                        <span class="stat-val font-weight-bold">@Metrics.FilteredCount</span>
                    </div>
                    <div class="stat-row">
                        <span class="stat-name">Суммарное время</span>
                        <span class="stat-val">@FormatMinutes(Metrics.FilteredTotalTimeMinutes)</span>
                    </div>
                    <div class="stat-row">
                        <span class="stat-name">Среднее время</span>
                        <span class="stat-val">@(Metrics.FilteredAvgTimeMinutes.HasValue ? FormatMinutes((int)Metrics.FilteredAvgTimeMinutes.Value) : "—")</span>
                    </div>
                    <div class="stat-row">
                        <span class="stat-name">Мин. время</span>
                        <span class="stat-val">@(Metrics.FilteredMinTimeMinutes.HasValue ? FormatMinutes(Metrics.FilteredMinTimeMinutes.Value) : "—")</span>
                    </div>
                    <div class="stat-row">
                        <span class="stat-name">Макс. время</span>
                        <span class="stat-val">@(Metrics.FilteredMaxTimeMinutes.HasValue ? FormatMinutes(Metrics.FilteredMaxTimeMinutes.Value) : "—")</span>
                    </div>
                </div>
            </div>

            <!-- Оценки -->
            <div class="metric-group">
                <div class="group-title">
                    <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Style="color: #f59e0b;" />
                    <span>Оценки и рейтинги</span>
                </div>
                <div class="stats-table">
                    <div class="stat-row">
                        <span class="stat-name">Средняя сложность</span>
                        <span class="stat-val">@(Metrics.FilteredAvgComplexity.HasValue ? Metrics.FilteredAvgComplexity.Value.ToString("F1") : "—")</span>
                    </div>
                    <div class="stat-row">
                        <span class="stat-name">Мин. сложность</span>
                        <span class="stat-val">@(Metrics.FilteredMinComplexity.HasValue ? Metrics.FilteredMinComplexity.Value.ToString() : "—")</span>
                    </div>
                    <div class="stat-row">
                        <span class="stat-name">Макс. сложность</span>
                        <span class="stat-val">@(Metrics.FilteredMaxComplexity.HasValue ? Metrics.FilteredMaxComplexity.Value.ToString() : "—")</span>
                    </div>
                    <div class="stat-row">
                        <span class="stat-name">Средняя интересность</span>
                        <span class="stat-val">@(Metrics.FilteredAvgInterest.HasValue ? Metrics.FilteredAvgInterest.Value.ToString("F1") : "—")</span>
                    </div>
                    <div class="stat-row">
                        <span class="stat-name">Мин. интересность</span>
                        <span class="stat-val">@(Metrics.FilteredMinInterest.HasValue ? Metrics.FilteredMinInterest.Value.ToString() : "—")</span>
                    </div>
                    <div class="stat-row">
                        <span class="stat-name">Макс. интересность</span>
                        <span class="stat-val">@(Metrics.FilteredMaxInterest.HasValue ? Metrics.FilteredMaxInterest.Value.ToString() : "—")</span>
                    </div>
                </div>
            </div>
        </div>
    </MudCardContent>
</MudCard>

<style>
    .analytics-grid-card {
        border-radius: 16px;
        background: rgba(30, 34, 45, 0.6);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .metrics-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 20px;
    }

    .metric-group {
        background: rgba(255, 255, 255, 0.02);
        border-radius: 12px;
        padding: 16px;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .group-title {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 600;
        font-size: 0.95rem;
        margin-bottom: 12px;
        padding-bottom: 8px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .stats-table {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .stat-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.875rem;
    }

    .stat-name {
        color: var(--mud-palette-text-secondary);
    }

    .stat-val {
        font-weight: 600;
    }
</style>

@code {
    [Parameter]
    public DashboardMetricsDto Metrics { get; set; } = new();

    private static string FormatMinutes(int minutes)
    {
        if (minutes <= 0) return "0 мин";
        if (minutes < 60) return $"{minutes} мин";
        var hours = minutes / 60;
        var mins = minutes % 60;
        return mins > 0 ? $"{hours} ч {mins} мин" : $"{hours} ч";
    }
}
