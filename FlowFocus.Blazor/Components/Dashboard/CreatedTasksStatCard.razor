<MudCard Elevation="3" Class="kpi-card glass-card">
    <MudCardContent>
        <div class="kpi-header">
            <span class="kpi-title">Создано задач</span>
            <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Size="Size.Small" Style="color: #ec4899;" />
        </div>
        <div class="kpi-body d-flex align-baseline gap-2">
            <span class="kpi-value pink-gradient-text">@Count</span>
            <span class="kpi-unit">за период</span>
        </div>
        <div class="kpi-footer">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Новые задачи за выбранный интервал</MudText>
        </div>
    </MudCardContent>
</MudCard>

<style>
    .pink-gradient-text {
        background: linear-gradient(135deg, #ec4899 0%, #f43f5e 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .kpi-unit {
        color: var(--mud-palette-text-secondary);
        font-size: 0.9rem;
        font-weight: 500;
    }
</style>

@code {
    [Parameter]
    public int Count { get; set; }
}
