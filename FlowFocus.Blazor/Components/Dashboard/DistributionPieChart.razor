@using FlowFocus.Core.Helpers

@if (ProcessedData.Count >= 2)
{
    <MudCard Elevation="3" Class="chart-card glass-card">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6" Class="chart-title">@Title</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <div class="chart-wrapper">
                <MudChart ChartType="ChartType.Donut"
                          InputData="@ChartData"
                          InputLabels="@ChartLabels"
                          Width="220px"
                          Height="220px" />
                <div class="chart-legend-grid">
                    @for (int i = 0; i < ChartLabels.Length; i++)
                    {
                        var index = i;
                        var label = ChartLabels[index];
                        <div class="legend-item">
                            <span class="legend-badge" style="background-color: @GetColor(label, index)"></span>
                            <span class="legend-label text-truncate">@label</span>
                            <span class="legend-value">@ChartData[index]</span>
                        </div>
                    }
                </div>
            </div>
        </MudCardContent>
    </MudCard>

    <style>
        .chart-card {
            border-radius: 16px;
            background: rgba(30, 34, 45, 0.6);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            height: 100%;
        }

        .chart-title {
            font-weight: 600;
            font-size: 1.05rem;
        }

        .chart-wrapper {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 16px;
        }

        .chart-legend-grid {
            width: 100%;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
            gap: 8px;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.85rem;
        }

        .legend-badge {
            width: 10px;
            height: 10px;
            border-radius: 50%;
        }

        .legend-label {
            color: var(--mud-palette-text-secondary);
            flex-grow: 1;
        }

        .legend-value {
            font-weight: 700;
        }
    </style>
}

@code {
    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public Dictionary<string, int> Data { get; set; } = new();

    [Parameter]
    public string OtherLabel { get; set; } = "Другое";

    [Parameter]
    public string[]? Palette { get; set; }

    [Parameter]
    public Func<string, int, string>? ColorResolver { get; set; }

    private Dictionary<string, int> ProcessedData => PieChartGroupingHelper.GroupSmallSlices(Data ?? new(), OtherLabel);

    private double[] ChartData => ProcessedData.Values.Select(v => (double)v).ToArray();
    private string[] ChartLabels => ProcessedData.Keys.ToArray();

    private static readonly string[] DefaultPalette = new[]
    {
        "#6366f1", "#06b6d4", "#10b981", "#f59e0b", "#ec4899", "#8b5cf6", "#3b82f6", "#94a3b8"
    };

    private string GetColor(string label, int index)
    {
        if (ColorResolver != null)
        {
            return ColorResolver(label, index);
        }

        var activePalette = Palette != null && Palette.Length > 0 ? Palette : DefaultPalette;
        return activePalette[index % activePalette.Length];
    }
}
