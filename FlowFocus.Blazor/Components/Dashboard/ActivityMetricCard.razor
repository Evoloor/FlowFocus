<MudCard Elevation="3" Class="kpi-card glass-card gradient-border-primary">
    <MudCardContent>
        <div class="kpi-header">
            <span class="kpi-title">Активность в приложении</span>
            <MudTooltip Text="В какой процент дней за выбранный период было выполнено хотя бы одно задание" Arrow="true" Placement="Placement.Top">
                <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="kpi-info-icon" />
            </MudTooltip>
        </div>
        <div class="kpi-body">
            <span class="kpi-value primary-gradient-text">@Value.ToString("F1")%</span>
        </div>
        <div class="kpi-footer">
            <MudProgressLinear Color="Color.Primary" Value="@Value" Class="mt-2 rounded" Height="6px" />
        </div>
    </MudCardContent>
</MudCard>

<style>
    .kpi-card {
        border-radius: 16px;
        position: relative;
        overflow: hidden;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        background: rgba(30, 34, 45, 0.6);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .kpi-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    }

    .kpi-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        color: var(--mud-palette-text-secondary);
        font-size: 0.875rem;
        font-weight: 500;
        margin-bottom: 8px;
    }

    .kpi-title {
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-size: 0.75rem;
    }

    .kpi-info-icon {
        cursor: pointer;
        opacity: 0.7;
        transition: opacity 0.2s;
    }

    .kpi-info-icon:hover {
        opacity: 1;
    }

    .kpi-value {
        font-size: 2.25rem;
        font-weight: 800;
        line-height: 1.1;
    }

    .primary-gradient-text {
        background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
</style>

@code {
    [Parameter]
    public double Value { get; set; }
}
