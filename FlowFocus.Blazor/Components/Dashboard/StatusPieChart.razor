<DistributionPieChart Title="Распределение по статусам"
                      Data="@StatusStringData"
                      ColorResolver="@GetStatusColor" />

@code {
    [Parameter]
    public Dictionary<TaskStatus, int> Data { get; set; } = new();

    private Dictionary<string, int> StatusStringData =>
        Data.ToDictionary(kv => GetStatusName(kv.Key), kv => kv.Value);

    private static string GetStatusName(TaskStatus status) => status switch
    {
        TaskStatus.NotConfigured => "Ненастроена",
        TaskStatus.Planned => "Запланирована",
        TaskStatus.Completed => "Завершена",
        TaskStatus.Irrelevant => "Неактуальна",
        TaskStatus.Blocked => "Заблокирована",
        _ => status.ToString()
    };

    private static string GetStatusColor(string label, int index) => label switch
    {
        "Завершена" => "#10b981",
        "Запланирована" => "#3b82f6",
        "Ненастроена" => "#f59e0b",
        "Заблокирована" => "#ef4444",
        "Неактуальна" => "#6b7280",
        "Другое" => "#94a3b8",
        _ => "#8b5cf6"
    };
}
