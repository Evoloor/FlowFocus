@using FlowFocus.Core.Enums
@using FlowFocus.Core.Helpers
@using FlowFocus.Core.Models

<MudCard Elevation="3" Class="chart-card glass-card">
    <MudCardHeader>
        <CardHeaderContent>
            <div class="d-flex align-center justify-space-between flex-wrap gap-3">
                <MudText Typo="Typo.h6" Class="chart-title">Распределение параметров задач</MudText>
                <MudSelect T="HistogramMetricType"
                           Value="@SelectedMetric"
                           ValueChanged="OnMetricChanged"
                           Label="Параметр"
                           Variant="Variant.Outlined"
                           Dense="true"
                           Class="metric-select">
                    @foreach (var opt in OrderedOptions)
                    {
                        <MudSelectItem Value="@opt.Metric" Disabled="@opt.IsDisabled">
                            <MudTooltip Text="@opt.TooltipText" Disabled="@(!opt.IsDisabled)">
                                <span class="d-inline-block w-100">@opt.Label</span>
                            </MudTooltip>
                        </MudSelectItem>
                    }
                </MudSelect>
            </div>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        @if (CurrentItems.Count == 0)
        {
            <MudTooltip Text="В выбранном фильтре отсутствуют данные по текущему параметру">
                <div>
                    <DashboardEmptyState Message="Нет данных для выбранного параметра" />
                </div>
            </MudTooltip>
        }
        else
        {
            <div class="histogram-chart-container">
                <DashboardHistogramChart Items="@CurrentItems"
                                        DefaultColor="@CurrentDefaultColor"
                                        Unit="@CurrentUnit"
                                        IsHorizontal="false" />
            </div>
        }
    </MudCardContent>
</MudCard>

<style>
    .metric-select {
        min-width: 180px;
        max-width: 240px;
    }

    .histogram-chart-container {
        width: 100%;
        min-height: 250px;
    }

    .mud-select-item-disabled {
        pointer-events: auto !important;
        cursor: not-allowed;
    }
</style>

@code {
    [Parameter]
    public DashboardMetricsDto Metrics { get; set; } = new();

    public HistogramMetricType SelectedMetric { get; set; } = HistogramMetricType.Interest;

    public bool IsInterestDisabled => Metrics.InterestHistogram.Count == 0;
    public bool IsComplexityDisabled => Metrics.ComplexityHistogram.Count == 0;
    public bool IsTimeDisabled => Metrics.TimeHistogram.Count == 0;

    private class DropdownOption
    {
        public HistogramMetricType Metric { get; set; }
        public string Label { get; set; } = string.Empty;
        public string TooltipText { get; set; } = string.Empty;
        public bool IsDisabled { get; set; }
    }

    private IEnumerable<DropdownOption> OrderedOptions
    {
        get
        {
            var options = new List<DropdownOption>
            {
                new()
                {
                    Metric = HistogramMetricType.Interest,
                    Label = "Интересность",
                    TooltipText = IsInterestDisabled ? "Нет данных по интересности для выбранного фильтра" : "Распределение по интересности (1–10)",
                    IsDisabled = IsInterestDisabled
                },
                new()
                {
                    Metric = HistogramMetricType.Complexity,
                    Label = "Сложность",
                    TooltipText = IsComplexityDisabled ? "Нет данных по сложности для выбранного фильтра" : "Распределение по сложности (1–100)",
                    IsDisabled = IsComplexityDisabled
                },
                new()
                {
                    Metric = HistogramMetricType.Time,
                    Label = "Время",
                    TooltipText = IsTimeDisabled ? "Нет данных по времени для выбранного фильтра" : "Распределение по времени выполнения",
                    IsDisabled = IsTimeDisabled
                }
            };

            // Дизейбленные опции опускаем в конец дропдауна
            return options.OrderBy(o => o.IsDisabled ? 1 : 0);
        }
    }

    protected override void OnParametersSet()
    {
        if (IsMetricDisabled(SelectedMetric))
        {
            var firstAvailable = OrderedOptions.FirstOrDefault(o => !o.IsDisabled);
            if (firstAvailable != null)
            {
                SelectedMetric = firstAvailable.Metric;
            }
        }
    }

    private bool IsMetricDisabled(HistogramMetricType metric) => metric switch
    {
        HistogramMetricType.Interest => IsInterestDisabled,
        HistogramMetricType.Complexity => IsComplexityDisabled,
        HistogramMetricType.Time => IsTimeDisabled,
        _ => false
    };

    private string CurrentDefaultColor => SelectedMetric switch
    {
        HistogramMetricType.Interest => "#f59e0b",
        HistogramMetricType.Complexity => "#ec4899",
        HistogramMetricType.Time => "#10b981",
        _ => "#6366f1"
    };

    private string CurrentUnit => Metrics.AggregationMode == DashboardAggregationMode.TimeMinutes
        ? string.Empty
        : "задач";

    private List<DashboardHistogramChart.HistogramItem> CurrentItems
    {
        get
        {
            Dictionary<string, int> sourceDict = SelectedMetric switch
            {
                HistogramMetricType.Interest => Metrics.InterestHistogram,
                HistogramMetricType.Complexity => Metrics.ComplexityHistogram,
                HistogramMetricType.Time => Metrics.TimeHistogram,
                _ => new()
            };

            var blockScale = DurationFormatHelper.ResolveCompactScale(sourceDict.Values);

            return sourceDict
                .Select(kvp => new DashboardHistogramChart.HistogramItem
                {
                    Label = kvp.Key,
                    Value = kvp.Value,
                    FormattedValue = Metrics.AggregationMode == DashboardAggregationMode.TimeMinutes
                        ? DurationFormatHelper.FormatCompact(kvp.Value, blockScale, "0")
                        : null,
                    TooltipValue = Metrics.AggregationMode == DashboardAggregationMode.TimeMinutes
                        ? DurationFormatHelper.FormatMinutes(kvp.Value)
                        : null
                })
                .ToList();
        }
    }

    private void OnMetricChanged(HistogramMetricType metric)
    {
        SelectedMetric = metric;
    }
}
