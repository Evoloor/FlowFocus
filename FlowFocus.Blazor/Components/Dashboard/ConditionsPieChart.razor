@using FlowFocus.Core.Helpers

@if (ProcessedData.Count >= 2)
{
    <MudCard Elevation="3" Class="chart-card glass-card">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6" Class="chart-title">Распределение по условиям</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <div class="chart-wrapper">
                <MudChart ChartType="ChartType.Donut"
                          InputData="@ChartData"
                          InputLabels="@ChartLabels"
                          Width="220px"
                          Height="220px" />
                <div class="chart-legend-grid">
                    @for (int i = 0; i < ChartLabels.Length; i++)
                    {
                        var index = i;
                        <div class="legend-item">
                            <span class="legend-badge" style="background-color: @GetColor(index)"></span>
                            <span class="legend-label text-truncate">@ChartLabels[index]</span>
                            <span class="legend-value">@ChartData[index]</span>
                        </div>
                    }
                </div>
            </div>
        </MudCardContent>
    </MudCard>
}

@code {
    [Parameter]
    public Dictionary<string, int> Data { get; set; } = new();

    private Dictionary<string, int> ProcessedData => PieChartGroupingHelper.GroupSmallSlices(Data, "Другое");

    private double[] ChartData => ProcessedData.Values.Select(v => (double)v).ToArray();
    private string[] ChartLabels => ProcessedData.Keys.ToArray();

    private static readonly string[] Palette = new[]
    {
        "#f43f5e", "#8b5cf6", "#14b8a6", "#f59e0b", "#3b82f6", "#a855f7", "#10b981", "#94a3b8"
    };

    private static string GetColor(int index) => Palette[index % Palette.Length];
}
