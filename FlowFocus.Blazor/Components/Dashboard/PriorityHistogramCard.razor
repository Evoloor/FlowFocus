@using FlowFocus.Core.Enums
@using FlowFocus.Core.Models

<MudCard Elevation="3" Class="chart-card glass-card">
    <MudCardHeader>
        <CardHeaderContent>
            <div class="d-flex align-center justify-space-between flex-wrap gap-3">
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.LowPriority" Size="Size.Medium" Style="color: #a855f7;" />
                    <MudText Typo="Typo.h6" Class="chart-title">Аналитика приоритетов</MudText>
                </div>
                <MudSelect T="HistogramMetricType"
                           Value="@SelectedMetric"
                           ValueChanged="OnMetricChanged"
                           Label="Параметр"
                           Variant="Variant.Outlined"
                           Dense="true"
                           Class="metric-select">
                    @foreach (var opt in OrderedOptions)
                    {
                        <MudSelectItem Value="@opt.Metric" Disabled="@opt.IsDisabled">
                            <MudTooltip Text="@opt.TooltipText" Disabled="@(!opt.IsDisabled)">
                                <span class="d-inline-block w-100">@opt.Label</span>
                            </MudTooltip>
                        </MudSelectItem>
                    }
                </MudSelect>
            </div>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        @if (CurrentItems.Count == 0)
        {
            <MudTooltip Text="В выбранном фильтре отсутствуют данные по текущему параметру">
                <div>
                    <DashboardEmptyState Message="Нет данных для выбранного параметра" />
                </div>
            </MudTooltip>
        }
        else
        {
            <div class="histogram-chart-container">
                <DashboardHistogramChart Items="@CurrentItems"
                                        DefaultColor="#a855f7"
                                        Unit="@CurrentUnit"
                                        IsHorizontal="true"
                                        MaxValue="@CurrentMaxValue" />
            </div>
        }
    </MudCardContent>
</MudCard>

<style>
    .metric-select {
        min-width: 220px;
        max-width: 280px;
    }

    .histogram-chart-container {
        width: 100%;
        min-height: 250px;
    }

    .mud-select-item-disabled {
        pointer-events: auto !important;
        cursor: not-allowed;
    }
</style>

@code {
    [Parameter]
    public DashboardMetricsDto Metrics { get; set; } = new();

    public HistogramMetricType SelectedMetric { get; set; } = HistogramMetricType.Priority;

    public bool IsPriorityDisabled => Metrics.PriorityHistogram.Count == 0;
    public bool IsInterestPriorityDisabled => Metrics.PriorityInterestHistogram.Count == 0;

    private class DropdownOption
    {
        public HistogramMetricType Metric { get; set; }
        public string Label { get; set; } = string.Empty;
        public string TooltipText { get; set; } = string.Empty;
        public bool IsDisabled { get; set; }
    }

    private IEnumerable<DropdownOption> OrderedOptions
    {
        get
        {
            var options = new List<DropdownOption>
            {
                new()
                {
                    Metric = HistogramMetricType.Priority,
                    Label = "Количество задач",
                    TooltipText = IsPriorityDisabled ? "Нет данных по приоритету для выбранного фильтра" : "Распределение по приоритетам",
                    IsDisabled = IsPriorityDisabled
                },
                new()
                {
                    Metric = HistogramMetricType.InterestPriority,
                    Label = "Средняя интересность",
                    TooltipText = IsInterestPriorityDisabled ? "Нет данных по соотнесению интересности к приоритетам" : "Интересность по приоритетам (1–10)",
                    IsDisabled = IsInterestPriorityDisabled
                }
            };

            // Дизейбленные опции опускаем в конец дропдауна
            return options.OrderBy(o => o.IsDisabled ? 1 : 0);
        }
    }

    protected override void OnParametersSet()
    {
        if (IsMetricDisabled(SelectedMetric))
        {
            var firstAvailable = OrderedOptions.FirstOrDefault(o => !o.IsDisabled);
            if (firstAvailable != null)
            {
                SelectedMetric = firstAvailable.Metric;
            }
        }
    }

    private bool IsMetricDisabled(HistogramMetricType metric) => metric switch
    {
        HistogramMetricType.Priority => IsPriorityDisabled,
        HistogramMetricType.InterestPriority => IsInterestPriorityDisabled,
        _ => false
    };

    private string CurrentUnit => SelectedMetric switch
    {
        HistogramMetricType.InterestPriority => string.Empty,
        _ => "задач"
    };

    private double? CurrentMaxValue => SelectedMetric switch
    {
        HistogramMetricType.InterestPriority => 10,
        _ => null
    };

    private List<DashboardHistogramChart.HistogramItem> CurrentItems
    {
        get
        {
            if (SelectedMetric == HistogramMetricType.InterestPriority)
            {
                return Metrics.PriorityInterestHistogram
                    .Select(p => new DashboardHistogramChart.HistogramItem
                    {
                        Label = p.PriorityName,
                        Value = p.AverageInterest,
                        Color = p.Color
                    })
                    .ToList();
            }

            // Metric == Priority
            var priorityColorMap = Metrics.PriorityInterestHistogram
                .ToDictionary(p => p.PriorityName, p => p.Color);

            return Metrics.PriorityHistogram
                .Select(kvp => new DashboardHistogramChart.HistogramItem
                {
                    Label = kvp.Key,
                    Value = kvp.Value,
                    Color = priorityColorMap.GetValueOrDefault(kvp.Key)
                })
                .ToList();
        }
    }

    private void OnMetricChanged(HistogramMetricType metric)
    {
        SelectedMetric = metric;
    }
}
