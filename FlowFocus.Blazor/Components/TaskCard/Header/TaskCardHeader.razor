@namespace FlowFocus.Blazor.Components
@using FlowFocus.Blazor.Helpers
@using FlowFocus.Core.Helpers

<div class="task-card-header">
    <div class="task-status-control">
        @switch (CurrentItem.Status)
        {
            case TaskStatus.Planned:
            case TaskStatus.Completed:
                <MudCheckBox T="bool" Value="@(CurrentItem.Status == TaskStatus.Completed)"
                             ValueChanged="@HandleStatusChanged"
                             Size="Size.Small"
                             Color="Color.Primary"
                             Disabled="@(CurrentItem.Status == TaskStatus.NotConfigured)"/>
                break;
            case TaskStatus.Irrelevant:
                <MudText Typo="Typo.caption" Class="vertical-text text-muted">Неактуально</MudText>
                break;
            case TaskStatus.Blocked:
                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Color="Color.Warning"/>
                break;
        }
    </div>

    <div class="task-title-container flex-grow-1">
        @if (CurrentItem.Status == TaskStatus.NotConfigured)
        {
            <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Small" Class="me-1" Color="Color.Info" />
        }

        @if (ShouldHideUnderSpoiler)
        {
            @if (!SpoilerRevealed)
            {
                <div class="d-flex align-center gap-2 flex-grow-1">
                    <MudText Typo="@TitleTypo" Class="@GetTitleClass()">@PrivacyHelper.MaskText(CurrentItem.Title)</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                                   OnClick="@OnToggleSpoiler" Title="Показать" />
                </div>
            }
            else
            {
                <div class="d-flex align-center gap-2 flex-grow-1">
                    <MudText Typo="@TitleTypo" Class="@GetTitleClass()">@CurrentItem.Title</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.VisibilityOff" Size="Size.Small"
                                   OnClick="@OnToggleSpoiler" Title="Скрыть" />
                </div>
            }
        }
        else
        {
            <MudText Typo="@TitleTypo" Class="@GetTitleClass()">@CurrentItem.Title</MudText>
        }
    </div>

    @if (ShowDuration && CurrentItem.EstimatedMinutes.HasValue)
    {
        <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@CurrentItem.FormattedDuration</MudChip>
    }

    <MudIconButton Icon="@(CurrentItem.IsFavorite ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)"
                   Size="Size.Small"
                   Color="@(CurrentItem.IsFavorite ? Color.Warning : Color.Default)"
                   OnClick="@OnToggleFavorite" />
</div>

@code {
    [Parameter]
    public WorkItemBase? Item { get; set; }

    [Parameter]
    public TaskItem? Task { get; set; }

    [Parameter]
    public bool ShouldHideUnderSpoiler { get; set; }

    [Parameter]
    public bool SpoilerRevealed { get; set; }

    [Parameter]
    public EventCallback OnToggleSpoiler { get; set; }

    [Parameter]
    public EventCallback<bool> OnStatusChanged { get; set; }

    [Parameter]
    public EventCallback<bool> OnTaskCompleted { get; set; }

    [Parameter]
    public EventCallback OnToggleFavorite { get; set; }

    [Parameter]
    public bool ShowDuration { get; set; } = false;

    [Parameter]
    public Typo TitleTypo { get; set; } = Typo.body1;

    private WorkItemBase CurrentItem => Item ?? Task!;

    private async Task HandleStatusChanged(bool value)
    {
        if (OnStatusChanged.HasDelegate)
            await OnStatusChanged.InvokeAsync(value);
        else if (OnTaskCompleted.HasDelegate)
            await OnTaskCompleted.InvokeAsync(value);
    }

    private string GetTitleClass() => WorkItemStyleHelper.GetTitleClass(CurrentItem);
}
