@namespace FlowFocus.Blazor.Components
@inject ITaskRepository TaskRepo

@if (!IsNested && (Task.Subtasks.Any() || Task.Relations.Any() || Task.InverseRelations.Any()))
{
    <div class="task-relations-panel">
        @if (Task.Subtasks.Any())
        {
            <MudExpansionPanels Elevation="0" Dense="true" Class="relations-group">
                <MudExpansionPanel Text="@($"({Task.Subtasks.Count}) подзадач")" Expanded="true">
                    @foreach (var subtask in Task.Subtasks.OrderBy(s => s.SortOrder))
                    {
                        <MudPaper @key="subtask.Id" Class="task-card-nested pa-2 mb-1" Elevation="0" Outlined="true">
                            <div class="d-flex align-center gap-2">
                                <MudCheckBox T="bool"
                                             Value="@(subtask.Status == TaskStatus.Completed)"
                                             ValueChanged="@(async _ => await ToggleSubtask(subtask.Id))"
                                             Dense="true"
                                             Size="Size.Small"
                                             Color="Color.Success" />
                                <MudText Typo="Typo.body2"
                                         Style="@(subtask.Status == TaskStatus.Completed ? "text-decoration: line-through; opacity: 0.7" : "")"
                                         Class="flex-grow-1">
                                    @subtask.Title
                                </MudText>
                                @if (subtask.EstimatedMinutes.HasValue)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@subtask.FormattedDuration</MudChip>
                                }
                            </div>
                        </MudPaper>
                    }
                </MudExpansionPanel>
            </MudExpansionPanels>
        }

        @if (RelatedToTasks.Any())
        {
            <MudExpansionPanels Elevation="0" Dense="true" Class="relations-group">
                <MudExpansionPanel Text="@($"Связана с ({RelatedToTasks.Count})")" IsInitiallyExpanded="false">
                    @foreach (var relatedTask in RelatedToTasks)
                    {
                        <TaskCard @key="relatedTask.Id" Task="relatedTask" IsNested="true" DisplayMode="DisplayMode.Compact" OnTaskChanged="OnTaskChanged" />
                    }
                </MudExpansionPanel>
            </MudExpansionPanels>
        }

        @if (BlocksTasks.Any())
        {
            <MudExpansionPanels Elevation="0" Dense="true" Class="relations-group">
                <MudExpansionPanel Text="@($"Блокирует ({BlocksTasks.Count})")" IsInitiallyExpanded="false">
                    @foreach (var blockedTask in BlocksTasks)
                    {
                        <TaskCard @key="blockedTask.Id" Task="blockedTask" IsNested="true" DisplayMode="DisplayMode.Compact" OnTaskChanged="OnTaskChanged" />
                    }
                </MudExpansionPanel>
            </MudExpansionPanels>
        }

        @if (BlockedByTasks.Any())
        {
            <MudExpansionPanels Elevation="0" Dense="true" Class="relations-group">
                <MudExpansionPanel Text="@($"Блокирована ({BlockedByTasks.Count})")" IsInitiallyExpanded="false">
                    @foreach (var blocker in BlockedByTasks)
                    {
                        <TaskCard @key="blocker.Id" Task="blocker" IsNested="true" DisplayMode="DisplayMode.Compact" OnTaskChanged="OnTaskChanged" />
                    }
                </MudExpansionPanel>
            </MudExpansionPanels>
        }
    </div>
}
else if (IsNested && TotalRelationsCount > 0)
{
    <MudText Typo="Typo.caption" Class="text-muted">
        Связей: @TotalRelationsCount
    </MudText>
}

@code {
    [Parameter, EditorRequired]
    public TaskItem Task { get; set; } = null!;

    [Parameter]
    public bool IsNested { get; set; }

    [Parameter]
    public EventCallback OnTaskChanged { get; set; }

    private async Task ToggleSubtask(int subtaskId)
    {
        TaskRepo.ToggleSubtaskStatus(subtaskId);
        await OnTaskChanged.InvokeAsync();
    }

    private int TotalRelationsCount =>
        Task.Subtasks.Count + Task.Relations.Count + Task.InverseRelations.Count;

    private IReadOnlyList<TaskItem> RelatedToTasks =>
        Task.Relations.Where(r => r.Type == RelationType.RelatedTo).Select(r => r.TargetTask)
            .Concat(Task.InverseRelations.Where(r => r.Type == RelationType.RelatedTo).Select(r => r.SourceTask))
            .Where(t => t != null)
            .Cast<TaskItem>()
            .Distinct()
            .ToList();

    private IReadOnlyList<TaskItem> BlocksTasks =>
        Task.Relations.Where(r => r.Type == RelationType.Blocks).Select(r => r.TargetTask)
            .Where(t => t != null)
            .Cast<TaskItem>()
            .Distinct()
            .ToList();

    private IReadOnlyList<TaskItem> BlockedByTasks =>
        Task.InverseRelations.Where(r => r.Type == RelationType.Blocks).Select(r => r.SourceTask)
            .Where(t => t != null)
            .Cast<TaskItem>()
            .Distinct()
            .ToList();
}
