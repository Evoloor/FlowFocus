@page "/settings"

<PageTitle>FlowFocus - Настройки</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Настройки</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb-3">Время и лимиты</MudText>

    <MudGrid>
        <MudItem xs="12" sm="6" md="3">
            <MudNumericField T="int" @bind-Value="_settings.DayStartHour"
                             Label="Время начала дня (час)"
                             Min="0" Max="23"
                             Variant="Variant.Outlined"
                             HelperText="Задачи до этого часа считаются за вчера" />
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudNumericField T="int" @bind-Value="_settings.DailyTaskLimit"
                             Label="Лимит задач на день"
                             Min="1" Max="100"
                             Variant="Variant.Outlined" />
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudNumericField T="int" @bind-Value="_settings.DailyComplexityLimit"
                             Label="Лимит сложности на день"
                             Min="1" Max="1000"
                             Variant="Variant.Outlined" />
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudNumericField T="int" @bind-Value="_dailyTimeHours"
                             Label="Лимит времени на день (часы)"
                             Min="1" Max="24"
                             Variant="Variant.Outlined" />
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb-1">Внешние условия</MudText>
    <MudText Typo="Typo.body2" Class="text-muted mb-3">
        Если внешнее условие выключено, все привязанные к нему задачи блокируются. При включении они возвращаются в прежний статус.
    </MudText>

    <div class="d-flex gap-2 align-center mb-4">
        <MudTextField T="string" @bind-Value="_newConditionName"
                      Label="Название нового условия (например, «В городе А»)"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Class="flex-grow-1" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddCondition" Disabled="@string.IsNullOrWhiteSpace(_newConditionName)">
            Добавить
        </MudButton>
    </div>

    @if (_conditions.Any())
    {
        <MudList T="ExternalCondition" Clickable="false" Class="pa-0">
            @foreach (var cond in _conditions)
            {
                <MudListItem T="ExternalCondition" Class="pa-2 border-bottom">
                    <div class="d-flex align-center justify-space-between w-100">
                        <div class="d-flex align-center gap-3">
                            <MudSwitch T="bool" Value="cond.IsActive"
                                       ValueChanged="@((bool val) => ToggleConditionActive(cond, val))"
                                       Color="Color.Success" />
                            <MudChip T="string" Size="Size.Small"
                                     Icon="@(cond.IsActive ? Icons.Material.Filled.Check : Icons.Material.Filled.Lock)"
                                     Style="@($"background-color: {(cond.IsActive ? "#E8F5E9" : "#FFEBEE")}; color: {(cond.IsActive ? "#2E7D32" : "#C62828")}; font-weight: 500;")">
                                @cond.Name
                            </MudChip>
                        </div>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="@(() => DeleteConditionWithConfirmation(cond))"
                                       Title="Удалить условие" />
                    </div>
                </MudListItem>
            }
        </MudList>
    }
    else
    {
        <MudText Typo="Typo.body2" Class="text-muted italic">Внешние условия пока не добавлены</MudText>
    }
</MudPaper>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb-3">Приватность</MudText>
    <MudSwitch T="bool" Value="_settings.HideTaskTitlesDefault"
               ValueChanged="OnPrivacyModeChanged"
               Color="Color.Primary"
               Label="Режим приватности (включает скрытие текста задач)" />
</MudPaper>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb-3">Приоритет по умолчанию</MudText>

    <MudSelect T="int?" @bind-Value="_settings.DefaultPriorityId"
               Label="Приоритет по умолчанию для новых задач"
               Variant="Variant.Outlined"
               Clearable="true"
               Class="mb-4">
        @foreach (var priority in _priorityItems)
        {
            <MudSelectItem T="int?" Value="priority.Id">
                <div class="priority-option">
                    <div class="priority-color" style="background-color: @priority.Color"></div>
                    <span>@priority.Name</span>
                </div>
            </MudSelectItem>
        }
    </MudSelect>

    <div class="d-flex align-center mb-3">
        <MudText Typo="Typo.h6">Список приоритетов</MudText>
        <MudTooltip Text="Перетаскивайте строки для изменения порядка. Верхние приоритеты важнее.">
            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="ml-2" Color="Color.Info" />
        </MudTooltip>
    </div>

    <MudText Typo="Typo.body2" Class="text-muted mb-3">
        <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" /> Перетащите для изменения порядка
    </MudText>

    <MudDropContainer T="PriorityItem" Items="_priorityItems"
                      @ref="_dropContainer"
                      ItemsSelector="@((_, _) => true)"
                      ItemDropped="@OnPriorityDropped"
                      Class="priority-container">
        <ChildContent>
            <MudDropZone T="PriorityItem" Identifier="priorities" Class="priority-dropzone" AllowReorder="true">
            </MudDropZone>
        </ChildContent>
        <ItemRenderer>
            <MudPaper Class="priority-item pa-3 mb-2" Elevation="1">
                <div class="d-flex align-center gap-3">
                    <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Class="drag-handle" Color="Color.Default" />
                    
                    <MudAvatar Size="Size.Small" Style="@($"background-color: {context.Color}; width: 24px; height: 24px;")">
                        <MudText Typo="Typo.caption" Style="color: white; font-weight: bold;">@context.Order</MudText>
                    </MudAvatar>
                    
                    <div class="color-picker-wrapper">
                        <MudMenu Icon="@Icons.Material.Filled.Palette" Color="Color.Default" Size="Size.Small">
                            <div class="pa-2">
                                <MudText Typo="Typo.caption" Class="mb-2">Выберите цвет:</MudText>
                                <div class="color-palette">
                                    @foreach (var color in ColorPalette)
                                    {
                                        <div class="color-swatch @(context.Color == color ? "selected" : "")"
                                             style="background-color: @color"
                                             @onclick="() => SetPriorityColor(context, color)">
                                        </div>
                                    }
                                </div>
                                <MudTextField T="string" @bind-Value="context.Color"
                                              Label="HEX"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Class="mt-2"
                                              Style="width: 120px" />
                            </div>
                        </MudMenu>
                    </div>

                    <MudTextField T="string" @bind-Value="context.Name"
                                  Label="Название"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Class="flex-grow-1" />

                    @if (_priorityItems.Count > 1)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="@(() => DeletePriority(context))"
                                       Title="Удалить приоритет" />
                    }
                    else
                    {
                        <MudTooltip Text="Нельзя удалить последний приоритет">
                            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Color="Color.Default" />
                        </MudTooltip>
                    }
                </div>
            </MudPaper>
        </ItemRenderer>
    </MudDropContainer>

    @if (_priorityItems.Count < 20)
    {
        <MudButton StartIcon="@Icons.Material.Filled.Add"
                   Variant="Variant.Outlined"
                   Color="Color.Primary"
                   OnClick="@AddPriority"
                   Class="mt-3"
                   FullWidth="true">
            Добавить приоритет
        </MudButton>
    }
    else
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
            Достигнут максимум приоритетов (20)
        </MudAlert>
    }
</MudPaper>

<div class="d-flex gap-3 mb-4">
    <MudButton Variant="Variant.Filled"
               Color="Color.Success"
               Size="Size.Large"
               StartIcon="@Icons.Material.Filled.Save"
               OnClick="@SaveSettings">
        Сохранить настройки
    </MudButton>
</div>
