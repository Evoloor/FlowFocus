@if (ShouldShow)
{
    <MudText Typo="Typo.subtitle2" Class="mb-2">Настройки автоматического повышения приоритета по времени</MudText>

    @if (Escalations.Any(e => e.IsApplied))
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1 d-block">Применённые повышения:</MudText>
        @foreach (var applied in Escalations.Where(e => e.IsApplied))
        {
            <div class="applied-escalation-row d-flex align-center gap-2 mb-2 px-3 py-1 rounded">
                <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Outlined">Применено</MudChip>
                <MudText Typo="Typo.body2" Class="flex-grow-1">
                    <b>@GetPriorityName(applied.TargetPriorityId)</b>
                    @(applied.EscalationDate.HasValue ? $" ({applied.EscalationDate.Value:dd.MM.yyyy})" : "")
                </MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Size="Size.Small"
                               Color="Color.Error"
                               OnClick="@(() => RemoveEscalation(applied))"
                               Title="Удалить запись"/>
            </div>
        }
    }

    @foreach (var escalation in Escalations.Where(e => !e.IsApplied))
    {
        <div class="escalation-row mb-2">
            <MudSelect T="int" @bind-Value="escalation.TargetPriorityId"
                       Label="Приоритет"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Dense="true">
                @foreach (var p in GetAvailablePrioritiesForEscalation(escalation))
                {
                    <MudSelectItem Value="p.Id">@p.Name</MudSelectItem>
                }
            </MudSelect>
            <MudDatePicker @bind-Date="escalation.EscalationDate"
                           Label="Дата"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           MinDate="@TodoDay.Today.ToDateTime()"/>
            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                           Size="Size.Small"
                           Color="Color.Error"
                           OnClick="@(() => RemoveEscalation(escalation))"/>
        </div>
    }

    <MudButton StartIcon="@Icons.Material.Filled.Add"
               Variant="Variant.Text"
               Color="Color.Primary"
               OnClick="@AddEscalation"
               Disabled="@(IsTaskRecurring || !CanAddEscalation)"
               Class="@(IsTaskRecurring ? "disabled-like" : null)">
        Добавить повышение приоритета
    </MudButton>
}

<style>
    /* Визуальный стиль для дизейбла, аналогичный fieldset disabled в TaskEditDialog */
    .disabled-like {
        opacity: 0.6;
        filter: grayscale(30%);
    }

    .applied-escalation-row {
        background-color: var(--mud-palette-background-grey);
    }
</style>

@code {
    [Parameter] public List<EscalationDto> Escalations { get; set; } = [];

    [Parameter] public TaskItem Task { get; set; } = null!;

    [Parameter] public List<PriorityLevel> Priorities { get; set; } = [];

    [Parameter] public bool ShouldShow { get; set; }

    [Parameter] public bool IsTaskRecurring { get; set; }

    private bool CanAddEscalation => GetAvailablePrioritiesForEscalation().Any(p => Escalations.Where(e => !e.IsApplied).All(e => e.TargetPriorityId != p.Id));

    private List<PriorityLevel> GetAvailablePrioritiesForEscalation(EscalationDto? current = null)
    {
        if (Task.PriorityId == null)
        {
            return Priorities;
        }

        var currentTaskPriorityOrder = Priorities.FirstOrDefault(pp => pp.Id == Task.PriorityId)?.Order ?? 99;
        return Priorities.Where(p =>
            p.Id != Task.PriorityId &&
            p.Order < currentTaskPriorityOrder &&
            (current?.TargetPriorityId == p.Id || Escalations.Where(e => !e.IsApplied).All(e => e.TargetPriorityId != p.Id))
        ).ToList();
    }

    private string GetPriorityName(int priorityId)
    {
        return Priorities.FirstOrDefault(p => p.Id == priorityId)?.Name ?? $"Приоритет {priorityId}";
    }

    private void AddEscalation()
    {
        if (IsTaskRecurring) return;

        var available = GetAvailablePrioritiesForEscalation().FirstOrDefault(p => Escalations.Where(e => !e.IsApplied).All(e => e.TargetPriorityId != p.Id));
        if (available == null) return;
        Escalations.Add(new() { TargetPriorityId = available.Id, EscalationDate = TodoDay.Today.AddDays(7).ToDateTime(), IsApplied = false });
    }

    private void RemoveEscalation(EscalationDto escalation)
    {
        Escalations.Remove(escalation);
    }
}