@inject IDialogService DialogService

<div>
    <MudText Typo="Typo.subtitle2" Class="mb-2">Подзадачи</MudText>
    <div class="subtask-input mb-2" style="display:flex; gap: 8px; align-items: center;">
        <MudTextField T="string" @bind-Value="NewSubtaskTitle"
                      @key="_inputResetKey"
                      Placeholder="Название подзадачи"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      OnKeyUp="OnSubtaskKeyUp"
                      Immediate="true"
                      @ref="_newSubtaskField"
                      Class="flex-grow-1" />
        <MudIconButton Icon="@Icons.Material.Filled.Add"
                       Color="Color.Primary"
                       OnClick="@AddSubtask"
                       Disabled="@string.IsNullOrWhiteSpace(NewSubtaskTitle)" />
    </div>

    @foreach (var subtask in Subtasks.Where(s => !s.IsDeleted))
    {
        <MudPaper Class="subtask-card mb-2 pa-2" Elevation="0" Outlined="true">
            <div class="d-flex align-center gap-2">
                <MudText>@subtask.Title</MudText>
                @if (subtask.HideUnderSpoiler)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">Скрыто</MudChip>
                }
                <MudSpacer />
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Size="Size.Small"
                               OnClick="@(async () => await EditSubtask(subtask))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Size="Size.Small"
                               Color="Color.Error"
                               OnClick="@( () => RemoveSubtask(subtask) )" />
            </div>
        </MudPaper>
    }
</div>

@code {
    [Parameter]
    public List<SubtaskDto> Subtasks { get; set; } = [];

    [Parameter]
    public EventCallback<List<SubtaskDto>> SubtasksChanged { get; set; }

    private string NewSubtaskTitle { get; set; } = string.Empty;

    // Реф поля, чтобы возвращать фокус после добавления
    private MudTextField<string>? _newSubtaskField;

    // Ключ для принудительного сброса внутреннего состояния MudTextField
    private int _inputResetKey;

    private async Task AddSubtask()
    {
        if (string.IsNullOrWhiteSpace(NewSubtaskTitle)) return;
        Subtasks.Add(new() { Title = NewSubtaskTitle.Trim() });
        NewSubtaskTitle = string.Empty;
        StateHasChanged();
        await SubtasksChanged.InvokeAsync(Subtasks);

        // Сбрасываем внутреннее состояние поля, чтобы визуально очистить значение
        _inputResetKey++;
        await InvokeAsync(StateHasChanged);
        // Даем шанс компонентам обновиться
        await Task.Yield();
        await Task.Delay(30);

        // Ставим фокус обратно в поле ввода, если возможно
        try
        {
            if (_newSubtaskField != null)
            {
                await _newSubtaskField.FocusAsync();
            }
        }
        catch
        {
            // игнорируем ошибки фокуса
        }
    }

    private void RemoveSubtask(SubtaskDto dto)
    {
        if (dto.Id is > 0)
        {
            dto.IsDeleted = true;
        }
        else
        {
            Subtasks.Remove(dto);
        }
        _ = SubtasksChanged.InvokeAsync(Subtasks);
    }

    private async Task EditSubtask(SubtaskDto subtask)
    {
        DialogParameters<SubtaskEditDialog> parameters = new()
        {
            { x => x.ExistingSubtask, subtask }
        };

        DialogOptions options = new() { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<SubtaskEditDialog>("Редактировать подзадачу", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: SubtaskDto updatedSubtask })
        {
            var index = Subtasks.IndexOf(subtask);
            if (index >= 0)
            {
                Subtasks[index] = updatedSubtask;
                await SubtasksChanged.InvokeAsync(Subtasks);
            }
        }
    }

    private async Task OnSubtaskKeyUp(KeyboardEventArgs e)
    {
        // Для Enter используем OnKeyUp, чтобы двусторонняя привязка успела обновить NewSubtaskTitle
        if (e.Key == "Enter")
        {
            await AddSubtask();
        }
    }
}
