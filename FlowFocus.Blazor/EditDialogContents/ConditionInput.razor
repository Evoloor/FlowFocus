@inherits LabelInputBase<ExternalCondition>
@inject IExternalConditionRepository ConditionRepo

<div class="condition-input-container">
    <MudText Typo="Typo.subtitle2" Class="mb-2">Внешние условия</MudText>

    @if (SuggestedLabels.Any())
    {
        <div class="suggested-conditions mb-3">
            @foreach (var cond in SuggestedLabels)
            {
                var icon = cond.IsActive ? Icons.Material.Filled.Check : Icons.Material.Filled.Lock;
                var chipColor = cond.IsActive ? "#E8F5E9" : "#FFEBEE";
                var textColor = cond.IsActive ? "#2E7D32" : "#C62828";
                var borderStyle = cond.IsActive ? "1px solid #A5D6A7" : "1px solid #EF9A9A";

                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Add" IconColor="Color.Primary"
                         Style="@($"background-color: {chipColor}; color: {textColor}; border: {borderStyle}; cursor: pointer; font-weight: 500;")"
                         OnClick="@(async () => await AddLabel(cond))">
                    @cond.Name
                </MudChip>
            }
        </div>
    }

    <div class="d-flex gap-2 align-end mb-3">
        <MudTextField T="string" @bind-Value="NewInput" @bind-Value:after="OnInputChanged"
                     Label="Название условия или поиск" Variant="Variant.Outlined" Margin="Margin.Dense"
                     OnKeyDown="OnKeyDown" Immediate="true" Clearable="true" Class="flex-grow-1" @ref="InputRef" @key="InputResetKey" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddNew" Disabled="@IsAddButtonDisabled" TabIndex="-1" @onmousedown:preventDefault="true">
            Добавить
        </MudButton>
    </div>

    @if (SearchResults.Any() && !string.IsNullOrWhiteSpace(NewInput))
    {
        <div class="condition-search-results mt-2">
            <MudText Typo="Typo.caption" Class="mb-1 text-muted">Результаты поиска:</MudText>
            <div class="search-result-conditions">
                @foreach (var cond in SearchResults.Where(c => !SelectedLabelIds.Contains(c.Id)))
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="@($"background-color: {cond.BackgroundColor}40; color: #333; border-color: {cond.BackgroundColor}; cursor: pointer;")" OnClick="@(() => AddLabel(cond))">
                        @cond.Name
                    </MudChip>
                }
            </div>
        </div>
    }

    @if (SelectedLabels.Any())
    {
        <MudText Typo="Typo.caption" Class="mt-2 mb-1 font-weight-medium">Выбранные условия:</MudText>
        <div class="selected-conditions d-flex flex-wrap gap-1">
            @foreach (var cond in SelectedLabels)
            {
                var icon = cond.IsActive ? Icons.Material.Filled.Check : Icons.Material.Filled.Lock;
                var chipColor = cond.IsActive ? "#E8F5E9" : "#FFEBEE";
                var textColor = cond.IsActive ? "#2E7D32" : "#C62828";
                var borderStyle = cond.IsActive ? "1px solid #A5D6A7" : "1px solid #EF9A9A";

                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Icon="@icon"
                         Style="@($"background-color: {chipColor}; color: {textColor}; border: {borderStyle}; font-weight: 500;")"
                         OnClose="@(() => RemoveLabel(cond))">
                    @cond.Name
                </MudChip>
            }
        </div>
    }
</div>

@code {
    protected override List<ExternalCondition> SearchLabels(string query) => ConditionRepo.SearchByName(query);
    protected override ExternalCondition? GetByName(string name) => ConditionRepo.GetByName(name);
    protected override ExternalCondition GetOrCreate(string name) => ConditionRepo.GetOrCreate(name);
}
