@inject ITagRepository TagRepo
@inject ITagSessionService TagSessionService

<div class="tag-input-container">
    <MudText Typo="Typo.subtitle2" Class="mb-2">Теги</MudText>
    <div class="suggested-tags mb-3">
        @foreach (var tag in SuggestedTags)
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Add" IconColor="Color.Primary"
                     Style="@($"background-color: {tag.BackgroundColor}40; color: #333; border-color: {tag.BackgroundColor}; cursor: pointer;")"
                     OnClick="@(async () => await AddTag(tag))">
                @tag.Name
            </MudChip>
        }
    </div>

    <div class="d-flex gap-2 align-end mb-3">
        <MudTextField T="string" @bind-Value="NewTagInput" @bind-Value:after="OnTagInputChanged"
                     Label="Название тега или поиск" Variant="Variant.Outlined" Margin="Margin.Dense"
                     OnKeyDown="OnTagKeyDown" Immediate="true" Clearable="true" Class="flex-grow-1" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddNewTag" Disabled="@IsAddTagButtonDisabled">
            Добавить
        </MudButton>
    </div>

    @if (TagSearchResults.Any() && !string.IsNullOrWhiteSpace(NewTagInput))
    {
        <div class="tag-search-results mt-2">
            <MudText Typo="Typo.caption" Class="mb-1 text-muted">Результаты поиска:</MudText>
            <div class="search-result-tags">
                @foreach (var tag in TagSearchResults.Where(tag => !SelectedTagIds.Contains(tag.Id)))
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="@($"background-color: {tag.BackgroundColor}40; color: #333; border-color: {tag.BackgroundColor}; cursor: pointer;")" OnClick="@(() => SelectExistingTag(tag))">
                        @tag.Name
                    </MudChip>
                }
            </div>
        </div>
    }

    @if (SelectedTags.Any())
    {
        <MudText Typo="Typo.caption" Class="mt-2 mb-1 font-weight-medium">Выбранные:</MudText>
        <div class="selected-tags">
            @foreach (var tag in SelectedTags)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Style="@($"background-color: {tag.BackgroundColor}; color: #333;")" OnClose="@(() => RemoveTag(tag))">
                    @tag.Name
                </MudChip>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public List<Tag> SuggestedTags { get; set; } = [];

    [Parameter]
    public List<Tag> SelectedTags { get; set; } = [];

    [Parameter]
    public HashSet<int> SelectedTagIds { get; set; } = [];

    [Parameter]
    public EventCallback<Tag> OnTagAdded { get; set; }

    [Parameter]
    public EventCallback<Tag> OnTagRemoved { get; set; }

    private string NewTagInput { get; set; } = string.Empty;
    private List<Tag> TagSearchResults { get; set; } = [];

    private bool IsAddTagButtonDisabled => string.IsNullOrWhiteSpace(NewTagInput.Trim());

    private async Task OnTagInputChanged()
    {
        if (string.IsNullOrWhiteSpace(NewTagInput))
        {
            TagSearchResults = [];
            await InvokeAsync(StateHasChanged);
            return;
        }

        TagSearchResults = TagRepo.SearchByName(NewTagInput);
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnTagKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(NewTagInput.Trim()))
        {
            await AddNewTag();
        }
    }

    private async Task AddNewTag()
    {
        if (string.IsNullOrWhiteSpace(NewTagInput)) return;

        var tagName = NewTagInput.Trim();
        var existing = TagRepo.GetByName(tagName);
        if (existing != null)
        {
            await AddTag(existing);
        }
        else
        {
            var created = TagRepo.GetOrCreate(tagName);
            await AddTag(created);
        }

        NewTagInput = string.Empty;
        TagSearchResults = [];
        await InvokeAsync(StateHasChanged);
    }

    private async Task AddTag(Tag tag)
    {
        if (SelectedTagIds.Contains(tag.Id)) return;
        SelectedTags.Add(tag);
        SelectedTagIds.Add(tag.Id);
        TagSessionService.MarkTagUsed(tag);
        await OnTagAdded.InvokeAsync(tag);
    }

    private async Task SelectExistingTag(Tag tag)
    {
        await AddTag(tag);
    }

    private async Task RemoveTag(Tag tag)
    {
        SelectedTags.Remove(tag);
        SelectedTagIds.Remove(tag.Id);
        await OnTagRemoved.InvokeAsync(tag);
    }
}
