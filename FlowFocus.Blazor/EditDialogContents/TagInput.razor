@inherits LabelInputBase<Tag>
@inject ITagRepository TagRepo
@inject ITagSessionService TagSessionService

<div class="tag-input-container">
    <MudText Typo="Typo.subtitle2" Class="mb-2">Теги</MudText>
    
    @if (SuggestedLabels.Any())
    {
        <div class="suggested-tags mb-3">
            @foreach (var tag in SuggestedLabels)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Add" IconColor="Color.Primary"
                         Style="@($"background-color: {tag.BackgroundColor}40; color: #333; border-color: {tag.BackgroundColor}; cursor: pointer;")"
                         OnClick="@(async () => await AddLabel(tag))">
                    @tag.Name
                </MudChip>
            }
        </div>
    }

    <div class="d-flex gap-2 align-end mb-3">
        <MudTextField T="string" @bind-Value="NewInput" @bind-Value:after="OnInputChanged"
                     Label="Название тега или поиск" Variant="Variant.Outlined" Margin="Margin.Dense"
                     OnKeyDown="OnKeyDown" Immediate="true" Clearable="true" Class="flex-grow-1" @ref="InputRef" @key="InputResetKey" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddNew" Disabled="@IsAddButtonDisabled" TabIndex="-1" @onmousedown:preventDefault="true">
            Добавить
        </MudButton>
    </div>

    @if (SearchResults.Any() && !string.IsNullOrWhiteSpace(NewInput))
    {
        <div class="tag-search-results mt-2">
            <MudText Typo="Typo.caption" Class="mb-1 text-muted">Результаты поиска:</MudText>
            <div class="search-result-tags">
                @foreach (var tag in SearchResults.Where(tag => !SelectedLabelIds.Contains(tag.Id)))
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="@($"background-color: {tag.BackgroundColor}40; color: #333; border-color: {tag.BackgroundColor}; cursor: pointer;")" OnClick="@(() => AddLabel(tag))">
                        @tag.Name
                    </MudChip>
                }
            </div>
        </div>
    }

    @if (SelectedLabels.Any())
    {
        <MudText Typo="Typo.caption" Class="mt-2 mb-1 font-weight-medium">Выбранные:</MudText>
        <div class="selected-tags">
            @foreach (var tag in SelectedLabels)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Style="@($"background-color: {tag.BackgroundColor}; color: #333;")" OnClose="@(() => RemoveLabel(tag))">
                    @tag.Name
                </MudChip>
            }
        </div>
    }
</div>

@code {
    protected override List<Tag> SearchLabels(string query) => TagRepo.SearchByName(query);
    protected override Tag? GetByName(string name) => TagRepo.GetByName(name);
    protected override Tag GetOrCreate(string name)
    {
        var tag = TagRepo.GetOrCreate(name);
        TagSessionService.MarkTagUsed(tag);
        return tag;
    }
}
