@using SubtaskDto = FlowFocus.WebApp.Dialogs.SubtaskDto
@using FlowFocus.Blazor.Dialogs.Validators
@inject ITaskRepository TaskRepo
@inject ISettingsRepository SettingsRepo
@inject IPriorityRepository PriorityRepo
@inject ITagRepository TagRepo
@inject ITagSessionService TagSessionService
@inject IPlannerService PlannerService
@inject INotificationService NotificationService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsEdit ? "Редактировать задачу" : "Новая задача")</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @bind-IsValid="_isFormValid">
            <MudGrid Spacing="2">
                @* === НАЗВАНИЕ === *@
                <MudItem xs="12">
                    <MudTextField T="string" @bind-Value="_task.Title"
                                  Label="Название *"
                                  Required="true"
                                  RequiredError="Название обязательно"
                                  Variant="Variant.Outlined"
                                  Immediate="true" />
                </MudItem>
                
                @if (!IsSubtaskMode)
                {
                    <MudItem xs="12" sm="6">
                        <MudCheckBox T="bool" @bind-Value="_task.HideUnderSpoiler"
                                     Label="Скрывать под спойлер" />
                    </MudItem>
                }

                @* === ДАТА НАЗНАЧЕНИЯ === *@
                @if (!IsSubtaskMode)
                {
                    <MudItem xs="12" sm="6">
                        <MudDatePicker T="DateTime?" @bind-Date="_task.UserAssignedDate"
                                       Label="Дата назначения"
                                       Placeholder="Автоматически"
                                       Variant="Variant.Outlined"
                                       Clearable="true" />
                    </MudItem>
                }

                @* === ИЗБРАННОЕ === *@
                <MudItem xs="12" sm="6">
                    <MudCheckBox T="bool" @bind-Value="_task.IsFavorite"
                                 Label="Избранное"
                                 Color="Color.Warning"
                                 CheckedIcon="@Icons.Material.Filled.Star"
                                 UncheckedIcon="@Icons.Material.Outlined.StarBorder" />
                </MudItem>

                @* === ПРИОРИТЕТ === *@
                @if (!IsSubtaskMode)
                {
                    <MudItem xs="12" sm="6">
                        <MudSelect T="int?" @bind-Value="_task.PriorityId"
                                   @bind-Value:after="@OnAfterPriorityChanged"
                                   Label="Приоритет"
                                   Variant="Variant.Outlined"
                                   Clearable="true"
                                   AnchorOrigin="Origin.BottomCenter">
                            @foreach (var priority in _priorities)
                            {
                                <MudSelectItem T="int?" Value="priority.Id">
                                    <div class="priority-option">
                                        <div class="priority-color" style="background-color: @priority.Color"></div>
                                        <span>@priority.Name</span>
                                    </div>
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }

                @* === ИНТЕРЕСНОСТЬ === *@
                <MudItem xs="12" sm="4">
                    <MudNumericField T="int?" @bind-Value="_task.Interest"
                                     Label="Интересность"
                                     Min="1" Max="10"
                                     Variant="Variant.Outlined" />
                </MudItem>

                @* === СЛОЖНОСТЬ === *@
                <MudItem xs="12" sm="4">
                    <MudNumericField T="int?" @bind-Value="_task.Complexity"
                                     Label="Сложность"
                                     Min="1" Max="100"
                                     Variant="Variant.Outlined" />
                </MudItem>

                @* === ВРЕМЯ ВЫПОЛНЕНИЯ === *@
                <MudItem xs="12" sm="4">
                    <div class="d-flex gap-2">
                        <MudNumericField T="int?" @bind-Value="_estimatedValue"
                                         Label="Время"
                                         Min="1"
                                         Variant="Variant.Outlined"
                                         Class="flex-grow-1" />
                        <MudSelect T="TimeFormat" @bind-Value="_timeFormat"
                                   Label="Формат"
                                   Variant="Variant.Outlined"
                                   Style="width: 100px">
                            <MudSelectItem Value="TimeFormat.Minutes">мин</MudSelectItem>
                            <MudSelectItem Value="TimeFormat.Hours">ч</MudSelectItem>
                        </MudSelect>
                    </div>
                </MudItem>

                @* === ТЕГИ === *@
                @if (!IsSubtaskMode)
                {
                    <MudItem xs="12">
                        <TagInput SuggestedTags="_suggestedTags" SelectedTags="_selectedTags" SelectedTagIds="_selectedTagIds"
                                  OnTagAdded="@(async (Tag t) => await AddTag(t))"
                                  OnTagRemoved="@(async (Tag t) => { RemoveTag(t); await InvokeAsync(StateHasChanged); })" />
                    </MudItem>
                }

                @* === РАСШИРЕННЫЕ НАСТРОЙКИ === *@
                @if (!IsSubtaskMode)
                {
                    <MudItem xs="12">
                        <MudExpansionPanels>
                            <MudExpansionPanel Text="Расширенные настройки">
                                @* Описание *@
                                <MudTextField T="string?" @bind-Value="_task.Description"
                                              Label="Описание"
                                              Lines="3"
                                              Variant="Variant.Outlined"
                                              Class="mb-4" />

                                @* Подзадачи (вынесено в компонент) *@
                                <SubtasksEditor Subtasks="_subtasks" SubtasksChanged="@OnSubtasksChanged" />

                                @* Повышение приоритета (перенесено сюда) *@
                                <EscalationsEditor Escalations="_escalations" Task="_task" Priorities="_priorities" ShouldShow="ShouldShowEscalationTable" />

                                @* Связи с задачами *@
                                <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">Связи с задачами</MudText>

                                <RelationsEditor Relations="_relations" AvailableTasks="_availableTasks" OnRemoveRequested="RemoveRelationById" />

                                @* Показываем входящие связи (блокеры), только для чтения *@
                                @if (_inverseRelations.Any())
                                {
                                    <div class="mt-3">
                                        <MudText Typo="Typo.subtitle2" Class="mb-2">Блокируют эту задачу</MudText>
                                        @foreach (var inv in _inverseRelations)
                                        {
                                            @if (inv.SourceTask != null)
                                            {
                                                <MudPaper Class="mb-2 pa-2" Elevation="0" Outlined="true">
                                                    <div class="d-flex align-center gap-2">
                                                        <MudText>@inv.SourceTask.Title</MudText>
                                                        <MudSpacer />
                                                        <MudText Typo="Typo.caption" Class="text-muted">@inv.Type.ToString()</MudText>
                                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => RemoveRelationById(inv.Id))" />
                                                    </div>
                                                </MudPaper>
                                            }
                                        }
                                    </div>
                                }

                                @if (_relations.Count < AppConfig.MaxTaskRelations)
                                {
                                    <MudButton StartIcon="@Icons.Material.Filled.Add"
                                               Variant="Variant.Text"
                                               Size="Size.Small"
                                               OnClick="@AddRelation">
                                        Добавить связь (@(_relations.Count)/@AppConfig.MaxTaskRelations)
                                    </MudButton>
                                }
                                else
                                {
                                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                                        Достигнут лимит связей (@AppConfig.MaxTaskRelations). Удалите существующие связи для добавления новых.
                                    </MudAlert>
                                }

                                @* Повторение *@
                                <RecurrenceEditor Task="_task" />
                            </MudExpansionPanel>
                        </MudExpansionPanels>
                    </MudItem>
                }
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@Cancel" Color="Color.Default">
            Отмена
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="@SaveTask">
            @(IsEdit ? "Сохранить" : "Создать")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public TaskItem? ExistingTask { get; set; }

    [Parameter]
    public string? InitialTitle { get; set; }

    [Parameter]
    public bool IsSubtaskMode { get; set; }

    private bool _isFormValid;
    private TaskItem _task = new();
    private TaskItem? _originalTask; // Для отслеживания изменений
    private List<PriorityLevel> _priorities = [];
    private List<Tag> _suggestedTags = [];
    private List<Tag> _selectedTags = [];
    private HashSet<int> _selectedTagIds = [];
    private List<SubtaskDto> _subtasks = [];
    private List<RelationDto> _relations = [];
    private readonly List<EscalationDto> _escalations = [];
    private List<TaskItem> _availableTasks = [];
    private UserSettings? _settings;

    private int? _estimatedValue;
    private TimeFormat _timeFormat = TimeFormat.Minutes;

    private bool IsEdit => ExistingTask != null;

    private List<TaskRelation> _inverseRelations = [];

    protected override void OnInitialized()
    {
        _settings = SettingsRepo.GetUserSettings();
        _priorities = PriorityRepo.GetAllOrdered();
        // Получаем предлагаемые теги: последний использованный + популярные (до 5)
        _suggestedTags = TagSessionService.GetSuggestedTags();
        _availableTasks = TaskRepo.GetTasksForAutocomplete();

        if (ExistingTask != null)
        {
            _task = new TaskItem(ExistingTask);
            _originalTask = new TaskItem(ExistingTask); // Сохраняем оригинал для сравнения
            LoadExistingTaskData();

            // If editing existing task, and it has no user priority set, apply default from settings
            _task.PriorityId ??= _settings?.DefaultPriorityId;

            // Load inverse relations for display
            _inverseRelations = ExistingTask.InverseRelations ?? [];
        }
        else
        {
            _task = new TaskItem
            {
                Title = InitialTitle ?? string.Empty,
                Status = TaskStatus.Planned,
                CreatedDate = DateTime.UtcNow,
                PriorityId = _settings?.DefaultPriorityId
            };
            _originalTask = null;
            StateHasChanged();
        }

        // Конвертируем время
        if (_task.EstimatedMinutes != null)
        {
            if (_task.EstimatedMinutes >= 60 && _task.EstimatedMinutes % 60 == 0)
            {
                _estimatedValue = _task.EstimatedMinutes / 60;
                _timeFormat = TimeFormat.Hours;
            }
            else
            {
                _estimatedValue = _task.EstimatedMinutes;
                _timeFormat = TimeFormat.Minutes;
            }
        }
    }

    private void LoadExistingTaskData()
    {
        // Загружаем теги из оригинальной задачи (конструктор копирования не копирует навигационные свойства)
        if (ExistingTask != null && ExistingTask.Tags.Any())
        {
            _selectedTags = ExistingTask.Tags.Select(tt => tt.Tag).Where(t => t != null).ToList();
            _selectedTagIds = _selectedTags.Select(t => t.Id).ToHashSet();
        }
        else
        {
            _selectedTags = [];
            _selectedTagIds = [];
        }

        // Загружаем подзадачи из оригинальной задачи (конструктор копирования не копирует навигационные свойства)
        _subtasks = (ExistingTask?.Subtasks ?? []).Select(s => new SubtaskDto
        {
            Id = s.Id,
            Title = s.Title,
            IsFavorite = s.IsFavorite,
            Interest = s.Interest,
            Complexity = s.Complexity,
            EstimatedMinutes = s.EstimatedMinutes
        }).ToList();

        // Загружаем связи
        _relations = _task.Relations.Select(r => new RelationDto
        {
            Id = r.Id,
            Type = r.Type,
            TargetTask = r.TargetTask
        }).ToList();

        // Load inverse relations into DTOs for display as readonly list
        _inverseRelations = ExistingTask?.InverseRelations ?? [];
    }

    private bool ShouldShowEscalationTable
    {
        get
        {
            var highestPriority = _priorities.FirstOrDefault();
            if (highestPriority == null) return false;

            // Не показываем, если уже установлен максимальный приоритет
            return _task.PriorityId == null || _task.PriorityId != highestPriority.Id;
        }
    }

    private async Task AddTag(Tag tag)
    {
        if (_selectedTagIds.Contains(tag.Id)) return;

        _selectedTags.Add(tag);
        _selectedTagIds.Add(tag.Id);
        TagSessionService.MarkTagUsed(tag);

        // Обновляем предложенные теги после добавления
        await RefreshSuggestedTags();
    }
    
    private async Task RefreshSuggestedTags()
    {
        // Получаем новые предлагаемые теги (исключая уже добавленные)
        var allSuggested = TagSessionService.GetSuggestedTags(10); // Берем больше, чтобы было из чего выбирать
        _suggestedTags = allSuggested.Where(t => !_selectedTagIds.Contains(t.Id)).Take(5).ToList();
        
        // Если не хватает до 5, добавляем популярные теги
        if (_suggestedTags.Count < 5)
        {
            var popular = TagRepo.GetPopularTags(10);
            foreach (var tag in popular.TakeWhile(_ => _suggestedTags.Count < 5).Where(tag => !_selectedTagIds.Contains(tag.Id) && _suggestedTags.All(t => t.Id != tag.Id)))
            {
                _suggestedTags.Add(tag);
            }
        }
        
        await InvokeAsync(StateHasChanged);
    }

    private void RemoveTag(Tag tag)
    {
        _selectedTags.Remove(tag);
        _selectedTagIds.Remove(tag.Id);
    }

    private void AddRelation()
    {
        if (_relations.Count >= AppConfig.MaxTaskRelations)
        {
            Snackbar.Add($"Достигнут лимит связей ({AppConfig.MaxTaskRelations})", Severity.Warning);
            return;
        }
        _relations.Add(new RelationDto { Type = RelationType.RelatedTo });
    }

    private void OnAfterPriorityChanged()
    {
        // Автоматически удаляем рудиментные повышения при изменении приоритета
        CleanupRedundantEscalations();
        StateHasChanged();
    }

    private void SaveTask()
    {
        try
        {
            // Валидация
            var validationErrors = ValidateTask();
            if (validationErrors.Any())
            {
                foreach (var error in validationErrors)
                {
                    Snackbar.Add(error, Severity.Warning);
                }
                return;
            }

            // Конвертируем время
            _task.EstimatedMinutes = _timeFormat switch
            {
                TimeFormat.Hours => _estimatedValue * 60,
                _ => _estimatedValue
            };

            // Если фактическая дата не установлена, приравниваем к ручной
            if (_task.UserAssignedDate != null)
            {
                _task.ActualAssignedDate = _task.UserAssignedDate;
            }

            // Устанавливаем статус Planned для настроенных задач
            if (_task.Status == TaskStatus.NotConfigured && !IsSubtaskMode)
            {
                _task.Status = TaskStatus.Planned;
            }

            // Обновляем теги задачи
            _task.Tags = _selectedTags.Select(tag => new TaskTag
            {
                TagId = tag.Id,
                Tag = tag
            }).ToList();

            // Синхронизируем подзадачи из DTO в модель задачи
            SyncSubtasksToTask();

            // Синхронизируем связи из DTO в модель задачи
            _task.Relations = RelationModule.SyncRelationsToTask(_relations, _task, ExistingTask);

            // Синхронизируем повышения приоритета из DTO в модель задачи
            _task.PriorityEscalations = EscalationModule.SyncEscalationsToTask(_escalations, _task, ExistingTask, _priorities);

            if (IsEdit)
            {
                TaskRepo.Update(_task);
                Snackbar.Add("Задача обновлена", Severity.Success);
            }
            else
            {
                TaskRepo.Add(_task);
                Snackbar.Add("Задача создана", Severity.Success);
            }

            // Авто-распределение - только если изменились приоритет или дата
            if (_settings?.AutoDistributeEnabled == true && ShouldRecalculate())
            {
                PlannerService.RecalculateAll(_settings);
            }
            else if (RelationsChanged())
            {
                // Обновляем статусы блокировки при изменении связей
                PlannerService.UpdateBlockedStatuses();
            }

            NotificationService.NotifyTasksChanged();
            MudDialog.Close(DialogResult.Ok(_task));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка: {ex.Message}", Severity.Error);
        }
    }

    /// <summary>
    /// Валидация данных задачи
    /// </summary>
    private List<string> ValidateTask()
    {
        var errors = new List<string>();

        var escResult = TaskEditValidator.ValidateEscalations(_escalations, _task, _priorities);
        if (!escResult.IsValid) errors.AddRange(escResult.Errors);

        var relResult = TaskEditValidator.ValidateRelations(_relations, _task, _priorities);
        if (!relResult.IsValid) errors.AddRange(relResult.Errors);

        return errors;
    }

    /// <summary>
    /// Удаление рудиментных повышений
    /// </summary>
    private void CleanupRedundantEscalations()
    {
        var currentPriorityOrder = _task.PriorityId.HasValue
            ? _priorities.FirstOrDefault(p => p.Id == _task.PriorityId)?.Order ?? 99
            : 99;

        // Удаляем повышения, которые не выше текущего приоритета
        _escalations.RemoveAll(e =>
        {
            var targetPriority = _priorities.FirstOrDefault(p => p.Id == e.TargetPriorityId);
            return targetPriority != null && targetPriority.Order >= currentPriorityOrder;
        });
    }

    /// <summary>
    /// Проверка необходимости пересчёта при авто-распределении
    /// </summary>
    private bool ShouldRecalculate()
    {
        if (_originalTask == null) return true; // Новая задача - всегда пересчитываем

        // Пересчитываем если изменились приоритет или дата назначения
        return _originalTask.PriorityId != _task.PriorityId ||
               _originalTask.UserAssignedDate != _task.UserAssignedDate ||
               _originalTask.ActualAssignedDate != _task.ActualAssignedDate;
    }

    /// <summary>
    /// Синхронизация подзадач из DTO в модель задачи
    /// </summary>
    private void SyncSubtasksToTask()
    {
        // Фильтруем удаленные подзадачи
        var activeSubtasks = _subtasks.Where(s => !s.IsDeleted).ToList();
        
        // Получаем существующие подзадачи из оригинальной задачи для получения полной информации
        var existingSubtasksSource = ExistingTask?.Subtasks ?? [];
        
        // Список для результата
        var resultSubtasks = new List<TaskItem>();
        
        foreach (var dto in activeSubtasks)
        {
            if (dto.Id is > 0)
            {
                // Обновляем существующую подзадачу
                var existing = existingSubtasksSource.FirstOrDefault(s => s.Id == dto.Id.Value);
                if (existing != null)
                {
                    // Создаем новый объект с обновленными данными (репозиторий обновит отслеживаемую сущность)
                    var updatedSubtask = new TaskItem(existing)
                    {
                        Title = dto.Title,
                        IsFavorite = dto.IsFavorite,
                        Interest = dto.Interest,
                        Complexity = dto.Complexity,
                        EstimatedMinutes = dto.EstimatedMinutes,
                        Status = TaskStatus.Planned
                    };
                    resultSubtasks.Add(updatedSubtask);
                }
                else
                {
                    // Подзадача с ID не найдена - создаем новую с этим ID (не должно происходить в нормальном случае)
                    var newSubtask = new TaskItem
                    {
                        Id = dto.Id.Value,
                        Title = dto.Title,
                        IsFavorite = dto.IsFavorite,
                        Interest = dto.Interest,
                        Complexity = dto.Complexity,
                        EstimatedMinutes = dto.EstimatedMinutes,
                        Status = TaskStatus.Planned,
                        ParentTaskId = _task.Id > 0 ? _task.Id : null,
                        CreatedDate = DateTime.UtcNow
                    };
                    resultSubtasks.Add(newSubtask);
                }
            }
            else
            {
                // Создаем новую подзадачу
                var newSubtask = new TaskItem
                {
                    Title = dto.Title,
                    IsFavorite = dto.IsFavorite,
                    Interest = dto.Interest,
                    Complexity = dto.Complexity,
                    EstimatedMinutes = dto.EstimatedMinutes,
                    Status = TaskStatus.Planned,
                    ParentTaskId = _task.Id > 0 ? _task.Id : null,
                    CreatedDate = DateTime.UtcNow
                };
                resultSubtasks.Add(newSubtask);
            }
        }
        
        _task.Subtasks = resultSubtasks;
    }

    /// <summary>
    /// Проверка изменения связей
    /// </summary>
    private bool RelationsChanged()
    {
        if (_originalTask == null) return _relations.Any(); // Новая задача - проверяем наличие связей

        var originalRelations = _originalTask.Relations
            .Select(r => new { r.Type, r.TargetTaskId })
            .OrderBy(r => r.TargetTaskId)
            .ThenBy(r => r.Type)
            .ToList();

        var newRelations = _relations
            .Where(r => r.TargetTask != null)
            .Select(r => new { r.Type, TargetTaskId = r.TargetTask!.Id })
            .OrderBy(r => r.TargetTaskId)
            .ThenBy(r => r.Type)
            .ToList();

        if (originalRelations.Count != newRelations.Count) return true;

        for (var i = 0; i < originalRelations.Count; i++)
        {
            if (originalRelations[i].Type != newRelations[i].Type ||
                originalRelations[i].TargetTaskId != newRelations[i].TargetTaskId)
            {
                return true;
            }
        }

        return false;
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task RemoveRelationById(int? relationId)
    {
        if (relationId is null or <= 0)
        {
            // If relation has no id (not persisted) remove from local DTO list
            _relations.RemoveAll(r => r.Id == relationId);
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            TaskRepo.DeleteRelation(relationId.Value);
            // Update blocked statuses because relation deletion may change statuses
            PlannerService.UpdateBlockedStatuses();
            NotificationService.NotifyTasksChanged();

            // Remove from local lists
            _relations.RemoveAll(r => r.Id == relationId);
            _inverseRelations.RemoveAll(r => r.Id == relationId);

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Не удалось удалить связь: {ex.Message}", Severity.Error);
        }
    }

    private async Task OnSubtasksChanged(List<SubtaskDto>? updated)
    {
        _subtasks = updated ?? [];
        await InvokeAsync(StateHasChanged);
    }

}
