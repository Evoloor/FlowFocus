    private Task<IEnumerable<TaskItem>> SearchTasks(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(_availableTasks.Take(10));

        return Task.FromResult(_availableTasks
            .Where(t => t.Title.Contains(value, StringComparison.OrdinalIgnoreCase))
            .Where(t => t.Id != _task.Id) // Исключаем текущую задачу
            .Take(10));
    }

    private async Task AddTag(Tag tag)
    {
        if (_selectedTagIds.Contains(tag.Id)) return;

        _selectedTags.Add(tag);
        _selectedTagIds.Add(tag.Id);
        TagSessionService.MarkTagUsed(tag);
        
        // Обновляем предложенные теги после добавления
        await RefreshSuggestedTags();
    }
    
    private async Task RefreshSuggestedTags()
    {
        // Получаем новые предлагаемые теги (исключая уже добавленные)
        var allSuggested = TagSessionService.GetSuggestedTags(10); // Берем больше, чтобы было из чего выбирать
        _suggestedTags = allSuggested.Where(t => !_selectedTagIds.Contains(t.Id)).Take(5).ToList();
        
        // Если не хватает до 5, добавляем популярные теги
        if (_suggestedTags.Count < 5)
        {
            var popular = TagRepo.GetPopularTags(10);
            foreach (var tag in popular.TakeWhile(tag => _suggestedTags.Count < 5).Where(tag => !_selectedTagIds.Contains(tag.Id) && _suggestedTags.All(t => t.Id != tag.Id)))
            {
                _suggestedTags.Add(tag);
            }
        }
        
        await InvokeAsync(StateHasChanged);
    }

    private void RemoveTag(Tag tag)
    {
        _selectedTags.Remove(tag);
        _selectedTagIds.Remove(tag.Id);
    }

    private async Task OnTagKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_newTagInput?.Trim()))
        {
            await AddNewTag();
        }
    }
    
    private async Task AddNewTag()
    {
        if (string.IsNullOrWhiteSpace(_newTagInput)) return;

        var tagName = _newTagInput.Trim();
        if (string.IsNullOrWhiteSpace(tagName)) return;
        
        // Всегда проверяем существование тега в базе данных (не только в результатах поиска)
        // Это гарантирует уникальность - нельзя создать два идентичных тега
        var existingTag = TagRepo.GetByName(tagName);
        
        if (existingTag != null)
        {
            // Используем существующий тег
            await AddTag(existingTag);
        }
        else
        {
            // Создаем новый тег только если его точно нет
            var newTag = TagRepo.GetOrCreate(tagName);
            await AddTag(newTag);
        }

        _newTagInput = string.Empty;
        _tagSearchResults = [];
        await InvokeAsync(StateHasChanged);
    }
    
    private async Task SelectExistingTag(Tag tag)
    {
        await AddTag(tag);
        _newTagInput = string.Empty;
        _tagSearchResults = [];
        await InvokeAsync(StateHasChanged);
    }

