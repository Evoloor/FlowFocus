        await InvokeAsync(StateHasChanged);
        
        if (string.IsNullOrWhiteSpace(_newTagInput))
        {
            _tagSearchResults = [];
            return;
        }

        // Ищем теги по введенному тексту (даже если это один символ)
        // Поиск работает по мере ввода для авто-дополнения
        _tagSearchResults = TagRepo.SearchByName(_newTagInput);
