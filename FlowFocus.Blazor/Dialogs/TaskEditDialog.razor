@using FlowFocus.Blazor.EditDialogContents

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsEdit ? "Редактировать задачу" : "Новая задача")</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @bind-IsValid="_isFormValid">
            <MudGrid Spacing="2">
                @* === НАЗВАНИЕ === *@
                <MudItem xs="12">
                    <MudTextField T="string" @bind-Value="_task.Title"
                                  Label="Название"
                                  Required="true"
                                  RequiredError="Название обязательно"
                                  Variant="Variant.Outlined"
                                  Immediate="true"/>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudCheckBox T="bool" @bind-Value="_task.HideUnderSpoiler"
                                 Label="Скрывать под спойлер"/>
                </MudItem>

                @* === ДАТА НАЗНАЧЕНИЯ === *@
                @if (!IsSubtaskMode)
                {
                    <MudItem xs="12" sm="6">
                        <MudDatePicker T="DateTime?" Date="_scheduledDate"
                                       DateChanged="OnScheduledDateChanged"
                                       Label="Дата назначения"
                                       Placeholder="Автоматически"
                                       Variant="Variant.Outlined"
                                       Clearable="true"/>
                    </MudItem>
                }

                @* === ИЗБРАННОЕ === *@
                <MudItem xs="12" sm="6">
                    <MudCheckBox T="bool" @bind-Value="_task.IsFavorite"
                                 Label="Избранное"
                                 Color="Color.Warning"
                                 CheckedIcon="@Icons.Material.Filled.Star"
                                 UncheckedIcon="@Icons.Material.Outlined.StarBorder"/>
                </MudItem>

                @* === ПРИОРИТЕТ === *@
                @if (!IsSubtaskMode)
                {
                    <MudItem xs="12" sm="6">
                        <MudSelect T="int?" @bind-Value="_task.PriorityId"
                                   Label="Приоритет"
                                   Variant="Variant.Outlined"
                                   Clearable="true"
                                   AnchorOrigin="Origin.BottomCenter">
                            @foreach (var priority in _priorities)
                            {
                                <MudSelectItem T="int?" Value="priority.Id">
                                    <div class="priority-option">
                                        <div class="priority-color" style="background-color: @priority.Color"></div>
                                        <span>@priority.Name</span>
                                    </div>
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }

                @* === ИНТЕРЕСНОСТЬ === *@
                <MudItem xs="12" sm="4">
                    <MudNumericField T="int?" @bind-Value="_task.Interest"
                                     Label="Интересность"
                                     Min="1" Max="10"
                                     Variant="Variant.Outlined"/>
                </MudItem>

                @* === СЛОЖНОСТЬ === *@
                <MudItem xs="12" sm="4">
                    <MudNumericField T="int?" @bind-Value="_task.Complexity"
                                     Label="Сложность"
                                     Min="1" Max="100"
                                     Variant="Variant.Outlined"/>
                </MudItem>

                @* === ВРЕМЯ ВЫПОЛНЕНИЯ === *@
                <MudItem xs="12" sm="4">
                    <div class="d-flex gap-2">
                        <MudNumericField T="int?" @bind-Value="_estimatedValue"
                                         Label="Время"
                                         Min="1"
                                         Variant="Variant.Outlined"
                                         Class="flex-grow-1"/>
                        <MudSelect T="TimeFormat" @bind-Value="_timeFormat"
                                   Label="Формат"
                                   Variant="Variant.Outlined"
                                   Style="width: 100px">
                            <MudSelectItem Value="TimeFormat.Minutes">мин</MudSelectItem>
                            <MudSelectItem Value="TimeFormat.Hours">ч</MudSelectItem>
                        </MudSelect>
                    </div>
                </MudItem>

                @* === ТЕГИ === *@
                @if (!IsSubtaskMode)
                {
                    <MudItem xs="12">
                        <TagInput SuggestedLabels="_suggestedTags"
                                  SelectedLabels="_selectedTags"
                                  SelectedLabelIds="_selectedTagIds"
                                  OnLabelAdded="@(async (Tag t) => await AddTag(t))"
                                  OnLabelRemoved="@(async (Tag t) =>
                                                {
                                                    RemoveTag(t);
                                                    await RefreshSuggestedTags();
                                                    await InvokeAsync(StateHasChanged);
                                                })"/>
                    </MudItem>
                }

                @* === РАСШИРЕННЫЕ НАСТРОЙКИ === *@
                @if (!IsSubtaskMode)
                {
                    <MudItem xs="12">
                        <MudExpansionPanels>
                            <MudExpansionPanel Text="Расширенные настройки">
                                @* Описание *@
                                <MudTextField T="string?" @bind-Value="_task.Description"
                                              Label="Описание"
                                              Lines="3"
                                              Variant="Variant.Outlined"
                                              Class="mb-4"/>

                                @* Внешние условия *@
                                <div class="mb-4">
                                    <ConditionInput SuggestedLabels="_suggestedConditions"
                                                    SelectedLabels="_selectedConditions"
                                                    SelectedLabelIds="_selectedConditionIds"
                                                    OnLabelAdded="@(async (ExternalCondition c) => { await RefreshSuggestedConditions(); await InvokeAsync(StateHasChanged); })"
                                                    OnLabelRemoved="@(async (ExternalCondition c) => { await RefreshSuggestedConditions(); await InvokeAsync(StateHasChanged); })" />
                                </div>

                                @* Подзадачи *@
                                <SubtasksEditor Subtasks="_subtasks" SubtasksChanged="@OnSubtasksChanged"/>

                                @* Повышение приоритета *@
                                <EscalationsEditor Escalations="_escalations" Task="_task" Priorities="_priorities"
                                                   ShouldShow="ShouldShowEscalationTable" IsTaskRecurring="_task.IsRecurring"/>

                                @* Связи *@
                                <MudItem xs="12">
                                    <fieldset disabled="@_task.IsRecurring" style="border:none;padding:0">
                                        <RelationsEditor Relations="_relations" AvailableTasks="_availableTasks" EditingTask="_task"
                                                         OnRemoveRequested="@OnRelationRemoveRequested"/>
                                        @if (_task.IsRecurring)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                Связи недоступны для повторяющихся задач — они будут удалены при сохранении.
                                            </MudText>
                                        }
                                    </fieldset>
                                </MudItem>

                                @* Повторение *@
                                <RecurrenceEditor Task="_task" OnRecurringChanged="@(async (bool v) => { _task.IsRecurring = v; if (v && _scheduledDate == null) { _scheduledDate = _task.ScheduledDate ?? TodoDay.Today.ToDateTime(); } await InvokeAsync(StateHasChanged); })"/>
                            </MudExpansionPanel>
                        </MudExpansionPanels>
                    </MudItem>
                }
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@Cancel" Color="Color.Default">
            Отмена
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="@SaveTask">
            @(IsEdit ? "Сохранить" : "Создать")
        </MudButton>
    </DialogActions>
</MudDialog>
