@using FlowFocus.Blazor.EditDialogContents
@using SubtaskDto = FlowFocus.Blazor.EditDialogContents.SubtaskDto
@inject ITaskRepository TaskRepo
@inject ISettingsRepository SettingsRepo
@inject IPriorityRepository PriorityRepo
@inject ITagRepository TagRepo
@inject ITagSessionService TagSessionService
@inject IPlannerService PlannerService
@inject INotificationService NotificationService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsEdit ? "Редактировать задачу" : "Новая задача")</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @bind-IsValid="_isFormValid">
            <MudGrid Spacing="2">
                @* === НАЗВАНИЕ === *@
                <MudItem xs="12">
                    <MudTextField T="string" @bind-Value="_task.Title"
                                  Label="Название"
                                  Required="true"
                                  RequiredError="Название обязательно"
                                  Variant="Variant.Outlined"
                                  Immediate="true"/>
                </MudItem>

                @if (!IsSubtaskMode)
                {
                    <MudItem xs="12" sm="6">
                        <MudCheckBox T="bool" @bind-Value="_task.HideUnderSpoiler"
                                     Label="Скрывать под спойлер"/>
                    </MudItem>
                }

                @* === ДАТА НАЗНАЧЕНИЯ === *@
                @if (!IsSubtaskMode)
                {
                    <MudItem xs="12" sm="6">
                        <MudDatePicker T="DateTime?" Date="_scheduledDate"
                                       DateChanged="OnScheduledDateChanged"
                                       Label="Дата назначения"
                                       Placeholder="Автоматически"
                                       Variant="Variant.Outlined"
                                       Clearable="true"/>
                    </MudItem>
                }

                @* === ИЗБРАННОЕ === *@
                <MudItem xs="12" sm="6">
                    <MudCheckBox T="bool" @bind-Value="_task.IsFavorite"
                                 Label="Избранное"
                                 Color="Color.Warning"
                                 CheckedIcon="@Icons.Material.Filled.Star"
                                 UncheckedIcon="@Icons.Material.Outlined.StarBorder"/>
                </MudItem>

                @* === ПРИОРИТЕТ === *@
                @if (!IsSubtaskMode)
                {
                    <MudItem xs="12" sm="6">
                        <MudSelect T="int?" @bind-Value="_task.PriorityId"
                                   Label="Приоритет"
                                   Variant="Variant.Outlined"
                                   Clearable="true"
                                   AnchorOrigin="Origin.BottomCenter">
                            @foreach (var priority in _priorities)
                            {
                                <MudSelectItem T="int?" Value="priority.Id">
                                    <div class="priority-option">
                                        <div class="priority-color" style="background-color: @priority.Color"></div>
                                        <span>@priority.Name</span>
                                    </div>
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }

                @* === ИНТЕРЕСНОСТЬ === *@
                <MudItem xs="12" sm="4">
                    <MudNumericField T="int?" @bind-Value="_task.Interest"
                                     Label="Интересность"
                                     Min="1" Max="10"
                                     Variant="Variant.Outlined"/>
                </MudItem>

                @* === СЛОЖНОСТЬ === *@
                <MudItem xs="12" sm="4">
                    <MudNumericField T="int?" @bind-Value="_task.Complexity"
                                     Label="Сложность"
                                     Min="1" Max="100"
                                     Variant="Variant.Outlined"/>
                </MudItem>

                @* === ВРЕМЯ ВЫПОЛНЕНИЯ === *@
                <MudItem xs="12" sm="4">
                    <div class="d-flex gap-2">
                        <MudNumericField T="int?" @bind-Value="_estimatedValue"
                                         Label="Время"
                                         Min="1"
                                         Variant="Variant.Outlined"
                                         Class="flex-grow-1"/>
                        <MudSelect T="TimeFormat" @bind-Value="_timeFormat"
                                   Label="Формат"
                                   Variant="Variant.Outlined"
                                   Style="width: 100px">
                            <MudSelectItem Value="TimeFormat.Minutes">мин</MudSelectItem>
                            <MudSelectItem Value="TimeFormat.Hours">ч</MudSelectItem>
                        </MudSelect>
                    </div>
                </MudItem>

                @* === ТЕГИ === *@
                @if (!IsSubtaskMode)
                {
                    <MudItem xs="12">
                        <TagInput SuggestedTags="_suggestedTags" SelectedTags="_selectedTags"
                                  SelectedTagIds="_selectedTagIds"
                                  OnTagAdded="@(async (Tag t) => await AddTag(t))"
                                  OnTagRemoved="@(async (Tag t) =>
                                                {
                                                    RemoveTag(t);
                                                    // Обновляем список предложений после удаления
                                                    await RefreshSuggestedTags();
                                                    await InvokeAsync(StateHasChanged);
                                                })"/>
                    </MudItem>
                }

                @* === РАСШИРЕННЫЕ НАСТРОЙКИ === *@
                @if (!IsSubtaskMode)
                {
                    <MudItem xs="12">
                        <MudExpansionPanels>
                            <MudExpansionPanel Text="Расширенные настройки">
                                @* Описание *@
                                <MudTextField T="string?" @bind-Value="_task.Description"
                                              Label="Описание"
                                              Lines="3"
                                              Variant="Variant.Outlined"
                                              Class="mb-4"/>

                                @* Подзадачи (вынесено в компонент) *@
                                <SubtasksEditor Subtasks="_subtasks" SubtasksChanged="@OnSubtasksChanged"/>

                                @* Повышение приоритета (перенесено сюда) *@
                                <EscalationsEditor Escalations="_escalations" Task="_task" Priorities="_priorities"
                                                   ShouldShow="ShouldShowEscalationTable" IsTaskRecurring="_task.IsRecurring"/>

                                @* Для повторяющихся задач редактирование связей запрещено: блок рендерится всегда, но дизейблится через fieldset *@
                                <MudItem xs="12">
                                    <fieldset disabled="@_task.IsRecurring" style="border:none;padding:0">
                                        <RelationsEditor Relations="_relations" AvailableTasks="_availableTasks" EditingTask="_task"
                                                         OnRemoveRequested="@OnRelationRemoveRequested"/>
                                        @if (_task.IsRecurring)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                Связи недоступны для повторяющихся задач — они будут удалены при сохранении.
                                            </MudText>
                                        }
                                    </fieldset>
                                </MudItem>

                                @* Повторение *@
                                <RecurrenceEditor Task="_task" OnRecurringChanged="@(async (bool v) => { _task.IsRecurring = v; await InvokeAsync(StateHasChanged); })"/>
                            </MudExpansionPanel>
                        </MudExpansionPanels>
                    </MudItem>
                }
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@Cancel" Color="Color.Default">
            Отмена
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="@SaveTask">
            @(IsEdit ? "Сохранить" : "Создать")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public TaskItem? ExistingTask { get; set; }

    [Parameter] public string? InitialTitle { get; set; }

    [Parameter] public bool IsSubtaskMode { get; set; }

    private bool _isFormValid;
    private TaskItem _task = new();
    private TaskItem? _originalTask; // Для отслеживания изменений
    // Local mirror of the scheduled date; changes via the date picker set DateSource explicitly
    private DateTime? _scheduledDate;
    private List<PriorityLevel> _priorities = [];
    private List<Tag> _suggestedTags = [];
    private List<Tag> _selectedTags = [];
    private HashSet<int> _selectedTagIds = [];
    // Исходные id тегов при открытии диалога — нужны для расчёта удалённых тегов при сохранении
    private HashSet<int> _originalTagIds = [];
    private List<SubtaskDto> _subtasks = [];
    private List<RelationDto> _relations = [];
    private readonly List<EscalationDto> _escalations = [];
    private List<TaskItem> _availableTasks = [];
    private UserSettings? _settings;

    private int? _estimatedValue;
    private TimeFormat _timeFormat = TimeFormat.Minutes;

    private bool IsEdit => ExistingTask != null;

    // Список id связей, помеченных для удаления при сохранении
    private readonly List<int> _relationsToRemove = [];

    // Отслеживаем переход в состояние повторяющейся задачи
    private bool _wasRecurring;

    protected override async Task OnInitializedAsync()
    {
        _settings = SettingsRepo.GetUserSettings();
        _priorities = PriorityRepo.GetAllOrdered();
        // Получаем предлагаемые теги: последний использованный + популярные (до 5)
        // Используем RefreshSuggestedTags чтобы исключить уже выбранные теги
        _availableTasks = TaskRepo.GetTasksForAutocomplete();

        if (ExistingTask != null)
        {
            _task = new(ExistingTask);
            _originalTask = new(ExistingTask); // Сохраняем оригинал для сравнения
            LoadExistingTaskData();

            // If editing existing task, and it has no user priority set, apply default from settings
            _task.PriorityId ??= _settings?.DefaultPriorityId;

            // NOTE: _inverseRelations initialized in LoadExistingTaskData from tracked source; don't overwrite here
            // _inverseRelations = ExistingTask.InverseRelations ?? [];
        }
        else
        {
            _task = new()
            {
                Title = InitialTitle ?? string.Empty,
                Status = TaskStatus.Planned,
                CreatedDate = DateTime.UtcNow,
                PriorityId = _settings?.DefaultPriorityId
            };
            _originalTask = null;
            StateHasChanged();
        }

        // Синхронизируем локальное зеркало даты из модели
        _scheduledDate = _task.ScheduledDate;

        // Конвертируем время
        if (_task.EstimatedMinutes != null)
        {
            if (_task.EstimatedMinutes >= 60 && _task.EstimatedMinutes % 60 == 0)
            {
                _estimatedValue = _task.EstimatedMinutes / 60;
                _timeFormat = TimeFormat.Hours;
            }
            else
            {
                _estimatedValue = _task.EstimatedMinutes;
                _timeFormat = TimeFormat.Minutes;
            }
        }

        // Инициализируем флаг отслеживания повторяемости
        _wasRecurring = _task.IsRecurring;

        // Обновим предлагаемые теги с учётом уже выбранных
        await RefreshSuggestedTags();
    }

    private void LoadExistingTaskData()
    {   
        // Если у нас есть существующая задача, пытаемся получить полную (tracked) версию из репозитория,
        // чтобы иметь навигационные свойства (Tags, Subtasks, Relations, InverseRelations).
        var source = ExistingTask;
        if (ExistingTask is { Id: > 0 })
        {
            var repoVersion = TaskRepo.GetById(ExistingTask.Id);
            if (repoVersion != null) source = repoVersion;
        }

        // Загружаем теги из оригинальной задачи (конструктор копирования не копирует навигационные свойства)
        if (source != null && source.Tags.Any())
        {
            _selectedTags = source.Tags.Select(tt => tt.Tag).Where(t => t != null).ToList();
            _selectedTagIds = _selectedTags.Select(t => t.Id).ToHashSet();
            // Сохраняем исходный набор id тегов для последующей проверки удалённых
            _originalTagIds = new(_selectedTagIds);
        }
        else
        {
            _selectedTags = [];
            _selectedTagIds = [];
            _originalTagIds = [];
        }

        // Загружаем подзадачи из оригинальной задачи (конструктор копирования не копирует навигационные свойства)
        _subtasks = (source?.Subtasks ?? []).Select(s => new SubtaskDto
        {
            Id = s.Id,
            Title = s.Title,
            IsFavorite = s.IsFavorite,
            Interest = s.Interest,
            Complexity = s.Complexity,
            EstimatedMinutes = s.EstimatedMinutes
        }).ToList();

        // Загружаем связи из source (чтобы получить навигационные TargetTask / SourceTask)
        var outgoing = (source?.Relations ?? []).Select(r => new RelationDto
        {
            Id = r.Id,
            Type = r.Type,
            TargetTask = r.TargetTask
        });

        // Преобразуем входящие (InverseRelations) в представление для текущей задачи:
        // если другая задача блокирует текущую (inverse.Type == Blocks, SourceTask == other),
        // то с точки зрения текущей задачи входящие блокировки показываем как BlockedBy (т.е. "Заблокирована"),
        // остальные типы передаём как есть.
        var incoming = (source?.InverseRelations ?? []).Select(r => new RelationDto
        {
            Id = r.Id,
            // В базе canonical хранится Blocks (Source -> Target).
            // Для отображения в редакторе текущей задачи входящие блокировки показываем как BlockedBy (т.е. "Заблокирована"),
            // остальные типы передаём как есть.
            Type = r.Type == RelationType.Blocks ? RelationType.BlockedBy : r.Type,
            TargetTask = r.SourceTask
        });

        // Объединяем исходящие и входящие, убираем дубликаты по (TargetTaskId, Type)
        _relations = outgoing.Concat(incoming)
            .Where(r => r.TargetTask != null)
            .GroupBy(r => new { r.TargetTask!.Id, r.Type })
            .Select(g => g.First())
            .ToList();

        // Сохраняем оригинальные inverse relations отдельно, если понадобятся как readonly

        // загрузим повышения приоритета в DTO для редактора
        _escalations.Clear();
        if (source?.PriorityEscalations == null) return;
        foreach (var pe in source.PriorityEscalations)
        {
            _escalations.Add(new()
            {
                Id = pe.Id,
                TargetPriorityId = pe.TargetPriorityId,
                EscalationDate = pe.EscalationDate
            });
        }
    }

    private bool ShouldShowEscalationTable
    {
        get
        {
            var highestPriority = _priorities.FirstOrDefault();
            if (highestPriority == null) return false;

            // Не показываем, если уже установлен максимальный приоритет
            return _task.PriorityId == null || _task.PriorityId != highestPriority.Id;
        }
    }

    private async Task AddTag(Tag tag)
    {
        if (_selectedTagIds.Contains(tag.Id)) return;

        _selectedTags.Add(tag);
        _selectedTagIds.Add(tag.Id);
        TagSessionService.MarkTagUsed(tag);

        // Обновляем предложенные теги после добавления
        await RefreshSuggestedTags();
    }

    private void RemoveTag(Tag tag)
    {
        if (tag == null) return;
        _selectedTags.RemoveAll(t => t.Id == tag.Id);
        _selectedTagIds.Remove(tag.Id);
    }

    // Обработчик удаления тега из UI: обновляем предложения, но не меняем статистику в репозитории до сохранения
    // (раньше здесь вызывался TagRepo.CleanupUnusedTags сразу — убираем чтобы корректно учитывать изменения при сохранении)
    private async Task OnSubtasksChanged(List<SubtaskDto> newSubtasks)
    {
        _subtasks = newSubtasks ?? [];
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnRelationRemoveRequested(RelationDto? relation)
    {
        if (relation == null)
            return;

        if (relation.Id is > 0)
        {
            await RemoveRelationById(relation.Id);
        }
        else
        {
            // Если relation ещё не сохранён в БД, просто удалим из локального списка
            _relations.Remove(relation);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RemoveRelationById(int? relationId)
    {
        if (relationId is null || relationId <= 0)
        {
            // ничего делать не нужно
            return;
        }

        if (!_relationsToRemove.Contains(relationId.Value)) _relationsToRemove.Add(relationId.Value);
        _relations.RemoveAll(r => r.Id == relationId);

        // Попробуем удалить сразу из репозитория и обновить статусы — безопасно внутри try/catch
        try
        {
            TaskRepo.DeleteRelation(relationId.Value);
            PlannerService.UpdateBlockedStatuses();
            NotificationService.NotifyTasksChanged();
        }
        catch
        {
            // Ошибки удаления логируются в вызывающем коде или UI через Snackbar при сохранении
        }

        await InvokeAsync(StateHasChanged);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Если переключили в состояние повторяющейся задачи — пометим все существующие сохранённые связи на удаление
        if (_wasRecurring != _task.IsRecurring)
        {
            _wasRecurring = _task.IsRecurring;
            if (_wasRecurring)
            {
                // Помечаем существующие сохранённые связи на удаление и очищаем локальные DTO
                foreach (var r in _relations.Where(r => r.Id is > 0).ToList().Where(r => !_relationsToRemove.Contains(r.Id.Value)))
                {
                    _relationsToRemove.Add(r.Id.Value);
                }
                _relations.Clear();

                // Сообщаем пользователю
                Snackbar.Add("Связи удалены для повторяющейся задачи", Severity.Info);
                InvokeAsync(StateHasChanged);
            }
        }

        base.OnAfterRender(firstRender);
    }

    private async Task SaveTask()
    {
        try
        {
            // Валидация
            var validationErrors = ValidateTask();
            if (validationErrors.Any())
            {
                foreach (var error in validationErrors)
                {
                    Snackbar.Add(error, Severity.Warning);
                }

                return;
            }

            // Конвертируем время
            _task.EstimatedMinutes = _timeFormat switch
            {
                TimeFormat.Hours => _estimatedValue * 60,
                _ => _estimatedValue
            };

            // Устанавливаем статус Planned для настроенных задач
            if (_task.Status == TaskStatus.NotConfigured && !IsSubtaskMode)
            {
                _task.Status = TaskStatus.Planned;
            }

            // Перед обновлением логики тегов — уменьшение счетчиков выполняется в репозитории TaskRepository.Update/Delete.
            // Ранее здесь выполнялись вызовы TagRepo.DecrementUsage/CleanupUnusedTags — они удалены, чтобы избежать двойного уменьшения.

            // Обновляем теги задачи
            _task.Tags = _selectedTags.Select(tag => new TaskTag
            {
                TagId = tag.Id,
                // Не присваиваем Tag навигационное свойство, чтобы избежать трекинга двух экземпляров с одинаковым Id
                // Tag = tag
            }).ToList();

            // синхронизируем подзадачи из DTO в модель задачи
            // При сохранении репозиторий ожидает TaskItem.Subtasks с существующими (Id>0) и новыми (Id==0) TaskItem объектами.
            var existingTracked = ExistingTask is { Id: > 0 } ? TaskRepo.GetById(ExistingTask.Id) : null;

            _task.Subtasks = _subtasks
                .Where(s => !s.IsDeleted)
                .Select(dto =>
                {
                    TaskItem ti = new();
                    // Для существующих подзадач устанавливаем Id, и пробуем сохранить CreatedDate если он есть в tracked
                    if (dto.Id is > 0)
                    {
                        ti.Id = dto.Id.Value;
                        var trackedSub = existingTracked?.Subtasks?.FirstOrDefault(st => st.Id == dto.Id.Value);
                        if (trackedSub != null)
                        {
                            ti.CreatedDate = trackedSub.CreatedDate;
                            ti.ParentTaskId = trackedSub.ParentTaskId;
                            // Сохраняем статус если было
                            ti.Status = trackedSub.Status;
                        }
                    }
                    else
                    {
                        // Для новых подзадач оставляем Id == 0, CreatedDate по умолчанию
                    }

                    ti.Title = dto.Title;
                    ti.IsFavorite = dto.IsFavorite;
                    ti.Interest = dto.Interest;
                    ti.Complexity = dto.Complexity;
                    ti.EstimatedMinutes = dto.EstimatedMinutes;
                    // Обеспечим, что у подзадачи будет статус Planned
                    ti.Status = ti.Status == 0 ? TaskStatus.Planned : ti.Status;

                    return ti;
                }).ToList();

            // Если задача стала повторяющейся, гарантированно удаляем все существующие связи
            if (_task.IsRecurring)
            {
                if (ExistingTask is { Id: > 0 })
                {
                    var existing = TaskRepo.GetById(ExistingTask.Id);
                    if (existing?.Relations != null)
                    {
                        foreach (var rel in existing.Relations.Where(rel => !_relationsToRemove.Contains(rel.Id)))
                        {
                            _relationsToRemove.Add(rel.Id);
                        }
                    }
                }
                // очищаем локальный список, чтобы ничего не синхронизировалось
                _relations.Clear();
            }

            // Синхронизируем связи из DTO в модель задачи
            // Перед синхронизацией отфильтруем связи, указывающие на повторяющиеся задачи и сообщим пользователю.
            var relationsToRecurringTargets = _relations.Where(r => r.TargetTask is { IsRecurring: true }).ToList();
            if (relationsToRecurringTargets.Any())
            {
                // Соберём короткий список заголовков для показа в Snackbar (ограничим длину)
                var titles = relationsToRecurringTargets.Select(r => r.TargetTask!.Title).Where(t => !string.IsNullOrWhiteSpace(t)).Take(5).ToList();
                var message = titles.Any() ? $"Связи с повторяющимися задачами удалены: {string.Join(", ", titles)}" : "Некоторые связи с повторяющимися задачами удалены";
                Snackbar.Add(message, Severity.Warning);
                // Удаляем такие DTO локально, чтобы не мешали дальнейшей логике и проверкам количества
                _relations.RemoveAll(r => r.TargetTask is { IsRecurring: true });
            }

            _task.Relations = RelationModule.SyncRelationsToTask(_relations, _task, existingTracked);

            // Применяем отложенные удаления сохранённых связей, отмеченных пользователем в UI
            if (_relationsToRemove.Count > 0)
            {
                foreach (var relId in _relationsToRemove.ToList())
                {
                    try
                    {
                        TaskRepo.DeleteRelation(relId);
                        // Пометив для удаления, можно дальше удалить из списка, ошибки логируем ниже
                    }
                    catch (Exception ex)
                    {
                        Snackbar.Add($"Не удалось удалить связь (id={relId}): {ex.Message}", Severity.Error);
                    }
                }
                // Очищаем список после попытки удаления
                _relationsToRemove.Clear();
            }

            // Синхронизируем повышения приоритета из DTO в модель задачи
            _task.PriorityEscalations = EscalationModule.SyncEscalationsToTask(_escalations, _task, ExistingTask, _priorities);

            if (IsEdit)
            {
                TaskRepo.Update(_task);
                Snackbar.Add("Задача обновлена", Severity.Success);
            }
            else
            {
                TaskRepo.Add(_task);
                Snackbar.Add("Задача создана", Severity.Success);
            }

            // Авто-распределение - только если изменились приоритет или дата
            if (_settings?.AutoDistributeEnabled == true && ShouldRecalculate())
            {
                // Вызов перерасчёта может вызывать события/рендер вне UI-потока — выполняем через InvokeAsync
                await InvokeAsync(() =>
                {
                    PlannerService.RecalculateAll(_settings);
                    return Task.CompletedTask;
                });
            }
            else if (RelationsChanged())
            {
                await InvokeAsync(() =>
                {
                    PlannerService.UpdateBlockedStatuses();
                    return Task.CompletedTask;
                });
            }

            // Уведомления и закрытие диалога должны выполняться в контексте диспетчера
            await InvokeAsync(() =>
            {
                NotificationService.NotifyTasksChanged();
                MudDialog.Close(DialogResult.Ok(_task));
                return Task.CompletedTask;
            });
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    // Набор минимальных вспомогательных методов, которые использовались в шаблоне.
    private void Cancel()
    {
        MudDialog.Cancel();
    }

    /// <summary>
    /// Handles date picker changes. Setting a date marks the source as Manual (user intent).
    /// Clearing the date marks it as AutoFlexible so the planner can re-assign it.
    /// Editing an existing task does NOT change this logic — the date source follows the user's action.
    /// </summary>
    private void OnScheduledDateChanged(DateTime? value)
    {
        _scheduledDate = value;
        _task.ScheduledDate = value;
        _task.DateSource = value.HasValue ? DateSource.Manual : DateSource.AutoFlexible;
    }

    private List<string> ValidateTask()
    {
        List<string> errors = [];
        if (string.IsNullOrWhiteSpace(_task.Title)) errors.Add("Название обязательно");

        // При создании новой повторяющейся задачи дата обязательна
        if (_task.IsRecurring && !IsEdit && _task.ScheduledDate == null)
            errors.Add("Для повторяющейся задачи необходимо указать дату начала");

        return errors;
    }

    private bool ShouldRecalculate()
    {
        // Минимальная эвристика: перезапускать пересчёт если были изменения приоритета или даты
        try
        {
            if (_originalTask == null) return true;
            if (_originalTask.PriorityId != _task.PriorityId) return true;
            if (_originalTask.ScheduledDate != _task.ScheduledDate) return true;
        }
        catch
        {
            return true;
        }
        return false;
    }

    private bool RelationsChanged()
    {
        // Минимальная проверка: если были пометки на удаление или количество отношений изменилось
        try
        {
            if (_relationsToRemove.Count > 0) return true;
            var originalCount = _originalTask?.Relations?.Count ?? 0;
            if (_relations.Count != originalCount) return true;
        }
        catch
        {
            return true;
        }
        return false;
    }

    private async Task RefreshSuggestedTags()
    {
        // Получаем новые предлагаемые теги (исключая уже добавленные)
        var allSuggested = TagSessionService.GetSuggestedTags(10); // Берем больше, чтобы было из чего выбирать
        _suggestedTags = allSuggested.Where(t => !_selectedTagIds.Contains(t.Id)).Take(5).ToList();

        // Если не хватает до 5, добавляем популярные теги
        if (_suggestedTags.Count < 5)
        {
            var popular = TagRepo.GetPopularTags(10);
            foreach (var tag in popular.Where(tag => !_selectedTagIds.Contains(tag.Id) && _suggestedTags.All(t => t.Id != tag.Id)))
            {
                if (_suggestedTags.Count >= 5) break;
                _suggestedTags.Add(tag);
            }
        }

        await InvokeAsync(StateHasChanged);
    }
}
