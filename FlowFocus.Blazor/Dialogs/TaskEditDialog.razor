    private bool IsEscalationPriorityDisabled(EscalationDto escalation)
    {
        // Проверяем, что приоритет не выше текущего
        var currentPriorityOrder = _task.PriorityId.HasValue
            ? _priorities.FirstOrDefault(p => p.Id == _task.PriorityId)?.Order ?? 99
            : 99;
        
        var escalationPriority = _priorities.FirstOrDefault(p => p.Id == escalation.TargetPriorityId);
        return escalationPriority != null && escalationPriority.Order >= currentPriorityOrder;
