    private void SaveTask()
    {
        try
        {
            // Валидация
            var validationErrors = ValidateTask();
            if (validationErrors.Any())
            {
                foreach (var error in validationErrors)
                {
                    Snackbar.Add(error, Severity.Warning);
                }
                return;
            }

            // Конвертируем время
            _task.EstimatedMinutes = _timeFormat switch
            {
                TimeFormat.Hours => _estimatedValue * 60,
                _ => _estimatedValue
            };

            // Если фактическая дата не установлена, приравниваем к ручной
            if (_task.UserAssignedDate != null)
            {
                _task.ActualAssignedDate = _task.UserAssignedDate;
            }

            // Устанавливаем статус Planned для настроенных задач
            if (_task.Status == TaskStatus.NotConfigured && !IsSubtaskMode)
            {
                _task.Status = TaskStatus.Planned;
            }

            // Обновляем теги задачи
            _task.Tags = _selectedTags.Select(tag => new TaskTag
            {
                TagId = tag.Id,
                Tag = tag
            }).ToList();

            // Синхронизируем подзадачи из DTO в модель задачи
            SyncSubtasksToTask();

            // Синхронизируем связи из DTO в модель задачи
            SyncRelationsToTask();

            // Синхронизируем повышения приоритета из DTO в модель задачи
            SyncEscalationsToTask();

            if (IsEdit)
            {
                TaskRepo.Update(_task);
                Snackbar.Add("Задача обновлена", Severity.Success);
            }
            else
            {
                TaskRepo.Add(_task);
                Snackbar.Add("Задача создана", Severity.Success);
            }

            // Авто-распределение - только если изменились приоритет или дата
            if (_settings?.AutoDistributeEnabled == true && ShouldRecalculate())
            {
                PlannerService.RecalculateAll(_settings);
            }
            else if (RelationsChanged())
            {
                // Обновляем статусы блокировки при изменении связей
                PlannerService.UpdateBlockedStatuses();
            }

            NotificationService.NotifyTasksChanged();
            MudDialog.Close(DialogResult.Ok(_task));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка: {ex.Message}", Severity.Error);
        }
    }

    /// <summary>
    /// Валидация данных задачи
    /// </summary>
    private List<string> ValidateTask()
    {
        var errors = new List<string>();

        // Валидация повышений приоритета
        ValidateEscalations(errors);

        // Валидация связей
        ValidateRelations(errors);

        return errors;
    }

    /// <summary>
    /// Валидация таблицы повышения приоритета
    /// </summary>
    private void ValidateEscalations(List<string> errors)
    {
        if (!_escalations.Any()) return;

        var currentPriorityOrder = _task.PriorityId.HasValue
            ? _priorities.FirstOrDefault(p => p.Id == _task.PriorityId)?.Order ?? 99
            : 99;

        // Сортируем по дате
        var sortedEscalations = _escalations
            .Where(e => e.EscalationDate.HasValue)
            .OrderBy(e => e.EscalationDate)
            .ToList();

        var prevPriorityOrder = currentPriorityOrder;
        var prevDate = DateTime.Today;

        foreach (var escalation in sortedEscalations)
        {
            var targetPriority = _priorities.FirstOrDefault(p => p.Id == escalation.TargetPriorityId);
            if (targetPriority == null) continue;

            // Проверяем, что приоритет повышается (order уменьшается)
            if (targetPriority.Order >= prevPriorityOrder)
            {
                errors.Add($"Повышение приоритета должно быть последовательным: {targetPriority.Name} не выше текущего");
            }

            // Проверяем, что дата не в прошлом
            if (escalation.EscalationDate.HasValue && escalation.EscalationDate.Value.Date < DateTime.Today)
            {
                errors.Add($"Дата повышения {escalation.EscalationDate.Value:dd.MM.yyyy} уже прошла");
            }

            // Проверяем последовательность дат
            if (escalation.EscalationDate.HasValue && escalation.EscalationDate.Value.Date <= prevDate)
            {
                errors.Add("Даты повышений должны быть последовательными");
            }

            prevPriorityOrder = targetPriority.Order;
            prevDate = escalation.EscalationDate?.Date ?? prevDate;
        }

        // Удаляем рудиментные (уже не нужные) повышения
        CleanupRedundantEscalations();
    }

    /// <summary>
    /// Удаление рудиментных повышений
    /// </summary>
    private void CleanupRedundantEscalations()
    {
        var currentPriorityOrder = _task.PriorityId.HasValue
            ? _priorities.FirstOrDefault(p => p.Id == _task.PriorityId)?.Order ?? 99
            : 99;

        // Удаляем повышения, которые не выше текущего приоритета
        _escalations.RemoveAll(e =>
        {
            var targetPriority = _priorities.FirstOrDefault(p => p.Id == e.TargetPriorityId);
            return targetPriority != null && targetPriority.Order >= currentPriorityOrder;
        });
    }

    /// <summary>
    /// Валидация связей между задачами
    /// </summary>
    private void ValidateRelations(List<string> errors)
    {
        foreach (var relation in _relations.Where(r => r.TargetTask != null))
        {
            // Проверка блокирующих связей
            if (relation.Type == RelationType.Blocks || relation.Type == RelationType.BlockedBy)
            {
                ValidateBlockingRelation(relation, errors);
            }

            // Проверка на циклические ссылки
            if (HasCircularReference(relation))
            {
                errors.Add($"Обнаружена циклическая зависимость с задачей \"{relation.TargetTask!.Title}\"");
            }
        }
    }

    /// <summary>
    /// Валидация блокирующей связи
    /// </summary>
    private void ValidateBlockingRelation(RelationDto relation, List<string> errors)
    {
        var targetTask = relation.TargetTask;
        if (targetTask == null) return;

        // Определяем блокирующую и блокируемую задачи
        TaskItem blocker, blocked;
        if (relation.Type == RelationType.Blocks)
        {
            blocker = _task;
            blocked = targetTask;
        }
        else // BlockedBy
        {
            blocker = targetTask;
            blocked = _task;
        }

        // Проверка дат: дедлайн блокера <= дедлайн блокируемой
        var blockerDate = blocker.UserAssignedDate ?? blocker.ActualAssignedDate;
        var blockedDate = blocked.UserAssignedDate ?? blocked.ActualAssignedDate;
        
        if (blockerDate.HasValue && blockedDate.HasValue)
        {
            if (blockerDate.Value.Date > blockedDate.Value.Date)
            {
                errors.Add($"Дата блокера \"{blocker.Title}\" ({blockerDate.Value:dd.MM.yyyy}) должна быть не позже даты блокируемой задачи ({blockedDate.Value:dd.MM.yyyy})");
            }
        }

        // Проверка приоритетов: приоритет блокера не слабее блокируемой
        var blockerPriorityOrder = blocker.PriorityId.HasValue
            ? _priorities.FirstOrDefault(p => p.Id == blocker.PriorityId)?.Order ?? 99
            : 99;
        var blockedPriorityOrder = blocked.PriorityId.HasValue
            ? _priorities.FirstOrDefault(p => p.Id == blocked.PriorityId)?.Order ?? 99
            : 99;

        if (blockerPriorityOrder > blockedPriorityOrder)
        {
            var blockerPriority = _priorities.FirstOrDefault(p => p.Id == blocker.PriorityId)?.Name ?? "не задан";
            var blockedPriority = _priorities.FirstOrDefault(p => p.Id == blocked.PriorityId)?.Name ?? "не задан";
            errors.Add($"Приоритет блокера \"{blocker.Title}\" ({blockerPriority}) не должен быть слабее блокируемой задачи ({blockedPriority})");
        }
    }

    /// <summary>
    /// Проверка на циклические ссылки
    /// </summary>
    private bool HasCircularReference(RelationDto newRelation)
    {
        if (newRelation.TargetTask == null) return false;
        if (newRelation.TargetTask.Id == _task.Id) return true;

        // Простая проверка на прямую обратную ссылку
        var targetRelations = newRelation.TargetTask.Relations;
        return targetRelations.Any(r =>
            r.TargetTaskId == _task.Id &&
            ((r.Type == RelationType.Blocks && newRelation.Type == RelationType.BlockedBy) ||
             (r.Type == RelationType.BlockedBy && newRelation.Type == RelationType.Blocks)));
    }

    /// <summary>
    /// Проверка необходимости пересчёта при авто-распределении
    /// </summary>
    private bool ShouldRecalculate()
    {
        if (_originalTask == null) return true; // Новая задача - всегда пересчитываем

        // Пересчитываем если изменились приоритет или дата назначения
        return _originalTask.PriorityId != _task.PriorityId ||
               _originalTask.UserAssignedDate != _task.UserAssignedDate ||
               _originalTask.ActualAssignedDate != _task.ActualAssignedDate;
    }

    /// <summary>
    /// Синхронизация подзадач из DTO в модель задачи
    /// </summary>
    private void SyncSubtasksToTask()
    {
        // Фильтруем удаленные подзадачи
        var activeSubtasks = _subtasks.Where(s => !s.IsDeleted).ToList();
        
        // Получаем существующие подзадачи из оригинальной задачи для получения полной информации
        var existingSubtasksSource = ExistingTask?.Subtasks ?? [];
        
        // Список для результата
        var resultSubtasks = new List<TaskItem>();
        
        foreach (var dto in activeSubtasks)
        {
            if (dto.Id is > 0)
            {
                // Обновляем существующую подзадачу
                var existing = existingSubtasksSource.FirstOrDefault(s => s.Id == dto.Id.Value);
                if (existing != null)
                {
                    // Создаем новый объект с обновленными данными (репозиторий обновит отслеживаемую сущность)
                    var updatedSubtask = new TaskItem(existing)
                    {
                        Title = dto.Title,
                        IsFavorite = dto.IsFavorite,
                        Interest = dto.Interest,
                        Complexity = dto.Complexity,
                        EstimatedMinutes = dto.EstimatedMinutes,
                        Status = TaskStatus.Planned
                    };
                    resultSubtasks.Add(updatedSubtask);
                }
                else
                {
                    // Подзадача с ID не найдена - создаем новую с этим ID (не должно происходить в нормальном случае)
                    var newSubtask = new TaskItem
                    {
                        Id = dto.Id.Value,
                        Title = dto.Title,
                        IsFavorite = dto.IsFavorite,
                        Interest = dto.Interest,
                        Complexity = dto.Complexity,
                        EstimatedMinutes = dto.EstimatedMinutes,
                        Status = TaskStatus.Planned,
                        ParentTaskId = _task.Id > 0 ? _task.Id : null,
                        CreatedDate = DateTime.UtcNow
                    };
                    resultSubtasks.Add(newSubtask);
                }
            }
            else
            {
                // Создаем новую подзадачу
                var newSubtask = new TaskItem
                {
                    Title = dto.Title,
                    IsFavorite = dto.IsFavorite,
                    Interest = dto.Interest,
                    Complexity = dto.Complexity,
                    EstimatedMinutes = dto.EstimatedMinutes,
                    Status = TaskStatus.Planned,
                    ParentTaskId = _task.Id > 0 ? _task.Id : null,
                    CreatedDate = DateTime.UtcNow
                };
                resultSubtasks.Add(newSubtask);
            }
        }
        
        _task.Subtasks = resultSubtasks;
    }

    /// <summary>
    /// Синхронизация связей из DTO в модель задачи
    /// </summary>
    private void SyncRelationsToTask()
    {
        // Фильтруем связи с валидными целевыми задачами
        var validRelations = _relations.Where(r => r.TargetTask != null).ToList();
        
        // Получаем существующие связи из оригинальной задачи для получения полной информации
        var existingRelationsSource = ExistingTask?.Relations ?? [];
        
        // Список для результата
        var resultRelations = new List<TaskRelation>();
        
        foreach (var dto in validRelations)
        {
            if (dto.Id is > 0)
            {
                // Обновляем существующую связь
                var existing = existingRelationsSource.FirstOrDefault(r => r.Id == dto.Id.Value);
                if (existing != null)
                {
                    // Создаем новый объект с обновленными данными (используем только ID, не навигационные свойства)
                    var updatedRelation = new TaskRelation
                    {
                        Id = existing.Id,
                        SourceTaskId = _task.Id > 0 ? _task.Id : existing.SourceTaskId,
                        TargetTaskId = dto.TargetTask!.Id,
                        Type = dto.Type,
                        LastChangesOn = DateTime.UtcNow
                    };
                    resultRelations.Add(updatedRelation);
                }
                else
                {
                    // Связь с ID не найдена - создаем новую
                    var newRelation = new TaskRelation
                    {
                        SourceTaskId = _task.Id > 0 ? _task.Id : 0,
                        TargetTaskId = dto.TargetTask!.Id,
                        Type = dto.Type,
                        LastChangesOn = DateTime.UtcNow
                    };
                    resultRelations.Add(newRelation);
                }
            }
            else
            {
                // Создаем новую связь
                var newRelation = new TaskRelation
                {
                    SourceTaskId = _task.Id > 0 ? _task.Id : 0,
                    TargetTaskId = dto.TargetTask!.Id,
                    Type = dto.Type,
                    LastChangesOn = DateTime.UtcNow
                };
                resultRelations.Add(newRelation);
            }
        }
        
        _task.Relations = resultRelations;
    }

    /// <summary>
    /// Синхронизация повышений приоритета из DTO в модель задачи
    /// </summary>
    private void SyncEscalationsToTask()
    {
        // Получаем существующие повышения из оригинальной задачи для получения полной информации
        var existingEscalationsSource = ExistingTask?.PriorityEscalations ?? [];
        
        // Список для результата
        var resultEscalations = new List<PriorityEscalation>();
        
        foreach (var dto in _escalations)
        {
            if (dto.Id is > 0)
            {
                // Обновляем существующее повышение
                var existing = existingEscalationsSource.FirstOrDefault(e => e.Id == dto.Id.Value);
                if (existing != null)
                {
                    // Создаем новый объект с обновленными данными (используем только ID, не навигационные свойства)
                    var updatedEscalation = new PriorityEscalation
                    {
                        Id = existing.Id,
                        TaskId = _task.Id > 0 ? _task.Id : existing.TaskId,
                        TargetPriorityId = dto.TargetPriorityId,
                        EscalationDate = dto.EscalationDate ?? DateTime.Today,
                        IsApplied = existing.IsApplied,
                        LastChangesOn = DateTime.UtcNow
                    };
                    resultEscalations.Add(updatedEscalation);
                }
                else
                {
                    // Повышение с ID не найдено - создаем новое
                    var newEscalation = new PriorityEscalation
                    {
                        TaskId = _task.Id > 0 ? _task.Id : 0,
                        TargetPriorityId = dto.TargetPriorityId,
                        EscalationDate = dto.EscalationDate ?? DateTime.Today,
                        IsApplied = false,
                        LastChangesOn = DateTime.UtcNow
                    };
                    resultEscalations.Add(newEscalation);
                }
            }
            else
            {
                // Создаем новое повышение
                var newEscalation = new PriorityEscalation
                {
                    TaskId = _task.Id > 0 ? _task.Id : 0,
                    TargetPriorityId = dto.TargetPriorityId,
                    EscalationDate = dto.EscalationDate ?? DateTime.Today,
                    IsApplied = false,
                    LastChangesOn = DateTime.UtcNow
                };
                resultEscalations.Add(newEscalation);
            }
        }
        
        _task.PriorityEscalations = resultEscalations;
    }

    /// <summary>
    /// Проверка изменения связей
    /// </summary>
    private bool RelationsChanged()
    {
        if (_originalTask == null) return _relations.Any(); // Новая задача - проверяем наличие связей

        var originalRelations = _originalTask.Relations
            .Select(r => new { r.Type, r.TargetTaskId })
            .OrderBy(r => r.TargetTaskId)
            .ThenBy(r => r.Type)
            .ToList();

        var newRelations = _relations
            .Where(r => r.TargetTask != null)
            .Select(r => new { r.Type, TargetTaskId = r.TargetTask!.Id })
            .OrderBy(r => r.TargetTaskId)
            .ThenBy(r => r.Type)
            .ToList();

        if (originalRelations.Count != newRelations.Count) return true;

        for (var i = 0; i < originalRelations.Count; i++)
        {
            if (originalRelations[i].Type != newRelations[i].Type ||
                originalRelations[i].TargetTaskId != newRelations[i].TargetTaskId)
            {
                return true;
            }
        }

        return false;
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    // === DTO классы ===

    private class RelationDto
    {
        public int? Id { get; set; }
        public RelationType Type { get; set; }
        public TaskItem? TargetTask { get; set; }
    }

    private class EscalationDto
    {
        public int? Id { get; set; }
        public int TargetPriorityId { get; set; }
        public DateTime? EscalationDate { get; set; }
    }
}
