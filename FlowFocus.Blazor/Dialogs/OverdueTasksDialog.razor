@inject ITaskRepository TaskRepo
@inject ISettingsRepository SettingsRepo
@inject IPlannerService PlannerService
@inject INotificationService NotificationService
@inject ISnackbar Snackbar

<MudOverlay Visible="true" DarkBackground="true" ZIndex="1000">
    <MudPaper Class="overdue-dialog pa-4" Elevation="4">
        <MudText Typo="Typo.h5" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Class="me-2" />
            Просроченные задачи
        </MudText>

        <MudText Typo="Typo.body2" Class="text-muted mb-4">
            У вас есть @OverdueTasks.Count просроченных задач. Примите решение по каждой из них.
        </MudText>

        <div class="overdue-tasks-list">
            <TaskList CustomTaskSource="@GetOverdueTasks"
                      ShowTitle="false"
                      ShowSearch="false"
                      ShowSortDropdown="false"
                      ShowFilters="false"
                      ShowDisplayMode="false"
                      ShowPagination="false"
                      OnTaskChanged="@RefreshOverdueTasks" />
        </div>

        <div class="dialog-actions mt-4 d-flex justify-space-between">
            <MudButton Variant="Variant.Text"
                       OnClick="@OnRemindLater">
                Напомнить позже
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="@OnAutoDistribute">
                Перераспределить автоматически
            </MudButton>
        </div>
    </MudPaper>
</MudOverlay>

<style>
    .overdue-dialog {
        max-width: 700px;
        max-height: 80vh;
        overflow-y: auto;
        border-radius: 8px;
    }

    .overdue-tasks-list {
        max-height: 400px;
        overflow-y: auto;
    }
</style>

@code {
    [Parameter, EditorRequired]
    public List<TaskItem> OverdueTasks { get; set; } = [];

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback OnTasksUpdated { get; set; }

    private UserSettings? _settings;

    private bool HasOverdueTasks
    {
        get
        {
            var dayStartHour = _settings?.DayStartHour ?? 5;
            // Проверяем актуальное состояние задач из базы данных
            return OverdueTasks.Any(t =>
            {
                var task = TaskRepo.GetById(t.Id);
                if (task == null) return false;
                return task.Status != TaskStatus.Completed &&
                       task.Status != TaskStatus.Irrelevant &&
                       DateHelper.IsOverdue(task.ActualAssignedDate, dayStartHour);
            });
        }
    }

    protected override void OnInitialized()
    {
        _settings = SettingsRepo.GetUserSettings();
    }

    private List<TaskItem> GetOverdueTasks()
    {
        var dayStartHour = _settings?.DayStartHour ?? 5;
        // Всегда возвращаем актуальные данные из базы
        var currentOverdue = TaskRepo.GetOverdueTasks(dayStartHour);
        // Обновляем OverdueTasks для синхронизации
        OverdueTasks.Clear();
        OverdueTasks.AddRange(currentOverdue);
        return currentOverdue;
    }

    private async Task OnRemindLater()
    {
        await OnClose.InvokeAsync();
    }

    private async Task OnAutoDistribute()
    {
        if (_settings == null) return;

        // Получаем актуальный список просроченных задач
        var dayStartHour = _settings.DayStartHour;
        var overdueTasks = TaskRepo.GetOverdueTasks(dayStartHour);

        // Сбрасываем даты просроченных задач, чтобы они были перераспределены
        foreach (var task in overdueTasks.Select(overdueTask => TaskRepo.GetById(overdueTask.Id)).OfType<TaskItem>().Where(task => !task.IsRecurring))
        {
            // Сбрасываем обе даты, чтобы задача была перераспределена по алгоритму
            task.ActualAssignedDate = null;
            task.UserAssignedDate = null;
            TaskRepo.Update(task);
        }

        // Перераспределяем все задачи согласно алгоритму
        PlannerService.RecalculateAll(_settings);
        Snackbar.Add("Задачи перераспределены", Severity.Success);

        NotificationService.NotifyTasksChanged();
        await OnTasksUpdated.InvokeAsync();
        await OnClose.InvokeAsync();
    }

    private async Task RefreshOverdueTasks()
    {
        var dayStartHour = _settings?.DayStartHour ?? 5;
        // Обновляем список, оставляя только действительно просроченные задачи
        var currentOverdue = TaskRepo.GetOverdueTasks(dayStartHour);
        var currentIds = currentOverdue.Select(t => t.Id).ToHashSet();
        
        // Удаляем из списка задачи, которые больше не просрочены
        OverdueTasks.RemoveAll(t => !currentIds.Contains(t.Id));
        
        // Добавляем новые просроченные задачи, которых еще нет в списке
        var existingIds = OverdueTasks.Select(t => t.Id).ToHashSet();
        foreach (var task in currentOverdue.Where(task => !existingIds.Contains(task.Id)))
        {
            OverdueTasks.Add(task);
        }
        
        StateHasChanged();
        await CheckAndClose();
    }

    private async Task CheckAndClose()
    {
        NotificationService.NotifyTasksChanged();
        await OnTasksUpdated.InvokeAsync();

        // Авто закрытие только если действительно все задачи обработаны
        if (!HasOverdueTasks)
        {
            Snackbar.Add("Все просроченные задачи обработаны", Severity.Success);
            await OnClose.InvokeAsync();
        }
    }
}
