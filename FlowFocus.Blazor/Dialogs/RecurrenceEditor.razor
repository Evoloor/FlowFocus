<div class="recurrence-block">
    <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">����������</MudText>
    <MudCheckBox T="bool" @bind-Value="Task.IsRecurring" Label="������������� ������" />

    @if (Task.IsRecurring)
    {
        <div class="recurrence-options mt-2">
            <MudRadioGroup T="RecurrenceType" @bind-Value="Task.RecurrenceType">
                <MudRadio Value="RecurrenceType.Daily" Color="Color.Primary">���������</MudRadio>
                <MudRadio Value="RecurrenceType.EveryNDays" Color="Color.Primary">
                    <div class="d-flex align-center gap-2">
                        <span>������</span>
                        <MudNumericField T="int?" @bind-Value="Task.RecurrenceInterval"
                                         Min="2" Max="365"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Style="width: 80px"
                                         Disabled="@(Task.RecurrenceType != RecurrenceType.EveryNDays)" />
                        <span>����</span>
                    </div>
                </MudRadio>
                <MudRadio Value="RecurrenceType.WeekDays" Color="Color.Primary">�� ���� ������</MudRadio>
            </MudRadioGroup>

            @if (Task.RecurrenceType == RecurrenceType.WeekDays)
            {
                <div class="weekday-select mt-2">
                    @foreach (var day in WeekDays)
                    {
                        <MudCheckBox T="bool"
                                     Value="@IsWeekDaySelected(day.Value)"
                                     ValueChanged="@(v => ToggleWeekDay(day.Value, v))"
                                     Label="@day.Name"
                                     Dense="true" />
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public TaskItem Task { get; set; } = null!;

    private static readonly (string Name, int Value)[] WeekDays =
    [
        ("��", 1), ("��", 2), ("��", 4), ("��", 8), ("��", 16), ("��", 32), ("��", 64)
    ];

    private bool IsWeekDaySelected(int dayValue)
    {
        return (Task.RecurrenceWeekDays ?? 0 & dayValue) != 0;
    }

    private void ToggleWeekDay(int dayValue, bool selected)
    {
        Task.RecurrenceWeekDays ??= 0;
        if (selected)
            Task.RecurrenceWeekDays |= dayValue;
        else
            Task.RecurrenceWeekDays &= ~dayValue;
    }
}
